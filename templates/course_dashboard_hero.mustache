{{!
    @template theme_baitalgahwa/course_dashboard_hero
    Course home: hero banner + statistics row (Bait Al Gahwa).
}}
<style>
body.baitalgahwa-course-dashboard {
    --bag-course-cover: radial-gradient(circle at 68% 28%, rgba(255, 255, 255, .18), transparent 18rem), linear-gradient(135deg, #2b1a12 0%, #5d371f 48%, #17100c 100%);
}

{{#course_image}}
body.baitalgahwa-course-dashboard {
    --bag-course-cover: url('{{{ course_image }}}');
}
{{/course_image}}

body.baitalgahwa-course-dashboard #page.drawers,
body.baitalgahwa-course-dashboard #topofscroll.main-inner {
    max-width: 100%;
    width: 100%;
}

body.baitalgahwa-course-dashboard .drawer-toggles,
body.baitalgahwa-course-dashboard .baitalgahwa-course-hero,
body.baitalgahwa-course-dashboard .baitalgahwa-course-stats,
body.baitalgahwa-course-dashboard .secondary-navigation,
body.baitalgahwa-course-dashboard #page-content {
    width: min(calc(100% - 1.5rem), 1180px);
    margin-left: auto;
    margin-right: auto;
}

body.baitalgahwa-course-dashboard #page-header,
body.baitalgahwa-course-dashboard .tertiary-navigation {
    display: none;
}

body.baitalgahwa-course-dashboard #region-main {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__title {
    color: #241b15;
    font-size: clamp(1.8rem, 2.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__cta {
    border-radius: .55rem;
    padding: .55rem 1.15rem;
    font-size: .82rem;
    font-weight: 700;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__media,
body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__img {
    min-height: 17.75rem;
    border-radius: 1rem;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__media {
    box-shadow: 0 1rem 2.4rem rgba(0, 0, 0, .12);
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, .08) 15%, rgba(0, 0, 0, .76) 100%);
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__caption {
    padding: 1.5rem 1.7rem;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__meta {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__meta-icon {
    width: 1.95rem;
    height: 1.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, .14);
    border: 1px solid rgba(255, 255, 255, .2);
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-stats {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 1rem;
    box-shadow: 0 .75rem 1.8rem rgba(0, 0, 0, .06);
    overflow: hidden;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-stats__card {
    min-height: 100%;
    gap: .9rem;
}

body.baitalgahwa-course-dashboard .baitalgahwa-course-stats .col-md-3 + .col-md-3 .baitalgahwa-course-stats__card,
body.baitalgahwa-course-dashboard .baitalgahwa-course-stats .col-6 + .col-6 .baitalgahwa-course-stats__card {
    border-left: 1px solid rgba(0, 0, 0, .07);
}

body.baitalgahwa-course-dashboard .secondary-navigation {
    margin-bottom: 1.2rem;
    border-bottom: 1px solid rgba(0, 0, 0, .1);
}

body.baitalgahwa-course-dashboard .secondary-navigation .nav-tabs,
body.baitalgahwa-course-dashboard .secondary-navigation .moremenu.navigation {
    gap: 1.4rem;
    margin-bottom: 0;
    border-bottom: 0;
    padding-left: .15rem;
    padding-right: .15rem;
}

body.baitalgahwa-course-dashboard .secondary-navigation .nav-link,
body.baitalgahwa-course-dashboard .secondary-navigation .moremenu .nav-link {
    padding: 0 0 .9rem;
    border: 0;
    color: #5f554c;
    font-size: .92rem;
    font-weight: 600;
    background: transparent;
}

body.baitalgahwa-course-dashboard .secondary-navigation .nav-link.active,
body.baitalgahwa-course-dashboard .secondary-navigation .active > .nav-link,
body.baitalgahwa-course-dashboard .secondary-navigation a[aria-current="true"] {
    color: #6b4423;
    font-weight: 700;
    box-shadow: inset 0 -2px 0 0 #6b4423;
}

body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.2rem;
}

@media (min-width: 768px) {
    body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (min-width: 1200px) {
    body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}

body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:first-child {
    grid-column: 1 / -1;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 .75rem 1.8rem rgba(0, 0, 0, .05);
    padding: 1.45rem 1.6rem;
}

body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:not(:first-child) {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 .55rem 1.3rem rgba(0, 0, 0, .06);
    padding-top: 6.2rem;
    min-height: 15.25rem;
}

body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:not(:first-child)::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 6.2rem;
    background: linear-gradient(180deg, rgba(0, 0, 0, .04), rgba(0, 0, 0, .22)), var(--bag-course-cover);
    background-size: cover;
    background-position: center;
}

body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:not(:first-child) .content {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: .85rem .95rem 1rem;
    background: #fff;
}

@media (max-width: 767.98px) {
    body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__toolbar {
        align-items: flex-start;
        flex-direction: column;
    }

    body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__media,
    body.baitalgahwa-course-dashboard .baitalgahwa-course-hero__img {
        min-height: 12.8rem;
    }

    body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:first-child {
        padding: 1.1rem;
    }

    body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:not(:first-child) {
        min-height: 13.5rem;
        padding-top: 5.25rem;
    }

    body.baitalgahwa-course-dashboard:not(.baitalgahwa-course-settings) #region-main .course-content > ul.topics > li.section:not(:first-child)::before {
        height: 5.25rem;
    }
}
</style>
<div class="baitalgahwa-course-hero mb-3{{#course_strip_settings_layout}} baitalgahwa-course-hero--settings{{/course_strip_settings_layout}}{{#course_strip_participants}} baitalgahwa-course-hero--participants{{/course_strip_participants}}">
    <div class="baitalgahwa-course-hero__toolbar">
        <h1 class="h2 mb-0 baitalgahwa-course-hero__title">{{course_fullname}}</h1>
        <a href="{{course_ctaurl}}" class="btn btn-primary baitalgahwa-course-hero__cta">{{{ course_ctalabel }}}</a>
    </div>
    <div class="baitalgahwa-course-hero__media position-relative overflow-hidden">
        {{#course_image}}
        <div class="baitalgahwa-course-hero__img" style="background-image: url('{{{ course_image }}}');" role="img" aria-label="{{course_fullname}}"></div>
        {{/course_image}}
        {{^course_image}}
        <div class="baitalgahwa-course-hero__img baitalgahwa-course-hero__img--placeholder" role="img" aria-label="{{course_fullname}}"></div>
        {{/course_image}}
        <div class="baitalgahwa-course-hero__overlay"></div>
        <div class="baitalgahwa-course-hero__caption position-absolute bottom-0 left-0 right-0 w-100">
            <p class="h4 text-white mb-1 baitalgahwa-course-hero__caption-title">{{course_fullname}}</p>
            <p class="small text-white mb-0 baitalgahwa-course-hero__meta">
                <span class="baitalgahwa-course-hero__meta-icon" aria-hidden="true"><i class="icon fa fa-user"></i></span>
                <span>{{course_instructor}}</span>
            </p>
        </div>
    </div>
</div>

<div class="baitalgahwa-course-stats mb-3" role="region" aria-label="{{#str}} course_stats_region, theme_baitalgahwa {{/str}}">
    <div class="baitalgahwa-course-stats__row row g-0">
        <div class="col-6 col-md-3">
            <article class="baitalgahwa-course-stats__card h-100 d-flex align-items-center p-3">
                <span class="baitalgahwa-course-stats__icon flex-shrink-0" aria-hidden="true"><i class="icon fa fa-file-text-o fa-2x"></i></span>
                <div>
                    <div class="baitalgahwa-course-stats__num font-weight-bold">{{{ stat_enrolled_f }}}</div>
                    <div class="baitalgahwa-course-stats__label small text-muted mb-0">{{#str}} course_stat_enrolled, theme_baitalgahwa {{/str}}</div>
                </div>
            </article>
        </div>
        <div class="col-6 col-md-3">
            <article class="baitalgahwa-course-stats__card h-100 d-flex align-items-center p-3">
                <span class="baitalgahwa-course-stats__icon flex-shrink-0" aria-hidden="true"><i class="icon fa fa-calendar fa-2x"></i></span>
                <div>
                    <div class="baitalgahwa-course-stats__num font-weight-bold">{{{ stat_completed_f }}}</div>
                    <div class="baitalgahwa-course-stats__label small text-muted mb-0">{{#str}} course_stat_completed, theme_baitalgahwa {{/str}}</div>
                </div>
            </article>
        </div>
        <div class="col-6 col-md-3">
            <article class="baitalgahwa-course-stats__card h-100 d-flex align-items-center p-3">
                <span class="baitalgahwa-course-stats__icon flex-shrink-0" aria-hidden="true"><i class="icon fa fa-check-square-o fa-2x"></i></span>
                <div>
                    <div class="baitalgahwa-course-stats__num font-weight-bold">{{{ stat_inprogress_f }}}</div>
                    <div class="baitalgahwa-course-stats__label small text-muted mb-0">{{#str}} course_stat_inprogress, theme_baitalgahwa {{/str}}</div>
                </div>
            </article>
        </div>
        <div class="col-6 col-md-3">
            <article class="baitalgahwa-course-stats__card h-100 d-flex align-items-center p-3">
                <span class="baitalgahwa-course-stats__icon flex-shrink-0" aria-hidden="true"><i class="icon fa fa-list fa-2x"></i></span>
                <div>
                    <div class="baitalgahwa-course-stats__num font-weight-bold">{{{ stat_nottostart_f }}}</div>
                    <div class="baitalgahwa-course-stats__label small text-muted mb-0">{{#str}} course_stat_yettostart, theme_baitalgahwa {{/str}}</div>
                </div>
            </article>
        </div>
    </div>
    {{^has_completion}}
    <p class="small text-muted mb-0 mt-2 baitalgahwa-course-stats__hint">{{#str}} course_stats_completion_off, theme_baitalgahwa {{/str}}</p>
    {{/has_completion}}
</div>
