{{!
    @template theme_baitalgahwa/navbar
}}
<style>
.baitalgahwa-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 1030;
}
.baitalgahwa-navbar {
    min-height: 4.1rem;
    background: rgba(255,255,255,.985) !important;
    border-bottom: 1px solid #ece5de;
    box-shadow: 0 .12rem .4rem rgba(33,20,12,.035);
    padding-inline: 1.25rem;
}
.baitalgahwa-navbar__inner {
    width: min(100%, 1360px);
    margin: 0 auto;
    gap: 1rem;
    min-height: 4.1rem;
}
.baitalgahwa-navbar .navbar-brand {
    margin-right: .8rem !important;
    padding-block: .15rem;
    align-items: flex-start !important;
}
.baitalgahwa-navbar__brand-lockup {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .08rem;
    line-height: 1;
}
.baitalgahwa-custom-logo,
.baitalgahwa-navbar .logo {
    max-height: 2rem;
    width: auto;
    object-fit: contain;
}
.baitalgahwa-navbar__logo-subtitle {
    display: block;
    padding-inline-start: .12rem;
    color: #8d8277;
    font-size: .42rem;
    font-weight: 600;
    letter-spacing: .34em;
    text-transform: uppercase;
    white-space: nowrap;
}
.baitalgahwa-navbar__custom-links {
    align-items: center;
    gap: 1.6rem;
    margin-inline-end: 1.25rem;
    white-space: nowrap;
}
.baitalgahwa-navbar__link {
    position: relative;
    color: #4f4338;
    text-decoration: none;
    font-size: .9rem;
    font-weight: 600;
    padding: .55rem 0;
    letter-spacing: .01em;
    text-transform: none;
    transition: color .18s ease;
}
.baitalgahwa-navbar__link--active,
.baitalgahwa-navbar__link:hover,
.baitalgahwa-navbar__link:focus-visible {
    color: #1f1712;
}
.baitalgahwa-navbar__link--active::after,
.baitalgahwa-navbar__link:hover::after,
.baitalgahwa-navbar__link:focus-visible::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 2rem;
    transform: translateX(-50%);
    bottom: -.88rem;
    height: 2px;
    border-radius: 999px;
    background: #8a5a2b;
}
.baitalgahwa-navbar .primary-navigation {
    margin-right: auto;
}
.baitalgahwa-navbar .primary-navigation .moremenu .nav-link {
    color: #3b2e24;
    font-size: .92rem;
    font-weight: 500;
    padding-inline: .75rem;
}
.baitalgahwa-navbar__search {
    display: inline-flex;
    align-items: center;
    min-width: clamp(16rem, 22vw, 24rem);
    max-width: min(24rem, 40vw);
    flex: 1 1 auto;
    height: 2.5rem;
    border: 1px solid #ebe5df;
    border-radius: .28rem;
    background: #fbfaf8;
    overflow: hidden;
    margin-inline: 0;
    transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
}
.baitalgahwa-navbar__search:hover,
.baitalgahwa-navbar__search:focus-within {
    border-color: #d8ccc0;
    background: #fff;
    box-shadow: 0 0 0 .16rem rgba(138, 90, 43, .08);
}
.baitalgahwa-navbar__search-input {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0 .95rem;
    font-size: .88rem;
    color: #4c4035;
    outline: 0;
}
.baitalgahwa-navbar__search-input::placeholder {
    color: #b2a497;
}
.baitalgahwa-navbar__search-btn {
    width: 2.7rem;
    height: 2.5rem;
    border: 0;
    border-left: 1px solid #efe9e3;
    background: transparent;
    color: #b2a394;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: color .18s ease, background-color .18s ease;
}
.baitalgahwa-navbar__search-btn:hover,
.baitalgahwa-navbar__search-btn:focus-visible {
    color: #8a5a2b;
    background: #f7f1eb;
}
.baitalgahwa-navbar__endcap {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    flex-wrap: nowrap;
    margin-inline-start: auto;
    min-width: 0;
}
.baitalgahwa-navbar #usernavigation {
    gap: .75rem;
    align-items: center;
    flex-wrap: nowrap;
    margin-inline-start: 0;
}
.baitalgahwa-navbar .usermenu-container {
    display: inline-flex;
    align-items: center;
    min-height: 100%;
    min-width: 0;
    flex-shrink: 0;
    padding-inline-start: .15rem;
}
.baitalgahwa-navbar .baitalgahwa-navbar__user-fullname {
    font-size: .9rem;
    font-weight: 600;
    color: #3b2f27;
    max-width: 11rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
}
.baitalgahwa-navbar #usernavigation .divider {
    display: none !important;
}
.baitalgahwa-navbar #usernavigation .nav-link,
.baitalgahwa-navbar #usernavigation .btn,
.baitalgahwa-navbar #usernavigation .usermenu .dropdown-toggle {
    color: #4a3b30;
}
.baitalgahwa-navbar__icon,
.baitalgahwa-navbar #usernavigation .popover-region-toggle,
.baitalgahwa-navbar #usernavigation .nav-link.icon-no-margin,
.baitalgahwa-navbar #usernavigation .btn.icon-no-margin {
    position: relative;
    width: auto;
    height: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 .08rem !important;
    border: 0 !important;
    border-radius: 0;
    background: transparent !important;
    box-shadow: none !important;
    text-decoration: none;
    color: #8f8276;
}
.baitalgahwa-navbar__utilities .baitalgahwa-navbar__icon:first-child::after {
    content: "";
    position: absolute;
    top: -.08rem;
    right: -.12rem;
    width: .48rem;
    height: .48rem;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #ef6a61;
}
.baitalgahwa-navbar__utilities {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
}
.baitalgahwa-navbar #usernavigation .popover-region-toggle .icon,
.baitalgahwa-navbar #usernavigation .nav-link .icon,
.baitalgahwa-navbar #usernavigation .btn .icon,
.baitalgahwa-navbar__icon .fa,
.baitalgahwa-navbar #usernavigation .fa {
    font-size: 1rem;
}
.baitalgahwa-navbar__core-output {
    display: none;
}
.baitalgahwa-navbar #usernavigation .popover-region {
    display: inline-flex;
    align-items: center;
}
.baitalgahwa-navbar #usernavigation .count-container,
.baitalgahwa-navbar #usernavigation .badge-counter {
    top: -.1rem !important;
    right: -.2rem !important;
    min-width: 1rem;
    height: 1rem;
    padding: 0 .2rem;
    border-radius: 999px;
    font-size: .62rem;
    line-height: 1rem;
}
.baitalgahwa-navbar .usermenu .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    flex-direction: row;
    gap: .55rem;
    padding: .2rem .15rem .2rem .15rem !important;
    border: 0 !important;
    background: transparent !important;
    border-radius: 999px;
    box-shadow: none !important;
}
.baitalgahwa-navbar .usermenu .action-menu-trigger {
    display: inline-flex;
    align-items: center;
}
.baitalgahwa-navbar .usermenu .usertext,
.baitalgahwa-navbar .usermenu .login {
    color: #8b5c2f;
    font-size: .98rem;
    font-weight: 500;
    min-width: 7.75rem;
    white-space: nowrap;
    letter-spacing: .01em;
}
.baitalgahwa-navbar .usermenu .dropdown-toggle img,
.baitalgahwa-navbar .usermenu .avatar,
.baitalgahwa-navbar .usermenu .userbutton .avatar {
    border-radius: 999px;
}
.baitalgahwa-navbar .usermenu img.userpicture,
.baitalgahwa-navbar .usermenu .avatar img {
    width: 3rem;
    height: 3rem;
    object-fit: cover;
    border: 0;
    box-shadow: 0 .18rem .45rem rgba(33,20,12,.16);
}
.baitalgahwa-navbar .logininfo,
.baitalgahwa-navbar .usermenu .login {
    font-size: .98rem;
}
.baitalgahwa-navbar .usermenu .dropdown-toggle::after {
    margin-inline-start: .05rem;
    margin-inline-end: 0;
    font-size: 1rem;
    color: #8f7869;
    border: 0;
    width: .7rem;
    height: .7rem;
    border-right: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
    transform: rotate(45deg) translateY(-.05rem);
}
.baitalgahwa-navbar__icon:hover,
.baitalgahwa-navbar__icon:focus-visible,
.baitalgahwa-navbar #usernavigation .popover-region-toggle:hover,
.baitalgahwa-navbar #usernavigation .popover-region-toggle:focus-visible {
    color: #8a5a2b;
    background: transparent !important;
}
.pagelayout-login .baitalgahwa-header {
    position: static;
}
@media (max-width: 991.98px) {
    .baitalgahwa-navbar {
        padding-inline: .5rem;
    }
    .baitalgahwa-navbar__inner {
        width: 100%;
        gap: .75rem;
    }
    .baitalgahwa-navbar__search {
        min-width: 11rem;
        max-width: 100%;
        flex: 1 1 12rem;
    }
    .baitalgahwa-navbar__endcap {
        width: 100%;
        justify-content: flex-end;
        flex-wrap: wrap;
        margin-top: .35rem;
    }
}
</style>
<header class="baitalgahwa-header">
<nav class="navbar fixed-top navbar-expand baitalgahwa-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid baitalgahwa-navbar__inner">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
        </button>
        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex m-0 me-4 p-0 aabtn">
            <span class="baitalgahwa-navbar__brand-lockup">
            {{#themelogourl}}
                <img src="{{{ themelogourl }}}" class="baitalgahwa-custom-logo logo" alt="{{sitename}}">
                <span class="baitalgahwa-navbar__logo-subtitle">Bait Al Gahwa</span>
            {{/themelogourl}}
            {{^themelogourl}}
                {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo" alt="{{sitename}}">
                <span class="baitalgahwa-navbar__logo-subtitle">Bait Al Gahwa</span>
                {{/ output.should_display_navbar_logo }}
                {{^ output.should_display_navbar_logo }}
                <span class="baitalgahwa-sitename text-reset">{{{ sitename }}}</span>
                {{/ output.should_display_navbar_logo }}
            {{/themelogourl}}
            </span>
        </a>
        <div class="baitalgahwa-navbar__custom-links d-none d-lg-flex" aria-label="Primary">
            <a class="baitalgahwa-navbar__link baitalgahwa-navbar__link--active" href="{{{ config.homeurl }}}">{{#str}}home, core{{/str}}</a>
            <a class="baitalgahwa-navbar__link" href="{{{ config.abouturl }}}">{{#str}}aboutus, theme_baitalgahwa{{/str}}</a>
            <a class="baitalgahwa-navbar__link" href="{{{ config.trainingurl }}}">{{#str}}trainingprogram, theme_baitalgahwa{{/str}}</a>
            <a class="baitalgahwa-navbar__link" href="{{{ config.contacturl }}}">{{#str}}contactus, theme_baitalgahwa{{/str}}</a>
        </div>
        {{#primarymoremenu}}
        <div class="primary-navigation d-none d-md-flex d-lg-none">
            {{> core/moremenu}}
        </div>
        {{/primarymoremenu}}
        {{# output.page_heading_menu}}
        <ul class="navbar-nav d-none my-1 px-1">
            {{{ output.page_heading_menu }}}
        </ul>
        {{/output.page_heading_menu}}
        <div class="baitalgahwa-navbar__endcap">
        <form class="baitalgahwa-navbar__search d-none d-md-inline-flex" action="{{{ config.searchurl }}}" method="get" role="search" aria-label="Search">
            <input class="baitalgahwa-navbar__search-input" type="search" name="search" placeholder="Search">
            <button class="baitalgahwa-navbar__search-btn" type="submit" aria-label="Search">
                <i class="fa fa-search" aria-hidden="true"></i>
            </button>
        </form>
        <div id="usernavigation" class="navbar-nav h-100">
            {{#langmenu}}
            {{> theme_boost/language_menu }}
            <div class="divider border-start h-75 align-self-center mx-1 d-none d-md-block"></div>
            {{/langmenu}}
            <div class="baitalgahwa-navbar__utilities d-none d-md-inline-flex" aria-label="Quick actions">
                <a class="baitalgahwa-navbar__icon" href="{{{ config.notificationsurl }}}" aria-label="Notifications">
                    <i class="fa fa-bell-o" aria-hidden="true"></i>
                </a>
                <a class="baitalgahwa-navbar__icon" href="{{{ config.messagesurl }}}" aria-label="Messages">
                    <i class="fa fa-comment-o" aria-hidden="true"></i>
                </a>
            </div>
            <div class="baitalgahwa-navbar__core-output">
                {{{ output.navbar_plugin_output }}}
            </div>
            <div class="usermenu-container" data-region="usermenu">
                {{#usermenu}}
                {{> core/user_menu }}
                {{/usermenu}}
            </div>
        </div>
        </div>
    </div>
</nav>
</header>
{{> theme_boost/primary-drawer-mobile }}
