{{!
    @template theme_baitalgahwa/navbar
}}
<style>
.baitalgahwa-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 1030;
}
.baitalgahwa-navbar {
    min-height: 4.7rem;
    background: rgba(255,255,255,.98) !important;
    border-bottom: 1px solid rgba(64, 39, 18, .09);
    border-radius: 0 0 1.15rem 1.15rem;
    box-shadow: 0 .55rem 1.2rem rgba(33,20,12,.12);
    padding-inline: 1rem;
}
.baitalgahwa-navbar__inner {
    width: min(100%, 1320px);
    margin: 0 auto;
    gap: 1.4rem;
}
.baitalgahwa-navbar .navbar-brand {
    margin-right: 1.2rem !important;
}
.baitalgahwa-custom-logo,
.baitalgahwa-navbar .logo {
    max-height: 2.95rem;
    width: auto;
    object-fit: contain;
}
.baitalgahwa-navbar__custom-links {
    align-items: center;
    gap: 1.65rem;
    margin-inline-end: auto;
}
.baitalgahwa-navbar__link {
    position: relative;
    color: #3b2e24;
    text-decoration: none;
    font-size: .84rem;
    font-weight: 700;
    padding: .4rem 0;
    letter-spacing: .01em;
    text-transform: none;
}
.baitalgahwa-navbar__link--active,
.baitalgahwa-navbar__link:hover,
.baitalgahwa-navbar__link:focus-visible {
    color: #1f1712;
}
.baitalgahwa-navbar__link--active::after,
.baitalgahwa-navbar__link:hover::after,
.baitalgahwa-navbar__link:focus-visible::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -.55rem;
    height: 2px;
    border-radius: 999px;
    background: #8a5a2b;
}
.baitalgahwa-navbar .primary-navigation {
    margin-right: auto;
}
.baitalgahwa-navbar .primary-navigation .moremenu .nav-link {
    color: #3b2e24;
    font-size: .92rem;
    font-weight: 500;
    padding-inline: .75rem;
}
.baitalgahwa-navbar__search {
    display: inline-flex;
    align-items: center;
    min-width: min(16rem, 22vw);
    height: 2.35rem;
    border: 1px solid #e8ddd1;
    border-radius: .42rem;
    background: #faf8f6;
    overflow: hidden;
}
.baitalgahwa-navbar__search-input {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0 .85rem;
    font-size: .82rem;
    color: #4c4035;
    outline: 0;
}
.baitalgahwa-navbar__search-input::placeholder {
    color: #a49485;
}
.baitalgahwa-navbar__search-btn {
    width: 2.25rem;
    height: 2.35rem;
    border: 0;
    border-left: 1px solid #e8ddd1;
    background: transparent;
    color: #9b8a7a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
}
.baitalgahwa-navbar #usernavigation {
    gap: .65rem;
    align-items: center;
}
.baitalgahwa-navbar #usernavigation .divider {
    display: none !important;
}
.baitalgahwa-navbar #usernavigation .nav-link,
.baitalgahwa-navbar #usernavigation .btn,
.baitalgahwa-navbar #usernavigation .usermenu .dropdown-toggle {
    color: #4a3b30;
}
.baitalgahwa-navbar__icon,
.baitalgahwa-navbar #usernavigation .popover-region-toggle,
.baitalgahwa-navbar #usernavigation .nav-link.icon-no-margin,
.baitalgahwa-navbar #usernavigation .btn.icon-no-margin {
    width: 2.05rem;
    height: 2.05rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 !important;
    border: 1px solid transparent !important;
    border-radius: 999px;
    background: rgba(255,255,255,.9) !important;
    box-shadow: none !important;
    text-decoration: none;
}
.baitalgahwa-navbar__utilities {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
}
.baitalgahwa-navbar #usernavigation .popover-region-toggle .icon,
.baitalgahwa-navbar #usernavigation .nav-link .icon,
.baitalgahwa-navbar #usernavigation .btn .icon,
.baitalgahwa-navbar__icon .fa,
.baitalgahwa-navbar #usernavigation .fa {
    font-size: .95rem;
}
.baitalgahwa-navbar__core-output {
    display: none;
}
.baitalgahwa-navbar #usernavigation .popover-region {
    display: inline-flex;
    align-items: center;
}
.baitalgahwa-navbar #usernavigation .count-container,
.baitalgahwa-navbar #usernavigation .badge-counter {
    top: -.1rem !important;
    right: -.2rem !important;
    min-width: 1rem;
    height: 1rem;
    padding: 0 .2rem;
    border-radius: 999px;
    font-size: .62rem;
    line-height: 1rem;
}
.baitalgahwa-navbar .usermenu .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .15rem .1rem .15rem .15rem !important;
    border: 0 !important;
    background: transparent !important;
    border-radius: 999px;
}
.baitalgahwa-navbar .usermenu .usertext,
.baitalgahwa-navbar .usermenu .login {
    color: #4a3b30;
    font-size: .82rem;
    font-weight: 700;
    white-space: nowrap;
}
.baitalgahwa-navbar .usermenu .dropdown-toggle img,
.baitalgahwa-navbar .usermenu .avatar,
.baitalgahwa-navbar .usermenu .userbutton .avatar {
    border-radius: 999px;
}
.baitalgahwa-navbar .usermenu img.userpicture,
.baitalgahwa-navbar .usermenu .avatar img {
    width: 2.2rem;
    height: 2.2rem;
    object-fit: cover;
    border: 2px solid rgba(138, 90, 43, .16);
}
.baitalgahwa-navbar .logininfo,
.baitalgahwa-navbar .usermenu .login {
    font-size: .9rem;
}
.baitalgahwa-navbar .usermenu .dropdown-toggle::after {
    margin-inline-start: .1rem;
    color: #8a5a2b;
}
.baitalgahwa-navbar__icon:hover,
.baitalgahwa-navbar__icon:focus-visible,
.baitalgahwa-navbar #usernavigation .popover-region-toggle:hover,
.baitalgahwa-navbar #usernavigation .popover-region-toggle:focus-visible {
    color: #8a5a2b;
    border-color: #e7d7c7 !important;
    background: #fff !important;
}
.baitalgahwa-navbar .editmode-switch-form {
    margin-inline-start: .35rem;
}
.baitalgahwa-navbar .editmode-switch-form .custom-control {
    margin-bottom: 0;
}
.baitalgahwa-navbar .editmode-switch-form label,
.baitalgahwa-navbar .editmode-switch-form .custom-control-label {
    color: #7b6c5d;
    font-size: .74rem;
    font-weight: 700;
}
.pagelayout-login .baitalgahwa-header {
    position: static;
}
@media (max-width: 991.98px) {
    .baitalgahwa-navbar {
        border-radius: 0;
        padding-inline: .5rem;
    }
    .baitalgahwa-navbar__inner {
        width: 100%;
        gap: .75rem;
    }
    .baitalgahwa-navbar__search {
        min-width: 10rem;
    }
}
</style>
<header class="baitalgahwa-header">
<nav class="navbar fixed-top navbar-expand baitalgahwa-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid baitalgahwa-navbar__inner">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
        </button>
        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn">
            {{#themelogourl}}
                <img src="{{{ themelogourl }}}" class="baitalgahwa-custom-logo logo me-1" alt="{{sitename}}">
            {{/themelogourl}}
            {{^themelogourl}}
                {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
                {{/ output.should_display_navbar_logo }}
                {{^ output.should_display_navbar_logo }}
                <span class="baitalgahwa-sitename text-reset">{{{ sitename }}}</span>
                {{/ output.should_display_navbar_logo }}
            {{/themelogourl}}
        </a>
        <div class="baitalgahwa-navbar__custom-links d-none d-lg-flex" aria-label="Primary">
            <a class="baitalgahwa-navbar__link baitalgahwa-navbar__link--active" href="{{{ config.homeurl }}}">{{#str}}home, core{{/str}}</a>
            <a class="baitalgahwa-navbar__link" href="{{{ config.abouturl }}}">{{#str}}aboutus, theme_baitalgahwa{{/str}}</a>
            <a class="baitalgahwa-navbar__link" href="{{{ config.trainingurl }}}">{{#str}}trainingprogram, theme_baitalgahwa{{/str}}</a>
            <a class="baitalgahwa-navbar__link" href="{{{ config.contacturl }}}">{{#str}}contactus, theme_baitalgahwa{{/str}}</a>
        </div>
        {{#primarymoremenu}}
        <div class="primary-navigation d-none d-md-flex d-lg-none">
            {{> core/moremenu}}
        </div>
        {{/primarymoremenu}}
        {{# output.page_heading_menu}}
        <ul class="navbar-nav d-none my-1 px-1">
            {{{ output.page_heading_menu }}}
        </ul>
        {{/output.page_heading_menu}}
        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            <form class="baitalgahwa-navbar__search d-none d-md-inline-flex" action="{{{ config.searchurl }}}" method="get" role="search" aria-label="Search">
                <input class="baitalgahwa-navbar__search-input" type="search" name="search" placeholder="Search">
                <button class="baitalgahwa-navbar__search-btn" type="submit" aria-label="Search">
                    <i class="fa fa-search" aria-hidden="true"></i>
                </button>
            </form>
            {{#langmenu}}
            {{> theme_boost/language_menu }}
            <div class="divider border-start h-75 align-self-center mx-1 d-none d-md-block"></div>
            {{/langmenu}}
            <div class="baitalgahwa-navbar__utilities d-none d-md-inline-flex" aria-label="Quick actions">
                <a class="baitalgahwa-navbar__icon" href="{{{ config.notificationsurl }}}" aria-label="Notifications">
                    <i class="fa fa-bell-o" aria-hidden="true"></i>
                </a>
                <a class="baitalgahwa-navbar__icon" href="{{{ config.messagesurl }}}" aria-label="Messages">
                    <i class="fa fa-comment-o" aria-hidden="true"></i>
                </a>
            </div>
            <div class="baitalgahwa-navbar__core-output">
                {{{ output.navbar_plugin_output }}}
            </div>
            <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                {{#usermenu}}
                {{> core/user_menu }}
                {{/usermenu}}
            </div>
            {{{ output.edit_switch }}}
        </div>
    </div>
</nav>
</header>
{{> theme_boost/primary-drawer-mobile }}
