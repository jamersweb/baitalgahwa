{{!
    @template theme_baitalgahwa/footer
    Branded footer + Moodle footer popover.
}}
<style>
body.pagelayout-mydashboard,
body#page-my-index,
body.pagelayout-mycourses {
    overflow-x: hidden;
}
.baitalgahwa-footer {
    position: relative;
    margin-top: 2.75rem;
    width: 100vw;
    max-width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    background: #7c4f26;
    color: rgba(255,255,255,.92);
    display: block;
}
.baitalgahwa-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, rgba(255,255,255,.03), rgba(0,0,0,.04)),
        radial-gradient(circle at 78% 65%, rgba(255,255,255,.05), transparent 24rem);
    pointer-events: none;
}
.baitalgahwa-footer::after {
    content: "";
    position: absolute;
    right: clamp(1rem, 7vw, 8rem);
    bottom: -4.2rem;
    width: min(35rem, 42vw);
    height: min(35rem, 42vw);
    background: url('{{{ footerflowerurl }}}') no-repeat center / contain;
    opacity: .30;
    filter: none;
    mix-blend-mode: normal;
    pointer-events: none;
    z-index: 2;
}
.baitalgahwa-footer__top {
    position: relative;
    z-index: 1;
}
.baitalgahwa-footer__top,
.baitalgahwa-footer__moodle,
.baitalgahwa-footer__copy {
    width: 100%;
}
.baitalgahwa-footer__brand {
    position: relative;
    padding-top: .55rem;
}
.baitalgahwa-footer__top .container {
    width: min(calc(100% - clamp(4rem, 10vw, 12rem)), 1560px);
    max-width: none;
    padding-inline: 0;
}
.baitalgahwa-footer__logo {
    max-width: 12rem;
    height: auto;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(74%) sepia(43%) saturate(549%) hue-rotate(358deg) brightness(95%) contrast(88%);
}
.baitalgahwa-footer__about {
    max-width: 21rem;
    margin-top: 1.65rem;
    color: rgba(255,255,255,.93);
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 500;
}
.baitalgahwa-footer__heading {
    margin-bottom: 1.25rem;
    color: #c79f55;
    font-size: 1rem;
    font-weight: 700;
}
.baitalgahwa-footer__list li + li {
    margin-top: .95rem;
}
.baitalgahwa-footer__link,
.baitalgahwa-footer__text {
    color: rgba(255,255,255,.92);
    text-decoration: none;
    font-size: .98rem;
    line-height: 1.55;
    font-weight: 500;
}
.baitalgahwa-footer__link:hover,
.baitalgahwa-footer__link:focus-visible {
    color: #fff;
    text-decoration: none;
}
.baitalgahwa-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.45rem;
    height: 2.45rem;
    border-radius: 50%;
    background: rgba(255,255,255,.96);
    color: #875628;
    text-decoration: none;
    box-shadow: 0 .35rem .9rem rgba(0,0,0,.14);
    transition: transform .16s ease, box-shadow .16s ease;
}
.baitalgahwa-footer__social-link i {
    font-size: .95rem;
}
.baitalgahwa-footer__social-link:hover,
.baitalgahwa-footer__social-link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 .55rem 1rem rgba(0,0,0,.18);
}
.baitalgahwa-footer__social-link img {
    display: block;
    object-fit: contain;
}
.baitalgahwa-footer__social {
    gap: .7rem !important;
}
.baitalgahwa-footer__moodle,
.baitalgahwa-footer__moodle #page-footer,
.baitalgahwa-footer__moodle [data-region="footer-container-popover"],
.baitalgahwa-footer__moodle .footer-content-popover,
.baitalgahwa-footer__moodle .footer-content-debugging {
    display: none;
}
.baitalgahwa-footer__copy {
    position: relative;
    z-index: 1;
    color: rgba(255,255,255,.78);
    border-top: 1px solid rgba(255,255,255,.12);
    font-size: .82rem;
    letter-spacing: .01em;
}
@media (max-width: 767.98px) {
    .baitalgahwa-footer__top .container {
        width: min(calc(100% - 2rem), 1560px);
        padding-inline: 0;
    }
    .baitalgahwa-footer__about {
        margin-top: 1.5rem;
        max-width: none;
    }
    .baitalgahwa-footer::after {
        width: 16rem;
        height: 16rem;
        right: -1.5rem;
        bottom: -2rem;
        opacity: .30;
    }
}
body.pagelayout-mydashboard .baitalgahwa-footer,
body#page-my-index .baitalgahwa-footer,
body.pagelayout-mycourses .baitalgahwa-footer {
    margin-top: 2.25rem;
}
body.pagelayout-mydashboard .baitalgahwa-footer::after,
body#page-my-index .baitalgahwa-footer::after,
body.pagelayout-mycourses .baitalgahwa-footer::after {
    right: clamp(3rem, 11vw, 13rem);
    bottom: -5rem;
    width: min(34rem, 36vw);
    height: min(34rem, 36vw);
    opacity: .30;
}
body.bag-figma-user-dashboard .baitalgahwa-footer {
    margin-top: 0;
    background: #6b4423;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__top {
    min-height: 403px;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__top .container {
    width: min(100%, 1280px);
    padding-inline: 0;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__logo {
    max-width: 190px;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__about {
    max-width: 413px;
    font-size: 18px;
    line-height: 1.2;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__heading,
body.bag-figma-user-dashboard .baitalgahwa-footer__link,
body.bag-figma-user-dashboard .baitalgahwa-footer__text {
    font-size: 18px;
    line-height: 25px;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__heading {
    color: #c9a961;
    opacity: .7;
}
body.bag-figma-user-dashboard .baitalgahwa-footer__copy {
    color: rgba(255,255,255,.7);
    font-size: 16px;
    line-height: 22px;
}
body.bag-figma-user-dashboard .baitalgahwa-footer::after {
    right: -1rem;
    bottom: -5.5rem;
    width: 38rem;
    height: 36rem;
    opacity: .13;
    filter: none;
}
body.bag-about-body .baitalgahwa-footer {
    margin-top: 0;
    background: #875628;
}
body.bag-about-body .baitalgahwa-footer__top {
    min-height: 374px;
}
body.bag-about-body .baitalgahwa-footer__top .container {
    width: min(100%, 1280px);
    padding-inline: 0;
}
body.bag-about-body .baitalgahwa-footer__logo {
    max-width: 190px;
}
body.bag-about-body .baitalgahwa-footer__about {
    max-width: 342px;
    font-size: 16px;
    line-height: 1.55;
}
body.bag-about-body .baitalgahwa-footer__heading,
body.bag-about-body .baitalgahwa-footer__link,
body.bag-about-body .baitalgahwa-footer__text {
    font-size: 16px;
    line-height: 25px;
}
body.bag-about-body .baitalgahwa-footer__heading {
    color: #c9a961;
}
body.bag-about-body .baitalgahwa-footer::after {
    right: 5rem;
    bottom: -4rem;
    width: 31rem;
    height: 31rem;
    opacity: .28;
    filter: none;
}
body.bag-training-body .baitalgahwa-footer,
body.bag-programme-body .baitalgahwa-footer,
body.bag-contact-body .baitalgahwa-footer {
    margin-top: 0;
    background: #875628;
}
body.bag-training-body .baitalgahwa-footer__top,
body.bag-programme-body .baitalgahwa-footer__top,
body.bag-contact-body .baitalgahwa-footer__top {
    min-height: 374px;
}
body.bag-training-body .baitalgahwa-footer__top .container,
body.bag-programme-body .baitalgahwa-footer__top .container,
body.bag-contact-body .baitalgahwa-footer__top .container {
    width: min(100%, 1280px);
    padding-inline: 0;
}
body.bag-training-body .baitalgahwa-footer__logo,
body.bag-programme-body .baitalgahwa-footer__logo,
body.bag-contact-body .baitalgahwa-footer__logo {
    max-width: 190px;
}
body.bag-training-body .baitalgahwa-footer__about,
body.bag-programme-body .baitalgahwa-footer__about,
body.bag-contact-body .baitalgahwa-footer__about {
    max-width: 342px;
    font-size: 16px;
    line-height: 1.55;
}
body.bag-training-body .baitalgahwa-footer__heading,
body.bag-training-body .baitalgahwa-footer__link,
body.bag-training-body .baitalgahwa-footer__text,
body.bag-programme-body .baitalgahwa-footer__heading,
body.bag-programme-body .baitalgahwa-footer__link,
body.bag-programme-body .baitalgahwa-footer__text,
body.bag-contact-body .baitalgahwa-footer__heading,
body.bag-contact-body .baitalgahwa-footer__link,
body.bag-contact-body .baitalgahwa-footer__text {
    font-size: 16px;
    line-height: 25px;
}
body.bag-training-body .baitalgahwa-footer__heading,
body.bag-programme-body .baitalgahwa-footer__heading,
body.bag-contact-body .baitalgahwa-footer__heading {
    color: #c9a961;
}
body.bag-training-body .baitalgahwa-footer::after,
body.bag-programme-body .baitalgahwa-footer::after,
body.bag-contact-body .baitalgahwa-footer::after {
    right: 5rem;
    bottom: -4rem;
    width: 31rem;
    height: 31rem;
    opacity: .28;
    filter: none;
}
</style>
<footer class="baitalgahwa-footer" role="contentinfo">
    <div class="baitalgahwa-footer__top py-5">
        <div class="container">
            <div class="row g-4 g-lg-5 align-items-start">
                <div class="col-lg-4" id="bag-footer-about">
                    <div class="baitalgahwa-footer__brand">
                        {{#themelogourl}}
                        <img class="baitalgahwa-footer__logo mb-3" src="{{{ themelogourl }}}" alt="{{ sitename }}" width="180" height="56">
                        {{/themelogourl}}
                        <p class="baitalgahwa-footer__about mb-4">{{ footerabout }}</p>
                        <div class="baitalgahwa-footer__social d-flex flex-wrap gap-3">
                            <a class="baitalgahwa-footer__social-link" href="{{#instagram}}{{{.}}}{{/instagram}}{{^instagram}}#{{/instagram}}" {{#instagram}}rel="noopener" target="_blank"{{/instagram}} aria-label="Instagram"><i class="fa fa-instagram" aria-hidden="true"></i></a>
                            <a class="baitalgahwa-footer__social-link" href="{{#footeremail}}mailto:{{.}}{{/footeremail}}{{^footeremail}}#{{/footeremail}}" aria-label="Email"><i class="fa fa-envelope-o" aria-hidden="true"></i></a>
                            <a class="baitalgahwa-footer__social-link" href="{{#footerphone}}tel:{{.}}{{/footerphone}}{{^footerphone}}#{{/footerphone}}" aria-label="Phone"><i class="fa fa-phone" aria-hidden="true"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h3 class="baitalgahwa-footer__heading">{{#str}}footerquick, theme_baitalgahwa{{/str}}</h3>
                    <ul class="list-unstyled baitalgahwa-footer__list mb-0">
                        <li><a class="baitalgahwa-footer__link" href="{{{config.homeurl}}}">{{#str}}home, core{{/str}}</a></li>
                        <li><a class="baitalgahwa-footer__link" href="{{{ config.abouturl }}}">{{#str}}aboutus, theme_baitalgahwa{{/str}}</a></li>
                        <li><a class="baitalgahwa-footer__link" href="{{{ config.trainingurl }}}">{{#str}}trainingprogram, theme_baitalgahwa{{/str}}</a></li>
                        <li>{{#footeremail}}<a class="baitalgahwa-footer__link" href="mailto:{{.}}">{{#str}}contactus, theme_baitalgahwa{{/str}}</a>{{/footeremail}}{{^footeremail}}<span class="baitalgahwa-footer__text">{{#str}}contactus, theme_baitalgahwa{{/str}}</span>{{/footeremail}}</li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-3" id="bag-footer-programs">
                    <h3 class="baitalgahwa-footer__heading">{{#str}}footerprograms, theme_baitalgahwa{{/str}}</h3>
                    <ul class="list-unstyled baitalgahwa-footer__list mb-0">
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_1, theme_baitalgahwa{{/str}}</span></li>
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_2, theme_baitalgahwa{{/str}}</span></li>
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_3, theme_baitalgahwa{{/str}}</span></li>
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_4, theme_baitalgahwa{{/str}}</span></li>
                    </ul>
                </div>
                <div class="col-lg-2" id="bag-footer-contact">
                    <h3 class="baitalgahwa-footer__heading">{{#str}}footercontact, theme_baitalgahwa{{/str}}</h3>
                    <ul class="list-unstyled baitalgahwa-footer__list mb-0">
                        {{#footeremail}}<li><a class="baitalgahwa-footer__link" href="mailto:{{.}}">{{.}}</a></li>{{/footeremail}}
                        {{#footerphone}}<li><span class="baitalgahwa-footer__text">{{.}}</span></li>{{/footerphone}}
                        {{#footeraddress}}<li><span class="baitalgahwa-footer__text">{{.}}</span></li>{{/footeraddress}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="baitalgahwa-footer__moodle">
        <div id="page-footer" class="footer-popover mb-0" role="region" aria-label="{{#str}}footer, admin{{/str}}">
            <div data-region="footer-container-popover">
                {{#output.has_communication_links}}
                <button onclick="window.open('{{output.communication_url}}', '_blank', 'noreferrer')" class="btn btn-icon bg-primary text-white icon-no-margin btn-footer-communication" aria-label="{{#str}}communicationroomlink, course{{/str}}">
                    {{#pix}}t/messages-o, core{{/pix}}
                </button>
                {{/output.has_communication_links}}
                <button class="btn btn-icon bg-secondary icon-no-margin btn-footer-popover" data-action="footer-popover" aria-label="{{#str}}showfooter, theme_boost{{/str}}">
                    {{#pix}}e/question, core{{/pix}}
                </button>
            </div>
            <div class="footer-content-popover container" data-region="footer-content-popover">
                {{#output.has_communication_links}}
                <div class="footer-section p-3 border-bottom footer-link-communication">
                    <div class="footer-support-link">{{{ output.communication_link }}}</div>
                </div>
                {{/output.has_communication_links}}
                {{#output.has_popover_links}}
                <div class="footer-section p-3 border-bottom">
                    {{#output.page_doc_link}}<div class="footer-support-link">{{{ output.page_doc_link }}}</div>{{/output.page_doc_link}}
                    {{#output.services_support_link}}<div class="footer-support-link">{{{ output.services_support_link }}}</div>{{/output.services_support_link}}
                    {{#output.supportemail}}<div class="footer-support-link">{{{ output.supportemail }}}</div>{{/output.supportemail}}
                </div>
                {{/output.has_popover_links}}
                <div class="footer-section p-3 border-bottom">
                    <div class="logininfo">{{{ output.login_info }}}</div>
                    <div class="tool_usertours-resettourcontainer"></div>
                    {{{ output.standard_footer_html }}}
                </div>
                <div class="footer-section p-3">
                    <div>{{#str}}poweredbymoodle, core{{/str}}</div>
                    {{#output.moodle_release}}<div>{{#str}}version, core{{/str}} {{{ output.moodle_release }}}</div>{{/output.moodle_release}}
                </div>
            </div>
            <div class="footer-content-debugging footer-dark bg-dark text-light">
                <div class="container-fluid footer-dark-inner">
                    {{{ output.debug_footer_html }}}
                </div>
            </div>
        </div>
    </div>
    <div hidden>
        {{{ output.standard_end_of_body_html }}}
    </div>
    <p class="baitalgahwa-footer__copy text-center small py-3 mb-0">{{#str}}footercopyright, theme_baitalgahwa{{/str}}</p>
</footer>
