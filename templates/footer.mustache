{{!
    @template theme_baitalgahwa/footer
    Branded footer + Moodle footer popover.
}}
<style>
.baitalgahwa-footer {
    position: relative;
    margin-top: 4rem;
    width: 100vw;
    max-width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    background:
        radial-gradient(circle at 85% 18%, rgba(255,255,255,.08), transparent 18rem),
        radial-gradient(circle at 100% 100%, rgba(255,255,255,.06), transparent 24rem),
        linear-gradient(180deg, #875628 0%, #74461f 100%);
    color: rgba(255,255,255,.92);
}
.baitalgahwa-footer::after {
    content: "";
    position: absolute;
    right: -6rem;
    bottom: -7rem;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,.08), transparent 62%);
    pointer-events: none;
}
.baitalgahwa-footer__top {
    position: relative;
    z-index: 1;
}
.baitalgahwa-footer__top,
.baitalgahwa-footer__moodle,
.baitalgahwa-footer__copy {
    width: 100%;
}
.baitalgahwa-footer__top .container {
    width: min(100%, 1320px);
    max-width: none;
    padding-inline: 2rem;
}
.baitalgahwa-footer__logo {
    max-width: 11.5rem;
    height: auto;
    object-fit: contain;
    filter: brightness(1.08) saturate(.92);
}
.baitalgahwa-footer__about {
    max-width: 19rem;
    color: rgba(255,255,255,.9);
    font-size: .95rem;
    line-height: 1.65;
}
.baitalgahwa-footer__heading {
    margin-bottom: 1.2rem;
    color: #d0ad59;
    font-size: 1.12rem;
    font-weight: 700;
}
.baitalgahwa-footer__list li + li {
    margin-top: .72rem;
}
.baitalgahwa-footer__link,
.baitalgahwa-footer__text {
    color: rgba(255,255,255,.92);
    text-decoration: none;
    font-size: .92rem;
    line-height: 1.55;
}
.baitalgahwa-footer__link:hover,
.baitalgahwa-footer__link:focus-visible {
    color: #fff;
    text-decoration: none;
}
.baitalgahwa-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.45rem;
    height: 2.45rem;
    border-radius: 50%;
    background: rgba(255,255,255,.96);
    color: #875628;
    text-decoration: none;
    box-shadow: 0 .35rem .9rem rgba(0,0,0,.14);
    transition: transform .16s ease, box-shadow .16s ease;
}
.baitalgahwa-footer__social-link:hover,
.baitalgahwa-footer__social-link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 .55rem 1rem rgba(0,0,0,.18);
}
.baitalgahwa-footer__social-link img {
    display: block;
    object-fit: contain;
}
.baitalgahwa-footer__social {
    gap: .75rem !important;
}
.baitalgahwa-footer__moodle #page-footer {
    background: transparent;
    color: rgba(255,255,255,.82);
}
.baitalgahwa-footer__moodle .footer-content-popover {
    display: none;
}
.baitalgahwa-footer__copy {
    position: relative;
    z-index: 1;
    color: rgba(255,255,255,.72);
    border-top: 1px solid rgba(255,255,255,.12);
    font-size: .76rem;
}
@media (max-width: 767.98px) {
    .baitalgahwa-footer__top .container {
        width: 100%;
        padding-inline: 1rem;
    }
}
</style>
<footer class="baitalgahwa-footer" role="contentinfo">
    <div class="baitalgahwa-footer__top py-5">
        <div class="container">
            <div class="row g-4 g-lg-5 align-items-start">
                <div class="col-lg-4" id="bag-footer-about">
                    <div class="baitalgahwa-footer__brand">
                        {{#themelogourl}}
                        <img class="baitalgahwa-footer__logo mb-3" src="{{{ themelogourl }}}" alt="{{ sitename }}" width="180" height="56">
                        {{/themelogourl}}
                        <p class="baitalgahwa-footer__about mb-4">{{#footerabout}}{{footerabout}}{{/footerabout}}{{^footerabout}}Empowering professionals through quality training and development programmes inspired by Emirati heritage.{{/footerabout}}</p>
                        <div class="baitalgahwa-footer__social d-flex flex-wrap gap-3">
                            {{#facebook}}<a class="baitalgahwa-footer__social-link" href="{{{.}}}" rel="noopener" target="_blank" aria-label="Facebook"><img src="{{{ footerfacebookicon }}}" alt="" width="18" height="18"></a>{{/facebook}}
                            {{#instagram}}<a class="baitalgahwa-footer__social-link" href="{{{.}}}" rel="noopener" target="_blank" aria-label="Instagram"><img src="{{{ footerinstagramicon }}}" alt="" width="18" height="18"></a>{{/instagram}}
                            {{#linkedin}}<a class="baitalgahwa-footer__social-link" href="{{{.}}}" rel="noopener" target="_blank" aria-label="LinkedIn"><img src="{{{ footerlinkedinicon }}}" alt="" width="18" height="18"></a>{{/linkedin}}
                            {{#twitter}}<a class="baitalgahwa-footer__social-link" href="{{{.}}}" rel="noopener" target="_blank" aria-label="X"><img src="{{{ footertwittericon }}}" alt="" width="18" height="18"></a>{{/twitter}}
                            {{#footeremail}}<a class="baitalgahwa-footer__social-link" href="mailto:{{.}}" aria-label="Email"><i class="fa fa-envelope-o" aria-hidden="true"></i></a>{{/footeremail}}
                            {{#footerphone}}<a class="baitalgahwa-footer__social-link" href="tel:{{.}}" aria-label="Phone"><i class="fa fa-phone" aria-hidden="true"></i></a>{{/footerphone}}
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h3 class="baitalgahwa-footer__heading">{{#str}}footerquick, theme_baitalgahwa{{/str}}</h3>
                    <ul class="list-unstyled baitalgahwa-footer__list mb-0">
                        <li><a class="baitalgahwa-footer__link" href="{{{config.homeurl}}}">{{#str}}home, core{{/str}}</a></li>
                        <li><a class="baitalgahwa-footer__link" href="#bag-footer-about">{{#str}}aboutus, theme_baitalgahwa{{/str}}</a></li>
                        <li><a class="baitalgahwa-footer__link" href="#bag-footer-programs">{{#str}}trainingprogram, theme_baitalgahwa{{/str}}</a></li>
                        <li>{{#footeremail}}<a class="baitalgahwa-footer__link" href="mailto:{{.}}">{{#str}}contactus, theme_baitalgahwa{{/str}}</a>{{/footeremail}}{{^footeremail}}<span class="baitalgahwa-footer__text">{{#str}}contactus, theme_baitalgahwa{{/str}}</span>{{/footeremail}}</li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-3" id="bag-footer-programs">
                    <h3 class="baitalgahwa-footer__heading">{{#str}}footerprograms, theme_baitalgahwa{{/str}}</h3>
                    <ul class="list-unstyled baitalgahwa-footer__list mb-0">
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_1, theme_baitalgahwa{{/str}}</span></li>
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_2, theme_baitalgahwa{{/str}}</span></li>
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_3, theme_baitalgahwa{{/str}}</span></li>
                        <li><span class="baitalgahwa-footer__text">{{#str}}footerprogram_4, theme_baitalgahwa{{/str}}</span></li>
                    </ul>
                </div>
                <div class="col-lg-2" id="bag-footer-contact">
                    <h3 class="baitalgahwa-footer__heading">{{#str}}footercontact, theme_baitalgahwa{{/str}}</h3>
                    <ul class="list-unstyled baitalgahwa-footer__list mb-0">
                        {{#footeremail}}<li><a class="baitalgahwa-footer__link" href="mailto:{{.}}">{{.}}</a></li>{{/footeremail}}
                        {{#footerphone}}<li><span class="baitalgahwa-footer__text">{{.}}</span></li>{{/footerphone}}
                        {{#footeraddress}}<li><span class="baitalgahwa-footer__text">{{.}}</span></li>{{/footeraddress}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="baitalgahwa-footer__moodle">
        <div id="page-footer" class="footer-popover mb-0" role="region" aria-label="{{#str}}footer, admin{{/str}}">
            <div data-region="footer-container-popover">
                {{#output.has_communication_links}}
                <button onclick="window.open('{{output.communication_url}}', '_blank', 'noreferrer')" class="btn btn-icon bg-primary text-white icon-no-margin btn-footer-communication" aria-label="{{#str}}communicationroomlink, course{{/str}}">
                    {{#pix}}t/messages-o, core{{/pix}}
                </button>
                {{/output.has_communication_links}}
                <button class="btn btn-icon bg-secondary icon-no-margin btn-footer-popover" data-action="footer-popover" aria-label="{{#str}}showfooter, theme_boost{{/str}}">
                    {{#pix}}e/question, core{{/pix}}
                </button>
            </div>
            <div class="footer-content-popover container" data-region="footer-content-popover">
                {{#output.has_communication_links}}
                <div class="footer-section p-3 border-bottom footer-link-communication">
                    <div class="footer-support-link">{{{ output.communication_link }}}</div>
                </div>
                {{/output.has_communication_links}}
                {{#output.has_popover_links}}
                <div class="footer-section p-3 border-bottom">
                    {{#output.page_doc_link}}<div class="footer-support-link">{{{ output.page_doc_link }}}</div>{{/output.page_doc_link}}
                    {{#output.services_support_link}}<div class="footer-support-link">{{{ output.services_support_link }}}</div>{{/output.services_support_link}}
                    {{#output.supportemail}}<div class="footer-support-link">{{{ output.supportemail }}}</div>{{/output.supportemail}}
                </div>
                {{/output.has_popover_links}}
                <div class="footer-section p-3 border-bottom">
                    <div class="logininfo">{{{ output.login_info }}}</div>
                    <div class="tool_usertours-resettourcontainer"></div>
                    {{{ output.standard_footer_html }}}
                    {{{ output.standard_end_of_body_html }}}
                </div>
                <div class="footer-section p-3">
                    <div>{{#str}}poweredbymoodle, core{{/str}}</div>
                    {{#output.moodle_release}}<div>{{#str}}version, core{{/str}} {{{ output.moodle_release }}}</div>{{/output.moodle_release}}
                </div>
            </div>
            <div class="footer-content-debugging footer-dark bg-dark text-light">
                <div class="container-fluid footer-dark-inner">
                    {{{ output.debug_footer_html }}}
                </div>
            </div>
        </div>
    </div>
    <p class="baitalgahwa-footer__copy text-center small py-3 mb-0">{{#str}}footercopyright, theme_baitalgahwa{{/str}}</p>
</footer>
{{#js}}
require(['theme_boost/footer-popover'], function(FooterPopover) { FooterPopover.init(); });
{{/js}}
