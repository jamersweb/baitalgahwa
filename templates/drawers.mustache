<script>
(function(){
function bagTx(id){var el=document.getElementById(id);return el?el.textContent.trim():'';}
function run(){
if(!document.body||document.body.id!=='page-enrol-index'){return;}
var main=document.getElementById('region-main');
var shell=document.getElementById('baitalgahwa-enrol-application-shell');
if(!main||!shell){return;}
var info=main.querySelector('.box.generalbox.info');
if(info&&info.parentNode){info.parentNode.insertBefore(shell,info.nextSibling);}
var form=shell.querySelector('form[data-bag-enrol-preview]');
if(!form){return;}
var okMsg=bagTx('bag-enrol-str-ok');
var reqMsg=bagTx('bag-enrol-str-req');
var emailMsg=bagTx('bag-enrol-str-email');
var statusEl=document.getElementById('bag-enrol-preview-status');
function clearErrors(){
form.querySelectorAll('.is-invalid').forEach(function(el){el.classList.remove('is-invalid');});
form.querySelectorAll('.invalid-feedback').forEach(function(el){el.textContent='';});
if(statusEl){statusEl.classList.add('d-none');statusEl.textContent='';}
}
function showErr(input,fbId,msg){
if(input){input.classList.add('is-invalid');}
var fb=document.getElementById(fbId);
if(fb){fb.textContent=msg;}
}
form.addEventListener('submit',function(e){
e.preventDefault();
clearErrors();
var fn=document.getElementById('bag-enrol-fullname');
var em=document.getElementById('bag-enrol-email');
var ok=true;
if(!fn||!fn.value.trim()){showErr(fn,'bag-enrol-fullname-feedback',reqMsg);ok=false;}
if(!em||!em.value.trim()){showErr(em,'bag-enrol-email-feedback',reqMsg);ok=false;}
else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em.value.trim())){showErr(em,'bag-enrol-email-feedback',emailMsg);ok=false;}
if(ok&&statusEl){statusEl.textContent=okMsg;statusEl.classList.remove('d-none');}
});
}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}
})();
</script>
