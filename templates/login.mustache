{{!
    @template theme_baitalgahwa/login
    LTR: form panel left, hero image right (~50/50). Mobile: narrow hero on top, then form.
}}
{{> theme_boost/head }}
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
body.pagelayout-login.theme {
    margin: 0;
    background: #fff;
}
.pagelayout-login #page,
.pagelayout-login #page-wrapper,
.pagelayout-login #region-main-box,
.pagelayout-login #region-main {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: none;
    border: 0;
    background: transparent;
}
.pagelayout-login .baitalgahwa-login-page {
    min-height: 100vh;
    font-family: Poppins, "Noto Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif !important;
    background: #fff;
}
.pagelayout-login .baitalgahwa-login-page * {
    font-family: inherit;
}
.pagelayout-login .baitalgahwa-login-end {
    display: none;
}
.pagelayout-login .baitalgahwa-login {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    overflow: hidden;
    background: #fff;
}
.pagelayout-login .baitalgahwa-login__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 6vw, 5.5rem);
}
.pagelayout-login .baitalgahwa-login__card {
    width: 100%;
    max-width: 23.5rem;
    border: 0;
    border-radius: 0;
    box-shadow: none !important;
    background: #fff;
}
.pagelayout-login .baitalgahwa-login__visual {
    position: relative;
    min-height: 100vh;
    background-color: #6b4423;
    background-size: cover;
    background-position: 68% center;
    display: flex !important;
    align-items: stretch !important;
}
.pagelayout-login .baitalgahwa-login__visual--mobile {
    min-height: 11rem;
    background-color: #6b4423;
    background-size: cover;
    background-position: center;
}
.pagelayout-login .baitalgahwa-login__visual-scrim {
    position: absolute;
    inset: 0;
    background: rgba(117, 72, 35, 0.34);
}
.pagelayout-login .baitalgahwa-login__visual-inner {
    position: relative;
    z-index: 1;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 24rem;
    padding: clamp(2rem, 4vw, 4.5rem);
}
.pagelayout-login .baitalgahwa-login__logo {
    max-width: 9rem;
    height: auto;
}
.pagelayout-login .baitalgahwa-login__logo-sub {
    margin-top: -0.15rem;
    margin-bottom: 0.95rem;
    font-size: 0.44rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #8d7b6a;
}
.pagelayout-login .baitalgahwa-auth-header {
    margin-bottom: 2rem !important;
}
.pagelayout-login .baitalgahwa-auth-title {
    color: #1f1f1f;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
}
.pagelayout-login .baitalgahwa-auth-sub {
    max-width: 19rem;
    margin-inline: auto;
    color: #757575 !important;
    font-size: 0.1rem;
    line-height: 1.6;
}
.pagelayout-login .baitalgahwa-auth-link {
    color: #7a4a25;
    font-weight: 600;
}
.pagelayout-login .baitalgahwa-login__form,
.pagelayout-login .baitalgahwa-login__form .loginform,
.pagelayout-login .baitalgahwa-login__form .login-form,
.pagelayout-login .baitalgahwa-login__form form {
    width: 100%;
}
.pagelayout-login .baitalgahwa-login__form .login-logo,
.pagelayout-login .baitalgahwa-login__form .baitalgahwa-core-loginform__logintitle,
.pagelayout-login .baitalgahwa-login__form .login-maintenance,
.pagelayout-login .baitalgahwa-login__form .login-instructions,
.pagelayout-login .baitalgahwa-login__form .login-divider.my-3 + .login-instructions,
.pagelayout-login .baitalgahwa-login__form .login-divider.my-3 + h2.login-heading {
    display: none !important;
}
.pagelayout-login .baitalgahwa-core-loginform .login-form-username,
.pagelayout-login .baitalgahwa-core-loginform .login-form-password,
.pagelayout-login .baitalgahwa-core-loginform .login-form-submit,
.pagelayout-login .baitalgahwa-core-loginform .login-form-forgotpassword {
    margin-bottom: 1rem !important;
}
.pagelayout-login .baitalgahwa-input {
    min-height: 2.75rem;
    padding: 0.72rem 0.95rem;
    border: 1px solid rgba(29, 29, 29, 0.35);
    border-radius: 0.28rem;
    box-shadow: none;
    font-size: 0.8rem;
    line-height: 1.35;
}
.pagelayout-login .baitalgahwa-input::placeholder {
    color: #6d6d6d;
    opacity: 1;
}
.pagelayout-login .baitalgahwa-password-wrap {
    position: relative;
}
.pagelayout-login .baitalgahwa-input--password {
    padding-right: 2.9rem;
}
.pagelayout-login .baitalgahwa-password-toggle {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #8d8d8d;
    cursor: pointer;
}
.pagelayout-login .baitalgahwa-password-toggle__icon {
    width: 1rem;
    height: 1rem;
}
.pagelayout-login .baitalgahwa-password-toggle__icon--eyeoff {
    display: none;
}
.pagelayout-login .baitalgahwa-password-toggle.is-visible .baitalgahwa-password-toggle__icon--eye {
    display: none;
}
.pagelayout-login .baitalgahwa-password-toggle.is-visible .baitalgahwa-password-toggle__icon--eyeoff {
    display: block;
}
.pagelayout-login .baitalgahwa-field-label {
    margin-bottom: 0.45rem !important;
    font-size: 0.9rem;
    font-weight: 400;
    color: #6a6a6a !important;
}
.pagelayout-login .baitalgahwa-login-subcta {
    margin-top: 0.85rem;
    font-size: 0.84rem;
    color: #8b8b8b !important;
}
.pagelayout-login .baitalgahwa-login-subcta a {
    margin-left: 0.2rem;
}
.pagelayout-login .baitalgahwa-login-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
    color: #9b9b9b;
}
.pagelayout-login .baitalgahwa-login-divider__line {
    flex: 1 1 auto;
    height: 1px;
    background: rgba(17, 24, 39, 0.14);
}
.pagelayout-login .baitalgahwa-login-divider__text {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
}
.pagelayout-login .baitalgahwa-idp-round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: #fff;
    border: 0;
    box-shadow: none;
}
.pagelayout-login .baitalgahwa-social-svg {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
}
.pagelayout-login .baitalgahwa-signup-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
}
.pagelayout-login .baitalgahwa-signup-sectionlabel {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2f241c;
}
.pagelayout-login .baitalgahwa-signup-merged {
    margin-bottom: 1.5rem;
}
.pagelayout-login .baitalgahwa-signup-merged .fitemtitle,
.pagelayout-login .baitalgahwa-signup-merged > label {
    display: none !important;
}
.pagelayout-login .baitalgahwa-signup-hiddenconfirm {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}
.pagelayout-login .baitalgahwa-login-submit.btn-primary,
.pagelayout-login #loginbtn {
    width: 100%;
    min-height: 2.75rem;
    border-color: #5d3e21;
    background: #5d3e21;
    border-radius: 0.3rem;
    font-size: 0.84rem;
    font-weight: 500;
    box-shadow: none !important;
}
.pagelayout-login .baitalgahwa-login__visual-title {
    max-width: 20rem;
    font-size: clamp(2.5rem, 4.5vw, 3.85rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0.01em;
}
.pagelayout-login .baitalgahwa-login__visual-text {
    max-width: 18rem;
    font-size: 0.84rem;
    line-height: 1.55;
}
.pagelayout-login .baitalgahwa-idps--static {
    gap: 0.8rem;
}
.pagelayout-login .baitalgahwa-idp-round--static {
    pointer-events: none;
}
.pagelayout-login .baitalgahwa-login__form .login-form-forgotpassword,
.pagelayout-login .baitalgahwa-login__form .login-divider.my-3,
.pagelayout-login .baitalgahwa-login__form .login-instructions,
.pagelayout-login .baitalgahwa-login__form #guestlogin,
.pagelayout-login .baitalgahwa-login__form h2.h6.text-muted,
.pagelayout-login .baitalgahwa-login-meta,
.pagelayout-login .login-languagemenu,
.pagelayout-login .divider.border-start,
.pagelayout-login [data-region="maintenance"],
.pagelayout-login .login-maintenance {
    display: none !important;
}
.pagelayout-login .baitalgahwa-login__form .alert {
    margin-bottom: 1rem;
    font-size: 0.78rem;
}
@media (max-width: 991.98px) {
    .pagelayout-login .baitalgahwa-login {
        grid-template-columns: 1fr;
    }
    .pagelayout-login .baitalgahwa-login__visual {
        display: none !important;
    }
    .pagelayout-login .baitalgahwa-login__card {
        max-width: 100%;
    }
    .pagelayout-login .baitalgahwa-signup-grid {
        grid-template-columns: 1fr;
        gap: 0;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div class="baitalgahwa-login-page" id="page">
    {{{ output.standard_top_of_body_html }}}
    <div class="baitalgahwa-login">
        <div class="baitalgahwa-login__visual--mobile d-lg-none w-100" {{#heroimageurl}}style="background-image: url('{{{ heroimageurl }}}');"{{/heroimageurl}}>
            <div class="baitalgahwa-login__visual-scrim" aria-hidden="true"></div>
        </div>
        <div class="baitalgahwa-login__panel">
            <div class="baitalgahwa-login__card border-0 shadow-sm">
                <div class="card-body p-4 px-xl-5 py-xl-4">
                    <div class="baitalgahwa-auth-header text-center mb-4">
                        {{#themelogourl}}
                        <img class="baitalgahwa-login__logo mb-3" src="{{{ themelogourl }}}" alt="{{ sitename }}" width="200" height="56" loading="eager" decoding="async">
                        <div class="baitalgahwa-login__logo-sub">Bait Al Qahwa</div>
                        {{/themelogourl}}
                        {{^themelogourl}}
                        <h1 class="h3 mb-1 baitalgahwa-auth-typed">{{ sitename }}</h1>
                        <div class="baitalgahwa-login__logo-sub">Bait Al Qahwa</div>
                        {{/themelogourl}}

                        {{#is_signup_page}}
                        <h2 class="baitalgahwa-auth-title mb-2">{{#str}} authpanel_signup_title, theme_baitalgahwa {{/str}}</h2>
                        <p class="baitalgahwa-auth-sub text-muted small mb-0 px-sm-1">{{#str}} authpanel_signup_sub, theme_baitalgahwa {{/str}}</p>
                        <p class="text-muted small mt-2 mb-0">
                            {{#str}} authpanel_already, theme_baitalgahwa {{/str}}
                            <a class="baitalgahwa-auth-link" href="{{{ loginindexurl }}}">{{#str}} login {{/str}}</a>
                        </p>
                        {{/is_signup_page}}
                        {{^is_signup_page}}
                        <h2 class="baitalgahwa-auth-title mb-2">{{#str}} authpanel_welcome, theme_baitalgahwa {{/str}}</h2>
                        <p class="baitalgahwa-auth-sub text-muted small mb-0 px-sm-1">Kindly fill in your details below to create an account</p>
                        {{/is_signup_page}}
                    </div>
                    <div class="baitalgahwa-login__form">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>
        </div>
        <div class="baitalgahwa-login__visual d-none d-lg-flex" {{#heroimageurl}}style="background-image: url('{{{ heroimageurl }}}');"{{/heroimageurl}}>
            <div class="baitalgahwa-login__visual-scrim" aria-hidden="true"></div>
            <div class="baitalgahwa-login__visual-inner p-5 text-white position-relative">
                <h2 class="baitalgahwa-login__visual-title text-uppercase mb-3">{{ herotitle }}</h2>
                <p class="baitalgahwa-login__visual-text lead mb-0">{{ herosubtitle }}</p>
            </div>
        </div>
    </div>
</div>
<div class="baitalgahwa-login-end">
    {{{ output.standard_footer_html }}}
    {{{ output.standard_end_of_body_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_baitalgahwa/theme'], function(Loader, Bait) {
    Bait.init();
    M.util.js_complete('theme_boost/loader');
});
(function() {
    var isSignup = {{#is_signup_page}}true{{/is_signup_page}}{{^is_signup_page}}false{{/is_signup_page}};
    var findRow = function(input) {
        if (!input) {
            return null;
        }
        return input.closest('.fitem') || input.closest('.form-group') || input.closest('[data-fieldtype]') || input.parentElement;
    };

    var socialIconsMarkup = '' +
        '<div class="baitalgahwa-login-divider" role="separator" aria-hidden="true">' +
            '<span class="baitalgahwa-login-divider__line"></span>' +
            '<span class="baitalgahwa-login-divider__text">Or</span>' +
            '<span class="baitalgahwa-login-divider__line"></span>' +
        '</div>' +
        '<div class="baitalgahwa-idps baitalgahwa-idps--circular baitalgahwa-idps--static d-flex flex-wrap align-items-center justify-content-center" role="group" aria-label="Social links">' +
            '<span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Google">' +
                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path fill="#EA4335" d="M12 10.2v3.9h5.42c-.23 1.26-.95 2.32-2.03 3.04l3.29 2.55c1.92-1.77 3.02-4.38 3.02-7.48 0-.71-.06-1.4-.18-2.06H12z"/>' +
                    '<path fill="#34A853" d="M12 22c2.73 0 5.02-.91 6.69-2.47l-3.29-2.55c-.91.61-2.08.97-3.4.97-2.62 0-4.84-1.77-5.64-4.14H3.96v2.63A10.1 10.1 0 0 0 12 22z"/>' +
                    '<path fill="#4A90E2" d="M6.36 13.81A6.08 6.08 0 0 1 6.05 12c0-.63.11-1.24.31-1.81V7.56H3.96A10.03 10.03 0 0 0 2 12c0 1.62.39 3.15 1.08 4.44l3.28-2.63z"/>' +
                    '<path fill="#FBBC05" d="M12 6.05c1.48 0 2.8.51 3.84 1.51l2.88-2.88C17 3.09 14.71 2 12 2a10.1 10.1 0 0 0-8.04 5.56l3.4 2.63C7.16 7.82 9.38 6.05 12 6.05z"/>' +
                '</svg>' +
            '</span>' +
            '<span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Apple">' +
                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path fill="#111111" d="M16.37 12.66c.03 2.85 2.5 3.8 2.53 3.82-.02.07-.39 1.33-1.27 2.63-.77 1.13-1.56 2.26-2.81 2.28-1.23.02-1.63-.73-3.04-.73s-1.85.71-3.02.75c-1.2.05-2.12-1.2-2.9-2.33C4.25 16.72 3 12.48 4.67 9.6c.83-1.43 2.31-2.33 3.92-2.35 1.22-.02 2.38.82 3.04.82.65 0 2.03-.99 3.42-.84.58.02 2.23.23 3.29 1.79-.08.05-1.96 1.14-1.97 3.64zM14.05 5.76c.64-.77 1.08-1.84.96-2.91-.93.04-2.05.62-2.72 1.39-.6.69-1.12 1.79-.98 2.84 1.04.08 2.1-.53 2.74-1.32z"/>' +
                '</svg>' +
            '</span>' +
            '<span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Facebook">' +
                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.91v-8.42H7.08v-3.49h3.05V9.41c0-3.03 1.8-4.7 4.56-4.7 1.32 0 2.7.24 2.7.24v2.98h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.34l-.53 3.49h-2.81v8.42C19.61 23.08 24 18.09 24 12.07z"/>' +
                '</svg>' +
            '</span>' +
            '<span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Twitter">' +
                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path fill="#1DA1F2" d="M23 4.58a9.4 9.4 0 0 1-2.7.76 4.72 4.72 0 0 0 2.07-2.6 9.28 9.28 0 0 1-2.99 1.16A4.66 4.66 0 0 0 16 2.5c-2.61 0-4.72 2.14-4.72 4.78 0 .37.04.74.12 1.09-3.92-.2-7.39-2.1-9.72-4.98a4.82 4.82 0 0 0-.64 2.4c0 1.66.83 3.12 2.09 3.98a4.63 4.63 0 0 1-2.14-.6v.06c0 2.32 1.63 4.25 3.8 4.69a4.56 4.56 0 0 1-2.13.08 4.71 4.71 0 0 0 4.4 3.28A9.35 9.35 0 0 1 1 19.32 13.18 13.18 0 0 0 8.23 21.5c8.67 0 13.41-7.28 13.41-13.6 0-.2 0-.41-.01-.61A9.68 9.68 0 0 0 23 4.58z"/>' +
                '</svg>' +
            '</span>' +
        '</div>';

    var bindPasswordToggle = function() {
        var toggle = document.querySelector('[data-password-toggle]');
        if (!toggle || toggle.dataset.bound === '1') {
            return;
        }
        var targetId = toggle.getAttribute('data-target');
        var input = targetId ? document.getElementById(targetId) : null;
        if (!input) {
            return;
        }
        toggle.addEventListener('click', function() {
            var visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            toggle.classList.toggle('is-visible', !visible);
            toggle.setAttribute('aria-pressed', visible ? 'false' : 'true');
            toggle.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
        });
        toggle.dataset.bound = '1';
    };

    var applyLoginEnhancements = function() {
        var username = document.getElementById('username');
        var password = document.getElementById('password');
        var loginButton = document.getElementById('loginbtn');
        var forgot = document.querySelector('.login-form-forgotpassword');
        var guestTitle = document.querySelector('h2.h6.text-muted');
        var guestForm = document.getElementById('guestlogin');
        var meta = document.querySelector('.baitalgahwa-login-meta');
        var authSub = document.querySelector('.baitalgahwa-auth-sub');
        var form = document.getElementById('login');
        var subCta = document.querySelector('.baitalgahwa-login-subcta');

        if (authSub) {
            authSub.textContent = 'Kindly fill in your details below to create an account';
        }

        if (username) {
            username.placeholder = 'Daphne Smith';
            var usernameLabel = document.querySelector('label[for="username"]');
            if (usernameLabel) {
                usernameLabel.textContent = 'Email Address';
            }
        }

        if (password) {
            password.placeholder = '**************';
            var passwordLabel = document.querySelector('label[for="password"]');
            if (passwordLabel) {
                passwordLabel.textContent = 'Password';
            }
        }
        bindPasswordToggle();

        if (loginButton) {
            loginButton.textContent = 'Register with us';
        }

        if (forgot) {
            forgot.style.display = 'none';
        }
        if (guestTitle) {
            guestTitle.style.display = 'none';
        }
        if (guestForm) {
            guestForm.style.display = 'none';
        }
        if (meta) {
            meta.style.display = 'none';
        }

        if (form && !document.querySelector('.baitalgahwa-idps--static')) {
            var wrap = document.createElement('div');
            wrap.innerHTML = socialIconsMarkup;
            if (subCta) {
                subCta.insertAdjacentElement('afterend', wrap.firstChild);
                subCta.insertAdjacentElement('afterend', wrap.firstChild);
            } else {
                form.insertAdjacentElement('afterend', wrap.firstChild);
                form.insertAdjacentElement('afterend', wrap.firstChild);
            }
        }
    };

    var applySignupEnhancements = function() {
        var email = document.getElementById('id_email');
        var email2 = document.getElementById('id_email2');
        var firstname = document.getElementById('id_firstname');
        var lastname = document.getElementById('id_lastname');

        if (email && email2) {
            if (!email.dataset.baitSyncBound) {
                var syncEmail = function() {
                    email2.value = email.value;
                };
                email.addEventListener('input', syncEmail);
                email.addEventListener('change', syncEmail);
                email.dataset.baitSyncBound = '1';
                syncEmail();
            }
            if (!email.placeholder) {
                email.placeholder = 'Enter your email address';
            }
            var email2row = findRow(email2);
            if (email2row) {
                email2row.classList.add('baitalgahwa-signup-hiddenconfirm');
            }
        }

        if (firstname && lastname) {
            if (!firstname.placeholder) {
                firstname.placeholder = 'First name';
            }
            if (!lastname.placeholder) {
                lastname.placeholder = 'Last name';
            }
            var firstrow = findRow(firstname);
            var lastrow = findRow(lastname);
            if (firstrow && lastrow && (!firstrow.parentElement || !firstrow.parentElement.classList.contains('baitalgahwa-signup-grid'))) {
                var wrap = document.createElement('div');
                wrap.className = 'baitalgahwa-signup-merged';
                var label = document.createElement('p');
                label.className = 'baitalgahwa-signup-sectionlabel';
                label.textContent = 'Full name';
                var grid = document.createElement('div');
                grid.className = 'baitalgahwa-signup-grid';
                firstrow.parentNode.insertBefore(wrap, firstrow);
                wrap.appendChild(label);
                wrap.appendChild(grid);
                grid.appendChild(firstrow);
                grid.appendChild(lastrow);
            }
        }
        bindPasswordToggle();
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            if (isSignup) {
                applySignupEnhancements();
            } else {
                applyLoginEnhancements();
            }
        });
    } else {
        if (isSignup) {
            applySignupEnhancements();
        } else {
            applyLoginEnhancements();
        }
    }
})();
{{/js}}
