                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24"><path fill="currentColor" d="M23 4.58a9.4 9.4 0 0 1-2.7.76 4.72 4.72 0 0 0 2.07-2.6 9.28 9.28 0 0 1-2.99 1.16A4.66 4.66 0 0 0 16 2.5c-2.61 0-4.72 2.14-4.72 4.78 0 .37.04.74.12 1.09-3.92-.2-7.39-2.1-9.72-4.98a4.82 4.82 0 0 0-.64 2.4c0 1.66.83 3.12 2.09 3.98a4.63 4.63 0 0 1-2.14-.6v.06c0 2.32 1.63 4.25 3.8 4.69a4.56 4.56 0 0 1-2.13.08 4.71 4.71 0 0 0 4.4 3.28A9.35 9.35 0 0 1 1 19.32 13.18 13.18 0 0 0 8.23 21.5c8.67 0 13.41-7.28 13.41-13.6 0-.2 0-.41-.01-.61A9.68 9.68 0 0 0 23 4.58z"/></svg>' +
            '</span>' +
            '<span class="baitalgahwa-idp-round baitalgahwa-idp-round--static">' +
                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24"><path fill="currentColor" d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm-.19 1.8A3.76 3.76 0 0 0 3.8 7.56v8.88a3.76 3.76 0 0 0 3.76 3.76h8.88a3.76 3.76 0 0 0 3.76-3.76V7.56a3.76 3.76 0 0 0-3.76-3.76H7.56zm9.54 1.35a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zM12 6.85A5.15 5.15 0 1 1 6.85 12 5.15 5.15 0 0 1 12 6.85zm0 1.8A3.35 3.35 0 1 0 15.35 12 3.35 3.35 0 0 0 12 8.65z"/></svg>' +
            '</span>' +
            '<span class="baitalgahwa-idp-round baitalgahwa-idp-round--static">' +
                '<svg class="baitalgahwa-social-svg" viewBox="0 0 24 24"><path fill="currentColor" d="M6.94 8.5H3.56V20h3.38V8.5zm.22-3.56A1.96 1.96 0 0 0 5.22 3a1.95 1.95 0 1 0-.06 3.9h.02a1.96 1.96 0 0 0 1.98-1.96zM20 20h-3.38v-5.86c0-1.47-.52-2.47-1.84-2.47-1 0-1.59.67-1.85 1.32-.1.23-.12.55-.12.87V20H9.43s.05-10.02 0-11.5h3.38v1.63c.45-.69 1.26-1.67 3.06-1.67 2.23 0 3.91 1.46 3.91 4.6V20z"/></svg>' +
            '</span>' +
        '</div>';

    var setupPasswordToggleDelegation = function() {
        if (document.body.dataset.passwordToggleBound === '1') {
            return;
        }
        document.addEventListener('click', function(event) {
            var toggle = event.target.closest('[data-password-toggle]');
            if (!toggle) {
                return;
            }
            event.preventDefault();
            var targetId = toggle.getAttribute('data-target');
            var input = targetId ? document.getElementById(targetId) : null;
            if (!input) {
                return;
            }
            var visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            toggle.classList.toggle('is-visible', !visible);
            toggle.setAttribute('aria-pressed', visible ? 'false' : 'true');
            toggle.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
        });
        document.body.dataset.passwordToggleBound = '1';
    };

    var forEachNode = function(nodeList, callback) {
        Array.prototype.forEach.call(nodeList || [], callback);
    };

    var createPasswordToggleButton = function(targetId) {
        var toggle = document.createElement('button');
        toggle.className = 'baitalgahwa-password-toggle';
        toggle.type = 'button';
        toggle.setAttribute('aria-label', 'Show password');
        toggle.setAttribute('aria-pressed', 'false');
        toggle.setAttribute('data-password-toggle', '');
        toggle.setAttribute('data-target', targetId);
        toggle.innerHTML = '' +
            '<svg class="baitalgahwa-password-toggle__icon baitalgahwa-password-toggle__icon--eye" viewBox="0 0 24 24" aria-hidden="true">' +
                '<path fill="currentColor" d="M12 5C6.5 5 2.08 8.44.25 12c1.83 3.56 6.25 7 11.75 7s9.92-3.44 11.75-7C21.92 8.44 17.5 5 12 5zm0 11.2A4.2 4.2 0 1 1 12 7.8a4.2 4.2 0 0 1 0 8.4zm0-6.72A2.52 2.52 0 1 0 12 14.52a2.52 2.52 0 0 0 0-5.04z"/>' +
            '</svg>' +
            '<svg class="baitalgahwa-password-toggle__icon baitalgahwa-password-toggle__icon--eyeoff" viewBox="0 0 24 24" aria-hidden="true">' +
                '<path fill="currentColor" d="M2.1 3.51 1 4.61l3.09 3.08C2.51 8.82 1.16 10.31.25 12c1.83 3.56 6.25 7 11.75 7 2.2 0 4.25-.55 6.03-1.5l3.36 3.36 1.1-1.1Zm9.9 3.29c4.67 0 8.54 2.78 10.13 5.2-.67 1.02-1.67 2.09-2.9 3l-1.91-1.91A4.17 4.17 0 0 0 12.9 8.7l-1.46-1.46c.18-.02.37-.04.56-.04Zm-6.25 3.1 2.05 2.05a4.2 4.2 0 0 0 4.25 4.25l2.05 2.05c-.67.15-1.37.25-2.1.25-4.67 0-8.54-2.78-10.13-5.2.52-.8 1.18-1.61 1.88-2.35Zm3.21 3.21 2.93 2.93a2.52 2.52 0 0 1-2.93-2.93Zm4.15-.59 1.89 1.89a2.51 2.51 0 0 0-1.89-1.89Z"/>' +
            '</svg>';
        return toggle;
    };

    var wrapPasswordInput = function(input) {
        if (!input || !input.id || input.type !== 'password' || input.dataset.baitPasswordReady === '1') {
            return;
        }

        if (input.closest('.baitalgahwa-password-wrap')) {
            input.classList.add('baitalgahwa-input--password');
            input.dataset.baitPasswordReady = '1';
            return;
        }

        var wrapper = document.createElement('div');
        wrapper.className = 'baitalgahwa-password-wrap';
        input.parentNode.insertBefore(wrapper, input);
        wrapper.appendChild(input);
        input.classList.add('baitalgahwa-input--password');
        wrapper.appendChild(createPasswordToggleButton(input.id));
        input.dataset.baitPasswordReady = '1';
    };

    var isStrongPassword = function(value) {
        return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/.test(value || '');
    };

    var setRowVisibility = function(row, visible) {
        if (!row) {
            return;
        }
        row.style.display = visible ? '' : 'none';
    };

    var appendRowsInOrder = function(parent, rows, beforeNode) {
        if (!parent) {
            return;
        }
        rows.forEach(function(row) {
            if (!row || !parent.contains(row)) {
                return;
            }
            if (beforeNode && parent.contains(beforeNode)) {
                parent.insertBefore(row, beforeNode);
            } else {
                parent.appendChild(row);
            }
        });
    };

    var applyLoginEnhancements = function() {
        var username = document.getElementById('username');
        var password = document.getElementById('password');
        var loginButton = document.getElementById('loginbtn');
        var forgot = document.querySelector('.login-form-forgotpassword');
        var guestTitle = document.querySelector('h2.h6.text-muted');
        var guestForm = document.getElementById('guestlogin');
        var meta = document.querySelector('.baitalgahwa-login-meta');
        var authSub = document.querySelector('.baitalgahwa-auth-sub');
        var form = document.getElementById('login');
        var subCta = document.querySelector('.baitalgahwa-login-subcta');

        if (authSub) {
            authSub.textContent = 'Kindly fill in your details below to create an account';
        }

        if (username) {
            username.placeholder = 'Daphne Smith';
            var usernameLabel = document.querySelector('label[for="username"]');
            if (usernameLabel) {
                usernameLabel.textContent = 'Email Address';
            }
        }

        if (password) {
            password.placeholder = '**************';
            var passwordLabel = document.querySelector('label[for="password"]');
            if (passwordLabel) {
                passwordLabel.textContent = 'Password';
            }
        }
        setupPasswordToggleDelegation();

        if (loginButton) {
            loginButton.textContent = 'Register with us';
        }

        if (forgot) {
            forgot.style.display = 'none';
        }
        if (guestTitle) {
            guestTitle.style.display = 'none';
        }
        if (guestForm) {
            guestForm.style.display = 'none';
        }
        if (meta) {
            meta.style.display = 'none';
        }

        if (form && !document.querySelector('.baitalgahwa-idps--static')) {
            var wrap = document.createElement('div');
            wrap.innerHTML = socialIconsMarkup;
            if (subCta) {
                subCta.insertAdjacentElement('afterend', wrap.firstChild);
                subCta.insertAdjacentElement('afterend', wrap.firstChild);
            } else {
                form.insertAdjacentElement('afterend', wrap.firstChild);
                form.insertAdjacentElement('afterend', wrap.firstChild);
            }
        }
    };

    var applySignupEnhancements = function() {
        var signupForm = document.querySelector('.baitalgahwa-login__form form');
        var username = document.getElementById('id_username');
        var email = document.getElementById('id_email');
        var email2 = document.getElementById('id_email2');
        var firstname = document.getElementById('id_firstname');
        var lastname = document.getElementById('id_lastname');
        var password = document.querySelector('#id_password, #id_password1');
        var city = document.getElementById('id_city');
        var country = document.getElementById('id_country');
        var signupTitle = document.querySelector('.baitalgahwa-login__form > h2, .baitalgahwa-login__form .mform > h2');
        var emailRow = findRow(email);
        var firstnameRow = findRow(firstname);
        var lastnameRow = findRow(lastname);
        var passwordRow = findRow(password);
        var submitButton = signupForm ? signupForm.querySelector('button[type="submit"], input[type="submit"]') : null;
        var submitRow = findRow(submitButton);
        var socialIcons = signupForm ? signupForm.querySelector('.baitalgahwa-signup-socialicons') : null;

        if (signupForm) {
            signupForm.classList.add('baitalgahwa-signup-form');
            if (!signupForm.querySelector('.baitalgahwa-signup-social')) {
                signupForm.insertAdjacentHTML('afterbegin', signupGoogleMarkup);
            }
            forEachNode(signupForm.querySelectorAll('input, select, textarea'), function(field) {
                var type = (field.getAttribute('type') || '').toLowerCase();
                if (!type || ['text', 'password', 'email', 'tel', 'search', 'url'].indexOf(type) !== -1) {
                    field.classList.add('form-control', 'baitalgahwa-input');
                }
                if (type === 'password') {
                    wrapPasswordInput(field);
                }
            });
            forEachNode(signupForm.querySelectorAll('button[type="submit"], input[type="submit"]'), function(button) {
                button.classList.add('btn', 'btn-primary', 'baitalgahwa-login-submit');
            });
            if (!signupForm.querySelector('.baitalgahwa-signup-socialicons')) {
                signupForm.insertAdjacentHTML('beforeend', signupBottomIconsMarkup);
            }
        }

        if (signupTitle) {
            signupTitle.style.display = 'none';
        }

        forEachNode(document.querySelectorAll('.baitalgahwa-login__form h2, .baitalgahwa-login__form legend'), function(node) {
            if (node && /new account/i.test((node.textContent || '').trim())) {
                node.style.display = 'none';
            }
        });

        if (username && email) {
            var usernameRow = findRow(username);
            var syncUsername = function() {
                username.value = email.value.trim();
            };
            if (!email.dataset.baitUsernameBound) {
                email.addEventListener('input', syncUsername);
                email.addEventListener('change', syncUsername);
                email.dataset.baitUsernameBound = '1';
            }
            syncUsername();
            if (usernameRow) {
                usernameRow.style.display = 'none';
            }
        }

        if (email && email2) {
            if (!email.dataset.baitSyncBound) {
                var syncEmail = function() {
                    email2.value = email.value;
                    if (username) {
                        username.value = email.value.trim();
                    }
                };
                email.addEventListener('input', syncEmail);
                email.addEventListener('change', syncEmail);
                email.dataset.baitSyncBound = '1';
                syncEmail();
            }
            if (!email.placeholder) {
                email.placeholder = 'Enter your email address';
            }
            var email2row = findRow(email2);
            if (email2row) {
                email2row.classList.add('baitalgahwa-signup-hiddenconfirm');
            }
        }

        if (city) {
            var cityRow = findRow(city);
            setRowVisibility(cityRow, false);
        }

        if (country) {
            var countryRow = findRow(country);
            setRowVisibility(countryRow, false);
        }

        if (password) {
            if (passwordRow) {
                var passwordHelp = passwordRow.querySelector('.form-control-feedback, .form-text, .hint, .text-muted');
                if (!passwordHelp && signupForm) {
                    forEachNode(signupForm.querySelectorAll('div, p, span, small'), function(node) {
                        if (!passwordHelp && /The password must have/i.test((node.textContent || '').trim())) {
                            passwordHelp = node;
                        }
                    });
                }
                if (passwordHelp) {
                    passwordHelp.classList.add('baitalgahwa-password-hint');

                    var syncPasswordHint = function(forceShow) {
                        var value = password.value || '';
                        var shouldShow = false;

                        if (value.length > 0) {
                            shouldShow = !isStrongPassword(value);
                        } else if (forceShow) {
                            shouldShow = true;
                        }

                        if (password.classList.contains('is-invalid') || password.getAttribute('aria-invalid') === 'true') {
                            shouldShow = true;
                        }

                        passwordHelp.classList.toggle('is-visible', shouldShow);
                    };

                    if (!password.dataset.baitHintBound) {
                        password.addEventListener('input', function() {
                            syncPasswordHint(false);
                        });
                        password.addEventListener('blur', function() {
                            syncPasswordHint((password.value || '').length > 0);
                        });
                        if (signupForm) {
                            signupForm.addEventListener('submit', function() {
                                syncPasswordHint(true);
                            });
                        }
                        password.dataset.baitHintBound = '1';
                    }

                    syncPasswordHint(false);
                }
            }
        }

        if (firstname && lastname) {
            if (!firstname.placeholder) {
                firstname.placeholder = 'Enter your full name';
            }

            var firstnameLabel = signupForm ? signupForm.querySelector('label[for="' + firstname.id + '"]') : null;
            if (firstnameLabel) {
                firstnameLabel.textContent = 'Full Name';
            }

            if (!firstname.dataset.baitLastnameBound) {
                var syncLastname = function() {
                    lastname.value = firstname.value.trim();
                };
                firstname.addEventListener('input', syncLastname);
                firstname.addEventListener('change', syncLastname);
                firstname.dataset.baitLastnameBound = '1';
                syncLastname();
            }

            setRowVisibility(lastnameRow, false);
        }

        [
            ['id_email', 'Enter your email address'],
            ['id_firstname', 'Enter your full name'],
            ['id_password', 'Create your password'],
            ['id_password1', 'Create your password']
        ].forEach(function(config) {
            var field = document.getElementById(config[0]);
            if (field && !field.placeholder) {
                field.placeholder = config[1];
            }
        });

        forEachNode(signupForm ? signupForm.querySelectorAll('button[type="submit"], input[type="submit"]') : [], function(button) {
            if (button) {
                button.textContent = 'Create an account';
                if (button.value !== undefined) {
                    button.value = 'Create an account';
                }
            }
        });

        appendRowsInOrder(signupForm, [emailRow, firstnameRow, passwordRow, submitRow], socialIcons);

        setupPasswordToggleDelegation();
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            if (isSignup) {
                applySignupEnhancements();
            } else {
                applyLoginEnhancements();
            }
        });
    } else {
        if (isSignup) {
            applySignupEnhancements();
        } else {
            applyLoginEnhancements();
        }
    }
})();
{{/js}}
