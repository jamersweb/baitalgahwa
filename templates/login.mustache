{{!
    @template theme_baitalgahwa/login
    LTR: form panel left, hero image right (~50/50). Mobile: narrow hero on top, then form.
}}
{{> theme_boost/head }}
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
body.pagelayout-login.theme {
    margin: 0;
    background: #fff;
}
.pagelayout-login #page,
.pagelayout-login #page-wrapper,
.pagelayout-login #region-main-box,
.pagelayout-login #region-main {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: none;
    border: 0;
    background: transparent;
}
.pagelayout-login .baitalgahwa-login-page {
    min-height: 100vh;
    font-family: Inter, "Noto Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif;
    background: #fff;
}
.pagelayout-login .baitalgahwa-login {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    overflow: hidden;
    background: #fff;
}
.pagelayout-login .baitalgahwa-login__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 4vw, 4rem);
}
.pagelayout-login .baitalgahwa-login__card {
    width: 100%;
    max-width: 34rem;
    border: 0;
    border-radius: 0;
    box-shadow: none !important;
    background: #fff;
}
.pagelayout-login .baitalgahwa-login__visual {
    position: relative;
    min-height: 100vh;
    background-color: #6b4423;
    background-size: cover;
    background-position: center;
    display: flex !important;
    align-items: stretch !important;
}
.pagelayout-login .baitalgahwa-login__visual--mobile {
    min-height: 11rem;
    background-color: #6b4423;
    background-size: cover;
    background-position: center;
}
.pagelayout-login .baitalgahwa-login__visual-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(0, 0, 0, 0.5) 0%, rgba(107, 68, 35, 0.35) 45%, rgba(0, 0, 0, 0.25) 100%);
}
.pagelayout-login .baitalgahwa-login__visual-inner {
    position: relative;
    z-index: 1;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 34rem;
    padding: clamp(2rem, 5vw, 4rem);
}
.pagelayout-login .baitalgahwa-login__logo {
    max-width: 12.5rem;
    height: auto;
}
.pagelayout-login .baitalgahwa-login__form,
.pagelayout-login .baitalgahwa-login__form .loginform,
.pagelayout-login .baitalgahwa-login__form .login-form,
.pagelayout-login .baitalgahwa-login__form form {
    width: 100%;
}
.pagelayout-login .baitalgahwa-login__form .login-logo,
.pagelayout-login .baitalgahwa-login__form .baitalgahwa-core-loginform__logintitle,
.pagelayout-login .baitalgahwa-login__form .login-maintenance,
.pagelayout-login .baitalgahwa-login__form .login-instructions,
.pagelayout-login .baitalgahwa-login__form .login-divider.my-3 + .login-instructions,
.pagelayout-login .baitalgahwa-login__form .login-divider.my-3 + h2.login-heading {
    display: none !important;
}
.pagelayout-login .baitalgahwa-core-loginform .login-form-username,
.pagelayout-login .baitalgahwa-core-loginform .login-form-password,
.pagelayout-login .baitalgahwa-core-loginform .login-form-submit,
.pagelayout-login .baitalgahwa-core-loginform .login-form-forgotpassword {
    margin-bottom: 1.5rem !important;
}
.pagelayout-login .baitalgahwa-input {
    min-height: 5rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(17, 24, 39, 0.2);
    border-radius: 0.5rem;
    box-shadow: none;
    font-size: 1rem;
}
.pagelayout-login .baitalgahwa-field-label {
    margin-bottom: 0.75rem !important;
    font-size: 0.95rem;
    font-weight: 500;
}
.pagelayout-login .baitalgahwa-signup-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
}
.pagelayout-login .baitalgahwa-signup-sectionlabel {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2f241c;
}
.pagelayout-login .baitalgahwa-signup-merged {
    margin-bottom: 1.5rem;
}
.pagelayout-login .baitalgahwa-signup-merged .fitemtitle,
.pagelayout-login .baitalgahwa-signup-merged > label {
    display: none !important;
}
.pagelayout-login .baitalgahwa-signup-hiddenconfirm {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}
.pagelayout-login .baitalgahwa-login-submit.btn-primary,
.pagelayout-login #loginbtn {
    width: 100%;
    min-height: 4.5rem;
    border-color: #5d3e21;
    background: #5d3e21;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
}
.pagelayout-login .baitalgahwa-login__visual-title {
    font-size: clamp(2.75rem, 4.6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.02em;
}
.pagelayout-login .baitalgahwa-login__visual-text {
    max-width: 30rem;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.5;
}
@media (max-width: 991.98px) {
    .pagelayout-login .baitalgahwa-login {
        grid-template-columns: 1fr;
    }
    .pagelayout-login .baitalgahwa-login__visual {
        display: none !important;
    }
    .pagelayout-login .baitalgahwa-login__card {
        max-width: 100%;
    }
    .pagelayout-login .baitalgahwa-signup-grid {
        grid-template-columns: 1fr;
        gap: 0;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div class="baitalgahwa-login-page" id="page">
    {{{ output.standard_top_of_body_html }}}
    <div class="baitalgahwa-login">
        <div class="baitalgahwa-login__visual--mobile d-lg-none w-100" {{#heroimageurl}}style="background-image: url('{{{ heroimageurl }}}');"{{/heroimageurl}}>
            <div class="baitalgahwa-login__visual-scrim" aria-hidden="true"></div>
        </div>
        <div class="baitalgahwa-login__panel">
            <div class="baitalgahwa-login__card border-0 shadow-sm">
                <div class="card-body p-4 p-xl-5">
                    <div class="baitalgahwa-auth-header text-center mb-4">
                        {{#themelogourl}}
                        <img class="baitalgahwa-login__logo mb-3" src="{{{ themelogourl }}}" alt="{{ sitename }}" width="200" height="56" loading="eager" decoding="async">
                        {{/themelogourl}}
                        {{^themelogourl}}
                        <h1 class="h3 mb-1 baitalgahwa-auth-typed">{{ sitename }}</h1>
                        {{/themelogourl}}

                        {{#is_signup_page}}
                        <h2 class="baitalgahwa-auth-title mb-2">{{#str}} authpanel_signup_title, theme_baitalgahwa {{/str}}</h2>
                        <p class="baitalgahwa-auth-sub text-muted small mb-0 px-sm-1">{{#str}} authpanel_signup_sub, theme_baitalgahwa {{/str}}</p>
                        <p class="text-muted small mt-2 mb-0">
                            {{#str}} authpanel_already, theme_baitalgahwa {{/str}}
                            <a class="baitalgahwa-auth-link" href="{{{ loginindexurl }}}">{{#str}} login {{/str}}</a>
                        </p>
                        {{/is_signup_page}}
                        {{^is_signup_page}}
                        <h2 class="baitalgahwa-auth-title mb-2">{{#str}} authpanel_welcome, theme_baitalgahwa {{/str}}</h2>
                        <p class="baitalgahwa-auth-sub text-muted small mb-0 px-sm-1">{{#str}} authpanel_login_sub, theme_baitalgahwa {{/str}}</p>
                        {{/is_signup_page}}
                    </div>
                    <div class="baitalgahwa-login__form">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>
            <div class="baitalgahwa-login__footer-links text-center small mt-3">
                <a href="{{{ config.homeurl }}}">{{#str}}home, core{{/str}}</a>
            </div>
        </div>
        <div class="baitalgahwa-login__visual d-none d-lg-flex" {{#heroimageurl}}style="background-image: url('{{{ heroimageurl }}}');"{{/heroimageurl}}>
            <div class="baitalgahwa-login__visual-scrim" aria-hidden="true"></div>
            <div class="baitalgahwa-login__visual-inner p-5 text-white position-relative">
                <h2 class="baitalgahwa-login__visual-title text-uppercase mb-3">{{ herotitle }}</h2>
                <p class="baitalgahwa-login__visual-text lead mb-0">{{ herosubtitle }}</p>
            </div>
        </div>
    </div>
</div>
<div class="baitalgahwa-login-end">
    {{{ output.standard_footer_html }}}
    {{{ output.standard_end_of_body_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_baitalgahwa/theme'], function(Loader, Bait) {
    Bait.init();
    M.util.js_complete('theme_boost/loader');
});
(function() {
    var isSignup = {{#is_signup_page}}true{{/is_signup_page}}{{^is_signup_page}}false{{/is_signup_page}};
    if (!isSignup) {
        return;
    }

    var findRow = function(input) {
        if (!input) {
            return null;
        }
        return input.closest('.fitem') || input.closest('.form-group') || input.closest('[data-fieldtype]') || input.parentElement;
    };

    var applySignupEnhancements = function() {
        var email = document.getElementById('id_email');
        var email2 = document.getElementById('id_email2');
        var firstname = document.getElementById('id_firstname');
        var lastname = document.getElementById('id_lastname');

        if (email && email2) {
            if (!email.dataset.baitSyncBound) {
                var syncEmail = function() {
                    email2.value = email.value;
                };
                email.addEventListener('input', syncEmail);
                email.addEventListener('change', syncEmail);
                email.dataset.baitSyncBound = '1';
                syncEmail();
            }
            if (!email.placeholder) {
                email.placeholder = 'Enter your email address';
            }
            var email2row = findRow(email2);
            if (email2row) {
                email2row.classList.add('baitalgahwa-signup-hiddenconfirm');
            }
        }

        if (firstname && lastname) {
            if (!firstname.placeholder) {
                firstname.placeholder = 'First name';
            }
            if (!lastname.placeholder) {
                lastname.placeholder = 'Last name';
            }
            var firstrow = findRow(firstname);
            var lastrow = findRow(lastname);
            if (firstrow && lastrow && (!firstrow.parentElement || !firstrow.parentElement.classList.contains('baitalgahwa-signup-grid'))) {
                var wrap = document.createElement('div');
                wrap.className = 'baitalgahwa-signup-merged';
                var label = document.createElement('p');
                label.className = 'baitalgahwa-signup-sectionlabel';
                label.textContent = 'Full name';
                var grid = document.createElement('div');
                grid.className = 'baitalgahwa-signup-grid';
                firstrow.parentNode.insertBefore(wrap, firstrow);
                wrap.appendChild(label);
                wrap.appendChild(grid);
                grid.appendChild(firstrow);
                grid.appendChild(lastrow);
            }
        }
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applySignupEnhancements);
    } else {
        applySignupEnhancements();
    }
})();
{{/js}}
