{{!
    Bait Al Gahwa: form first, then “Create account / Sign up”, then “Or” + identity providers (circular, design reference).
    @template core/loginform
}}
<div class="loginform baitalgahwa-core-loginform">
    {{#logourl}}
    <div id="loginlogo" class="login-logo text-center mb-3">
        <img id="logoimage" src="{{logourl}}" class="img-fluid baitalgahwa-core-loginform__logo" alt="{{sitename}}"/>
        <h1 class="login-heading sr-only">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>
    </div>
    {{/logourl}}
    {{^logourl}}
    <h1 class="login-heading mb-0 text-center h4 baitalgahwa-core-loginform__logintitle">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>
    {{/logourl}}
    {{#maintenance}}
    <div class="alert alert-danger login-maintenance">
        {{{maintenance}}}
    </div>
    {{/maintenance}}
    {{#error}}
    <div class="alert alert-danger" id="loginerrormessage" role="alert">{{error}}</div>
    {{/error}}
    {{#info}}
    <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}
    {{#showloginform}}
    <form class="login-form" action="{{loginurl}}" method="post" id="login">
        <input id="anchor" type="hidden" name="anchor" value="">
        <script>document.getElementById('anchor').value = location.hash;</script>
        <input type="hidden" name="logintoken" value="{{logintoken}}">
        <div class="login-form-username mb-3">
            <label for="username" class="baitalgahwa-field-label d-block text-muted small mb-1">
                {{^canloginbyemail}}
                    {{#str}} username {{/str}}
                {{/canloginbyemail}}
                {{#canloginbyemail}}
                    {{#str}} usernameemail {{/str}}
                {{/canloginbyemail}}
            </label>
            <input type="text" name="username" id="username" {{!
                !}}class="form-control baitalgahwa-input" {{!
                !}}value="{{username}}" {{!
                !}}placeholder="{{^canloginbyemail}}{{#cleanstr}}username{{/cleanstr}}{{/canloginbyemail}}{{!
                !}}{{#canloginbyemail}}{{#cleanstr}}usernameemail{{/cleanstr}}{{/canloginbyemail}}" {{!
                !}}autocomplete="username">
        </div>
        <div class="login-form-password mb-3">
            <label for="password" class="baitalgahwa-field-label d-block text-muted small mb-1">{{#str}} password {{/str}}</label>
            <div class="baitalgahwa-password-wrap">
                <input type="password" name="password" id="password" value="" {{!
                    !}}class="form-control baitalgahwa-input baitalgahwa-input--password" {{!
                    !}}placeholder="{{#cleanstr}}password{{/cleanstr}}" {{!
                    !}}autocomplete="current-password">
                <button
                    class="baitalgahwa-password-toggle"
                    type="button"
                    aria-label="Show password"
                    aria-pressed="false"
                    data-password-toggle
                    data-target="password">
                    <svg class="baitalgahwa-password-toggle__icon baitalgahwa-password-toggle__icon--eye" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M12 5C6.5 5 2.08 8.44.25 12c1.83 3.56 6.25 7 11.75 7s9.92-3.44 11.75-7C21.92 8.44 17.5 5 12 5zm0 11.2A4.2 4.2 0 1 1 12 7.8a4.2 4.2 0 0 1 0 8.4zm0-6.72A2.52 2.52 0 1 0 12 14.52a2.52 2.52 0 0 0 0-5.04z"/>
                    </svg>
                    <svg class="baitalgahwa-password-toggle__icon baitalgahwa-password-toggle__icon--eyeoff" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M2.1 3.51 1 4.61l3.09 3.08C2.51 8.82 1.16 10.31.25 12c1.83 3.56 6.25 7 11.75 7 2.2 0 4.25-.55 6.03-1.5l3.36 3.36 1.1-1.1Zm9.9 3.29c4.67 0 8.54 2.78 10.13 5.2-.67 1.02-1.67 2.09-2.9 3l-1.91-1.91A4.17 4.17 0 0 0 12.9 8.7l-1.46-1.46c.18-.02.37-.04.56-.04Zm-6.25 3.1 2.05 2.05a4.2 4.2 0 0 0 4.25 4.25l2.05 2.05c-.67.15-1.37.25-2.1.25-4.67 0-8.54-2.78-10.13-5.2.52-.8 1.18-1.61 1.88-2.35Zm3.21 3.21 2.93 2.93a2.52 2.52 0 0 1-2.93-2.93Zm4.15-.59 1.89 1.89a2.51 2.51 0 0 0-1.89-1.89Z"/>
                    </svg>
                </button>
            </div>
        </div>
        {{#recaptcha}}
        <div class="login-form-recaptcha mb-3">
            {{{recaptcha}}}
        </div>
        {{/recaptcha}}
        <div class="login-form-submit mb-3">
            <button class="btn btn-primary btn-block baitalgahwa-login-submit py-2" type="submit" id="loginbtn">{{#str}} login {{/str}}</button>
        </div>
        <div class="login-form-forgotpassword mb-3 text-center small">
            <a class="baitalgahwa-link-forgot" href="{{forgotpasswordurl}}">{{#str}}forgotaccount{{/str}}</a>
        </div>
    </form>
    {{/showloginform}}
    {{#cansignup}}
    <p class="baitalgahwa-login-subcta text-center text-muted small mb-0">
        {{#str}} authpanel_createaccount_line, theme_baitalgahwa {{/str}}
        <a class="baitalgahwa-auth-link" href="{{signupurl}}">{{#str}} authpanel_signup_link, theme_baitalgahwa {{/str}}</a>
    </p>
    {{/cansignup}}
    {{#hasidentityproviders}}
    <div class="baitalgahwa-login-divider" role="separator" aria-hidden="true">
        <span class="baitalgahwa-login-divider__line"></span>
        <span class="baitalgahwa-login-divider__text">{{#str}} divideror, theme_baitalgahwa {{/str}}</span>
        <span class="baitalgahwa-login-divider__line"></span>
    </div>
    <div class="baitalgahwa-idps baitalgahwa-idps--circular d-flex flex-wrap align-items-center justify-content-center" role="group" aria-label="{{#str}} potentialidps, auth {{/str}}">
        {{#identityproviders}}
        <a class="baitalgahwa-idp-round" href="{{url}}" title="{{name}}">
            <span class="sr-only">{{name}}</span>
            {{#iconurl}}
            <img src="{{iconurl}}" alt="" class="baitalgahwa-idp-round__img" width="22" height="22" loading="lazy" aria-hidden="true"/>
            {{/iconurl}}
            {{^iconurl}}
            <span class="baitalgahwa-idp-round__fallback" aria-hidden="true">{{name}}</span>
            {{/iconurl}}
        </a>
        {{/identityproviders}}
    </div>
    {{/hasidentityproviders}}
{{^hasidentityproviders}}
    <div class="baitalgahwa-login-divider" role="separator" aria-hidden="true">
        <span class="baitalgahwa-login-divider__line"></span>
        <span class="baitalgahwa-login-divider__text">{{#str}} divideror, theme_baitalgahwa {{/str}}</span>
        <span class="baitalgahwa-login-divider__line"></span>
    </div>
    <div class="baitalgahwa-idps baitalgahwa-idps--circular baitalgahwa-idps--static d-flex flex-wrap align-items-center justify-content-center" role="group" aria-label="{{#str}} authpanel_socialnav, theme_baitalgahwa {{/str}}">
        <span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Google">
            <svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#EA4335" d="M12 10.2v3.9h5.42c-.23 1.26-.95 2.32-2.03 3.04l3.29 2.55c1.92-1.77 3.02-4.38 3.02-7.48 0-.71-.06-1.4-.18-2.06H12z"/>
                <path fill="#34A853" d="M12 22c2.73 0 5.02-.91 6.69-2.47l-3.29-2.55c-.91.61-2.08.97-3.4.97-2.62 0-4.84-1.77-5.64-4.14H3.96v2.63A10.1 10.1 0 0 0 12 22z"/>
                <path fill="#4A90E2" d="M6.36 13.81A6.08 6.08 0 0 1 6.05 12c0-.63.11-1.24.31-1.81V7.56H3.96A10.03 10.03 0 0 0 2 12c0 1.62.39 3.15 1.08 4.44l3.28-2.63z"/>
                <path fill="#FBBC05" d="M12 6.05c1.48 0 2.8.51 3.84 1.51l2.88-2.88C17 3.09 14.71 2 12 2a10.1 10.1 0 0 0-8.04 5.56l3.4 2.63C7.16 7.82 9.38 6.05 12 6.05z"/>
            </svg>
        </span>
        <span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Apple">
            <svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#111111" d="M16.37 12.66c.03 2.85 2.5 3.8 2.53 3.82-.02.07-.39 1.33-1.27 2.63-.77 1.13-1.56 2.26-2.81 2.28-1.23.02-1.63-.73-3.04-.73s-1.85.71-3.02.75c-1.2.05-2.12-1.2-2.9-2.33C4.25 16.72 3 12.48 4.67 9.6c.83-1.43 2.31-2.33 3.92-2.35 1.22-.02 2.38.82 3.04.82.65 0 2.03-.99 3.42-.84.58.02 2.23.23 3.29 1.79-.08.05-1.96 1.14-1.97 3.64zM14.05 5.76c.64-.77 1.08-1.84.96-2.91-.93.04-2.05.62-2.72 1.39-.6.69-1.12 1.79-.98 2.84 1.04.08 2.1-.53 2.74-1.32z"/>
            </svg>
        </span>
        <span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Facebook">
            <svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.91v-8.42H7.08v-3.49h3.05V9.41c0-3.03 1.8-4.7 4.56-4.7 1.32 0 2.7.24 2.7.24v2.98h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.34l-.53 3.49h-2.81v8.42C19.61 23.08 24 18.09 24 12.07z"/>
            </svg>
        </span>
        <span class="baitalgahwa-idp-round baitalgahwa-idp-round--static" role="img" aria-label="Twitter">
            <svg class="baitalgahwa-social-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#1DA1F2" d="M23 4.58a9.4 9.4 0 0 1-2.7.76 4.72 4.72 0 0 0 2.07-2.6 9.28 9.28 0 0 1-2.99 1.16A4.66 4.66 0 0 0 16 2.5c-2.61 0-4.72 2.14-4.72 4.78 0 .37.04.74.12 1.09-3.92-.2-7.39-2.1-9.72-4.98a4.82 4.82 0 0 0-.64 2.4c0 1.66.83 3.12 2.09 3.98a4.63 4.63 0 0 1-2.14-.6v.06c0 2.32 1.63 4.25 3.8 4.69a4.56 4.56 0 0 1-2.13.08 4.71 4.71 0 0 0 4.4 3.28A9.35 9.35 0 0 1 1 19.32 13.18 13.18 0 0 0 8.23 21.5c8.67 0 13.41-7.28 13.41-13.6 0-.2 0-.41-.01-.61A9.68 9.68 0 0 0 23 4.58z"/>
            </svg>
        </span>
    </div>
{{/hasidentityproviders}}
    {{#hasinstructions}}
    <div class="login-divider my-3"></div>
    <div class="login-instructions {{#cansignup}}mb-3{{/cansignup}}">
        <h2 class="h6 text-muted">{{#str}} firsttime {{/str}}</h2>
        <div class="login-instructions__body small">{{{instructions}}}</div>
    </div>
    {{/hasinstructions}}
    {{#canloginasguest}}
    <div class="login-divider my-3"></div>
    <h2 class="h6 text-muted">{{#str}} someallowguest {{/str}}</h2>
    <form action="{{loginurl}}" method="post" id="guestlogin">
        <input type="hidden" name="logintoken" value="{{logintoken}}">
        <input type="hidden" name="username" value="guest" />
        <input type="hidden" name="password" value="guest" />
        <button class="btn btn-secondary btn-block" type="submit" id="loginguestbtn">{{#str}} loginguest {{/str}}</button>
    </form>
    {{/canloginasguest}}
    <div class="login-divider my-3"></div>
    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 baitalgahwa-login-meta">
        {{#languagemenu}}
        <div class="login-languagemenu">
            {{>core/action_menu}}
        </div>
        <div class="divider border-start align-self-stretch mx-1 d-none d-sm-block" aria-hidden="true"></div>
        {{/languagemenu}}
        <button type="button" class="btn btn-sm btn-link text-muted" {{!
        }} data-modal="alert"{{!
        }} data-modal-title-str='["cookiesenabled", "core"]' {{!
        }} data-modal-content-str='["cookiesenabled_help_html", "core"]'{{!
        }}>{{#str}} cookiesnotice {{/str}}</button>
    </div>
</div>
{{#js}}
{{^error}}
{{#autofocusform}}
require(['core_form/events'], function(FormEvent) {
    function autoFocus() {
        const userNameField = document.getElementById('username');
        const passwordField = document.getElementById('password');
        if (userNameField && userNameField.value.length === 0) {
            userNameField.focus();
        } else if (passwordField) {
            passwordField.focus();
        }
    }
    autoFocus();
    window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
});
{{/autofocusform}}
{{/error}}
require(['core/pending'], function(Pending) {
    const errorMessageDiv = document.getElementById('loginerrormessage');
    const infoMessageDiv = document.getElementById('logininfomessage');
    const errorMessage = errorMessageDiv ? errorMessageDiv.textContent.trim() : '';
    const infoMessage = infoMessageDiv ? infoMessageDiv.textContent.trim() : '';
    if (errorMessage || infoMessage) {
        const pendingJS = new Pending('login-move-focus');
        const usernameField = document.getElementById('username');
        setTimeout(function() {
            if (errorMessage && usernameField) {
                usernameField.focus();
            }
            if (errorMessage && errorMessageDiv) {
                errorMessageDiv.innerHTML += "&nbsp;";
            }
            if (infoMessage && infoMessageDiv) {
                infoMessageDiv.innerHTML += "&nbsp;";
            }
            pendingJS.resolve();
        }, 500);
    }
});
{{#togglepassword}}
require(['core/togglesensitive'], function(ToggleSensitive) {
    ToggleSensitive.init("password", {{smallscreensonly}});
});
{{/togglepassword}}
require(['core_form/submit'], function(Submit) {
    Submit.init("loginbtn");
    {{#canloginasguest}}
    Submit.init("loginguestbtn");
    {{/canloginasguest}}
});
{{/js}}
