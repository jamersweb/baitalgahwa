{{!
    @template theme_baitalgahwa/mycourses
    My courses catalogue (/my/courses.php) — matches design reference: toolbar, tabs, filter row, 4×2 grid.
}}
{{> theme_boost/head }}
<style>
body.pagelayout-mycourses .main-inner {
    background: #fcfaf7;
    max-width: none !important;
}
body.pagelayout-mycourses #page-header,
body.pagelayout-mycourses .secondary-navigation {
    display: none;
}
body.pagelayout-mycourses #page-wrapper,
body.pagelayout-mycourses #page,
body.pagelayout-mycourses #page.drawers {
    max-width: none !important;
    width: 100% !important;
}
body.pagelayout-mycourses #topofscroll.main-inner {
    max-width: none !important;
    width: 100% !important;
    box-sizing: border-box;
}
.baitalgahwa-mycourses-page {
    width: 100% !important;
    max-width: none !important;
    margin: 0;
    padding: 5rem 0 4.5rem;
    color: #241b15;
    box-sizing: border-box;
}
.baitalgahwa-mycourses-shell {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: min(calc(100% - clamp(2rem, 10.5vw, 13rem)), 1710px) !important;
    max-width: 1710px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    box-sizing: border-box;
}
.baitalgahwa-mycourses-pagehead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
}
.baitalgahwa-mycourses-pagehead__text {
    min-width: 0;
}
.baitalgahwa-mycourses-pagehead__eyebrow {
    display: none;
    margin: 0;
    color: #7c7268;
    font-size: .9rem;
}
.baitalgahwa-mycourses-pagehead__title {
    margin: 0;
    color: #744b27;
    font-family: inherit;
    font-size: clamp(2.15rem, 2.5vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
}
.baitalgahwa-mycourses-pagehead__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    align-items: center;
}
.baitalgahwa-mycourses-pagehead__actions .btn-manage {
    border: 2px solid #744b27;
    background: #fff;
    color: #744b27;
    font-weight: 500;
    font-size: 1rem;
    padding: .95rem 2.15rem;
    border-radius: .55rem;
    text-decoration: none;
}
.baitalgahwa-mycourses-pagehead__actions .btn-manage:hover {
    background: #faf6f1;
    color: #3d290f;
}
.baitalgahwa-mycourses-pagehead__actions .btn-create {
    border: 2px solid #744b27;
    background: #744b27;
    color: #fff;
    font-weight: 500;
    font-size: 1rem;
    padding: .95rem 2.15rem;
    border-radius: .55rem;
    text-decoration: none;
}
.baitalgahwa-mycourses-pagehead__actions .btn-create:hover {
    background: #73471e;
    border-color: #73471e;
    color: #fff;
}
.baitalgahwa-mycourses-tabs {
    display: flex;
    align-items: stretch;
    flex-wrap: nowrap;
    gap: clamp(2rem, 5.8vw, 7rem);
    border-bottom: 2px solid #352d27;
    margin-bottom: 2.2rem;
    overflow-x: auto;
}
.baitalgahwa-mycourses-tabs [role="tab"] {
    appearance: none;
    border: 0;
    background: transparent;
    margin: 0;
    padding: .72rem 0 1.05rem;
    font-size: clamp(1.05rem, 1.35vw, 1.45rem);
    font-weight: 800;
    color: #302b27;
    cursor: pointer;
    border-bottom: 6px solid transparent;
    margin-bottom: -1px;
    border-radius: 0;
}
.baitalgahwa-mycourses-tabs [role="tab"]:hover {
    color: #3a3028;
}
.baitalgahwa-mycourses-tabs [role="tab"][aria-selected="true"] {
    color: #744b27;
    border-bottom-color: #744b27;
}
.baitalgahwa-mycourses-toolbarrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.75rem;
}
.baitalgahwa-mycourses-toolbarrow__search {
    flex: 0 1 22rem;
    min-width: 17rem;
    border: 1px solid #dfd1c3;
    border-radius: .55rem;
    padding: .82rem 1.05rem;
    font-size: 1rem;
    background: #fff;
    color: #2a1d14;
}
.baitalgahwa-mycourses-toolbarrow__search::placeholder {
    color: #9a9085;
}
.baitalgahwa-mycourses-toolbarrow__btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .78rem 1.15rem;
    border-radius: .55rem;
    border: 1px solid #d6dce2;
    background: #fff;
    color: #1d2a36;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
}
.baitalgahwa-mycourses-toolbarrow__btn:hover {
    background: #faf6f1;
}
.baitalgahwa-mycourses-toolbarrow__sort {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin-left: auto;
    font-size: 1rem;
    font-weight: 500;
    color: #1d2a36;
}
.baitalgahwa-mycourses-toolbarrow__sort select {
    border: 1px solid #dfd1c3;
    border-radius: .55rem;
    padding: .72rem .85rem;
    font-size: 1rem;
    background: #fff;
    color: #2a1d14;
    max-width: 9rem;
}
.baitalgahwa-mycourses-catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
}
.baitalgahwa-mycourses-catalog__grid.is-compact {
    grid-template-columns: repeat(5, minmax(0, 1fr));
}
.baitalgahwa-mycourses-catalog__cell {
    min-width: 0;
    display: flex;
}
.baitalgahwa-mycourses-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #fff;
    border: 1px solid #e8ded4;
    border-radius: 1.45rem;
    box-shadow: 0 .75rem 1.35rem rgba(36, 27, 21, .18);
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
}
.baitalgahwa-mycourses-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 .85rem 2rem rgba(48, 27, 12, .11);
}
.baitalgahwa-mycourses-card__media {
    position: relative;
    overflow: hidden;
}
.baitalgahwa-mycourses-card__image {
    height: clamp(17rem, 18.5vw, 21.5rem);
    background-size: cover;
    background-position: center;
}
.baitalgahwa-mycourses-card__image--gahwa {
    background-position: 58% 42%;
}
.baitalgahwa-mycourses-card__image--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .24), transparent 20rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-mycourses-card__badge {
    position: absolute;
    top: 2rem;
    left: 1.75rem;
    z-index: 2;
    padding: .65rem 2.1rem;
    border-radius: 999px;
    background: rgba(255,255,255,.95);
    color: #8a5a2b;
    font-size: 1.05rem;
    font-weight: 500;
}
.baitalgahwa-mycourses-card__schedule {
    position: absolute;
    left: 1.7rem;
    right: 1.7rem;
    bottom: 1.55rem;
    z-index: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: .75rem;
    padding: .72rem 1rem;
    background: rgba(255,247,241,.97);
    border-radius: 999px;
    font-size: .86rem;
    font-weight: 500;
    color: #744b27;
    line-height: 1.35;
}
.baitalgahwa-mycourses-card__schedule span {
    display: flex;
    align-items: center;
    gap: .35rem;
}
.baitalgahwa-mycourses-card__schedule .fa {
    color: #8a5a2b;
    font-size: .72rem;
}
.baitalgahwa-mycourses-card__body {
    display: flex;
    flex-direction: column;
    gap: .85rem;
    flex: 1 1 auto;
    padding: 1.85rem 1.75rem 1.95rem;
}
.baitalgahwa-mycourses-card__title {
    margin: 0;
    color: #201813;
    font-size: clamp(1.35rem, 1.45vw, 1.75rem);
    font-weight: 800;
    line-height: 1.35;
}
.baitalgahwa-mycourses-card__copy {
    margin: 0;
    color: #7c7268;
    font-size: 1rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.85rem;
}
.baitalgahwa-mycourses-card__host {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-top: auto;
    font-size: 1.02rem;
    color: #744b27;
    line-height: 1.35;
}
.baitalgahwa-mycourses-card__host-avatar {
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #f3ebe3;
    color: #8a5a2b;
    font-size: .75rem;
}
.baitalgahwa-mycourses-card__cta {
    display: block;
    width: 100%;
    margin-top: 1.1rem;
    padding: 1rem 1.1rem;
    border-radius: .55rem;
    border: 0;
    background: #744b27;
    color: #fff !important;
    font-weight: 500;
    font-size: 1rem;
    text-align: center;
    text-decoration: none;
}
.baitalgahwa-mycourses-card__cta:hover {
    background: #73471e;
    color: #fff !important;
}
.baitalgahwa-mycourses-panel {
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.25rem;
    box-shadow: 0 .75rem 2rem rgba(48, 27, 12, .06);
    padding: 1.5rem 1.6rem;
}
.baitalgahwa-mycourses-panel__body {
    color: #7c7268;
    font-size: .96rem;
    line-height: 1.75;
}
.baitalgahwa-mycourses-hidden-content {
    display: none;
}
@media (max-width: 1199.98px) {
    .baitalgahwa-mycourses-catalog__grid,
    .baitalgahwa-mycourses-catalog__grid.is-compact {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 991.98px) {
    .baitalgahwa-mycourses-page {
        padding: 2.25rem 0 3rem !important;
    }
    .baitalgahwa-mycourses-shell {
        width: min(calc(100% - 2rem), 1710px) !important;
    }
    .baitalgahwa-mycourses-tabs {
        gap: 2rem;
    }
    .baitalgahwa-mycourses-toolbarrow__sort {
        margin-left: 0;
        width: 100%;
        justify-content: space-between;
    }
}
@media (max-width: 575.98px) {
    .baitalgahwa-mycourses-page {
        padding: 1.1rem 0 2.25rem;
    }
    .baitalgahwa-mycourses-catalog__grid,
    .baitalgahwa-mycourses-catalog__grid.is-compact {
        grid-template-columns: minmax(0, 1fr);
    }
    .baitalgahwa-mycourses-pagehead {
        flex-direction: column;
        align-items: stretch;
    }
    .baitalgahwa-mycourses-pagehead__actions {
        justify-content: stretch;
    }
    .baitalgahwa-mycourses-pagehead__actions .btn-manage,
    .baitalgahwa-mycourses-pagehead__actions .btn-create {
        flex: 1;
        text-align: center;
        justify-content: center;
    }
    .baitalgahwa-mycourses-card__image {
        height: 15rem;
    }
    .baitalgahwa-mycourses-card__schedule {
        left: 1rem;
        right: 1rem;
        flex-direction: column;
        border-radius: 1rem;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_baitalgahwa/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}{{> theme_boost/courseindexdrawercontrols}}{{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}{{{courseindex}}}{{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}
    <div id="page" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-courseindex" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerindex, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                        {{#pix}} t/index_drawer, moodle {{/pix}}
                    </button>
                </div>
                {{/courseindex}}
                {{#hasblocks}}
                <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerblocks, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                        <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                        <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                    </button>
                </div>
                {{/hasblocks}}
            </div>
            {{{ output.full_header }}}
            <main class="baitalgahwa-mycourses-page" id="bag-mycourses-overview">
                <div class="baitalgahwa-mycourses-shell">
                    <header class="baitalgahwa-mycourses-pagehead">
                        <div class="baitalgahwa-mycourses-pagehead__text">
                            <p class="baitalgahwa-mycourses-pagehead__eyebrow">{{ dashboardwelcome }}</p>
                            <h1 class="baitalgahwa-mycourses-pagehead__title">{{#mycourses_title}}{{mycourses_title}}{{/mycourses_title}}{{^mycourses_title}}{{#str}}mycourses, moodle{{/str}}{{/mycourses_title}}</h1>
                        </div>
                        {{#mycourses_toolbar}}
                        <div class="baitalgahwa-mycourses-pagehead__actions" role="group" aria-label="{{{ mc_toolbar_aria }}}">
                            {{#canmanagecourses}}
                            <a href="{{{ managecourseurl }}}" class="btn-manage">{{{ managecoursetext }}}</a>
                            {{/canmanagecourses}}
                            {{#cancreatecourse}}
                            <a href="{{{ createcourseurl }}}" class="btn-create">{{{ createcoursetext }}}</a>
                            {{/cancreatecourse}}
                        </div>
                        {{/mycourses_toolbar}}
                    </header>

                    <div class="baitalgahwa-mycourses-tabs" role="tablist" aria-label="{{{ mycourses_title }}}">
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="true" data-bag-mycourses-tab="all">{{{ mc_tab_all }}}</button>
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="false" data-bag-mycourses-tab="inprogress">{{{ mc_tab_inprogress }}}</button>
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="false" data-bag-mycourses-tab="starred">{{{ mc_tab_starred }}}</button>
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="false" data-bag-mycourses-tab="removed">{{{ mc_tab_removed }}}</button>
                    </div>

                    <div class="baitalgahwa-mycourses-toolbarrow">
                        <label class="sr-only" for="bag-mycourses-search">{{{ mc_search_placeholder }}}</label>
                        <input id="bag-mycourses-search" class="baitalgahwa-mycourses-toolbarrow__search" type="search" data-bag-course-filter autocomplete="off" placeholder="{{{ mc_search_placeholder }}}">
                        <button type="button" class="baitalgahwa-mycourses-toolbarrow__btn" data-bag-filter-focus><i class="fa fa-sliders" aria-hidden="true"></i> {{{ mc_filter }}}</button>
                        <div class="baitalgahwa-mycourses-toolbarrow__sort">
                            <label for="bag-mycourses-sort">{{{ mc_sort_by }}}</label>
                            <select id="bag-mycourses-sort" aria-label="{{{ mc_sort_by }}}">
                                <option>{{{ mc_sort_latest }}}</option>
                            </select>
                        </div>
                        <button type="button" class="baitalgahwa-mycourses-toolbarrow__btn" data-bag-column-toggle>{{{ mc_columns }}}</button>
                    </div>

                    {{#has_activity_courses}}
                    <ul class="baitalgahwa-mycourses-catalog__grid" role="list" aria-label="{{{ mycourses_title }}}" data-bag-courses-grid>
                        {{#activity_courses}}
                        <li class="baitalgahwa-mycourses-catalog__cell" role="listitem">
                            <article class="baitalgahwa-mycourses-card" data-bag-course-card data-search="{{fullname}} {{categoryname}} {{summary}}">
                                <div class="baitalgahwa-mycourses-card__media">
                                    {{#imageurl}}
                                    <div class="baitalgahwa-mycourses-card__image{{#programme_focus_gahwa}} baitalgahwa-mycourses-card__image--gahwa{{/programme_focus_gahwa}}" style="background-image:url('{{{ imageurl }}}');"></div>
                                    {{/imageurl}}
                                    {{^imageurl}}
                                    <div class="baitalgahwa-mycourses-card__image baitalgahwa-mycourses-card__image--placeholder"></div>
                                    {{/imageurl}}
                                    {{#isnew}}
                                    <span class="baitalgahwa-mycourses-card__badge">{{{ mc_course_new }}}</span>
                                    {{/isnew}}
                                    {{^isnew}}
                                    <span class="baitalgahwa-mycourses-card__badge">{{{ mc_available }}}</span>
                                    {{/isnew}}
                                    <div class="baitalgahwa-mycourses-card__schedule">
                                        {{#has_card_schedule}}
                                            {{#card_starts_line}}<span><i class="fa fa-clock-o" aria-hidden="true"></i> {{ card_starts_line }}</span>{{/card_starts_line}}
                                            {{#card_ends_line}}<span><i class="fa fa-clock-o" aria-hidden="true"></i> {{ card_ends_line }}</span>{{/card_ends_line}}
                                        {{/has_card_schedule}}
                                        {{^has_card_schedule}}
                                            <span><i class="fa fa-calendar-o" aria-hidden="true"></i> {{{ mc_dates_hint }}}</span>
                                        {{/has_card_schedule}}
                                    </div>
                                </div>
                                <div class="baitalgahwa-mycourses-card__body">
                                    <h2 class="baitalgahwa-mycourses-card__title">{{ fullname }}</h2>
                                    {{#summary}}<p class="baitalgahwa-mycourses-card__copy">{{ summary }}</p>{{/summary}}
                                    <div class="baitalgahwa-mycourses-card__host">
                                        <span class="baitalgahwa-mycourses-card__host-avatar" aria-hidden="true"><i class="fa fa-user"></i></span>
                                        <span>{{ instructor_host }}</span>
                                    </div>
                                    <a class="baitalgahwa-mycourses-card__cta" href="{{{ url }}}">{{{ mc_gotocourse }}}</a>
                                </div>
                            </article>
                        </li>
                        {{/activity_courses}}
                    </ul>
                    {{/has_activity_courses}}
                    {{^has_activity_courses}}
                    <section class="baitalgahwa-mycourses-panel">
                        <p class="baitalgahwa-mycourses-panel__body mb-0">{{{ mc_nocourses }}}</p>
                    </section>
                    {{/has_activity_courses}}

                    {{#hasmaincontent}}
                    <div id="page-content" class="baitalgahwa-mycourses-hidden-content" hidden aria-hidden="true">
                        {{{ maincontent }}}
                    </div>
                    {{/hasmaincontent}}
                </div>
            </main>
        </div>
        {{> theme_baitalgahwa/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer', 'theme_baitalgahwa/theme'], function(Loader, Drawer, Bait) {
    Drawer.init();
    Bait.init();
    var tablist = document.querySelector('.baitalgahwa-mycourses-tabs');
    if (tablist) {
        tablist.querySelectorAll('[role="tab"]').forEach(function(tab) {
            tab.addEventListener('click', function() {
                tablist.querySelectorAll('[role="tab"]').forEach(function(t) {
                    t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
                });
            });
        });
    }
    var filter = document.querySelector('[data-bag-course-filter]');
    var applyCourseFilter = function() {
        var activeTab = document.querySelector('.baitalgahwa-mycourses-tabs [aria-selected="true"]');
        var tabValue = activeTab ? activeTab.getAttribute('data-bag-mycourses-tab') : 'all';
        var q = filter ? (filter.value || '').toLowerCase().trim() : '';
        document.querySelectorAll('[data-bag-course-card]').forEach(function(card) {
            var hay = (card.getAttribute('data-search') || '').toLowerCase();
            var cell = card.closest('.baitalgahwa-mycourses-catalog__cell');
            if (!cell) {
                return;
            }
            var matchesSearch = !q || hay.indexOf(q) !== -1;
            var matchesTab = tabValue === 'all' || tabValue === 'inprogress';
            cell.style.display = matchesSearch && matchesTab ? '' : 'none';
        });
    };
    if (filter) {
        filter.addEventListener('input', applyCourseFilter);
    }
    document.querySelectorAll('[data-bag-mycourses-tab]').forEach(function(tab) {
        tab.addEventListener('click', applyCourseFilter);
    });
    document.querySelectorAll('[data-bag-filter-focus]').forEach(function(button) {
        button.addEventListener('click', function() {
            if (filter) {
                filter.focus();
            }
        });
    });
    document.querySelectorAll('[data-bag-column-toggle]').forEach(function(button) {
        button.addEventListener('click', function() {
            var grid = document.querySelector('[data-bag-courses-grid]');
            if (grid) {
                grid.classList.toggle('is-compact');
            }
        });
    });
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
