{{!
    @template theme_baitalgahwa/mycourses
    My courses catalogue (/my/courses.php) — matches design reference: toolbar, tabs, filter row, 4×2 grid.
}}
{{> theme_boost/head }}
<style>
body.pagelayout-mycourses .main-inner {
    background: #fcfaf7;
}
body.pagelayout-mycourses #page-header,
body.pagelayout-mycourses .secondary-navigation {
    display: none;
}
body.pagelayout-mycourses #page.drawers,
body.pagelayout-mycourses #topofscroll.main-inner {
    max-width: 100%;
    width: 100%;
}
.baitalgahwa-mycourses-page {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 1.75rem 1.25rem 3rem;
    color: #241b15;
}
.baitalgahwa-mycourses-shell {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: min(100%, 1320px);
    margin: 0 auto;
}
.baitalgahwa-mycourses-pagehead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.35rem;
}
.baitalgahwa-mycourses-pagehead__text {
    min-width: 0;
}
.baitalgahwa-mycourses-pagehead__eyebrow {
    margin: 0 0 .35rem;
    color: #7c7268;
    font-size: .9rem;
}
.baitalgahwa-mycourses-pagehead__title {
    margin: 0;
    color: #201813;
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: clamp(1.85rem, 2.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.15;
}
.baitalgahwa-mycourses-pagehead__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    align-items: center;
}
.baitalgahwa-mycourses-pagehead__actions .btn-manage {
    border: 1px solid #c4a889;
    background: #fff;
    color: #5c3d1f;
    font-weight: 600;
    font-size: .86rem;
    padding: .52rem 1.15rem;
    border-radius: .55rem;
    text-decoration: none;
}
.baitalgahwa-mycourses-pagehead__actions .btn-manage:hover {
    background: #faf6f1;
    color: #3d290f;
}
.baitalgahwa-mycourses-pagehead__actions .btn-create {
    border: 1px solid #8a5a2b;
    background: #8a5a2b;
    color: #fff;
    font-weight: 600;
    font-size: .86rem;
    padding: .52rem 1.15rem;
    border-radius: .55rem;
    text-decoration: none;
}
.baitalgahwa-mycourses-pagehead__actions .btn-create:hover {
    background: #73471e;
    border-color: #73471e;
    color: #fff;
}
.baitalgahwa-mycourses-tabs {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: 1px solid #e2d6ca;
    margin-bottom: 1rem;
}
.baitalgahwa-mycourses-tabs [role="tab"] {
    appearance: none;
    border: 0;
    background: transparent;
    margin: 0;
    padding: .72rem 1.1rem .85rem;
    font-size: .9rem;
    font-weight: 600;
    color: #6b6158;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    border-radius: 0;
}
.baitalgahwa-mycourses-tabs [role="tab"]:hover {
    color: #3a3028;
}
.baitalgahwa-mycourses-tabs [role="tab"][aria-selected="true"] {
    color: #201813;
    border-bottom-color: #8a5a2b;
}
.baitalgahwa-mycourses-toolbarrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.35rem;
}
.baitalgahwa-mycourses-toolbarrow__search {
    flex: 1 1 14rem;
    min-width: 10rem;
    border: 1px solid #dfd1c3;
    border-radius: .75rem;
    padding: .58rem .95rem;
    font-size: .86rem;
    background: #fff;
    color: #2a1d14;
}
.baitalgahwa-mycourses-toolbarrow__search::placeholder {
    color: #9a9085;
}
.baitalgahwa-mycourses-toolbarrow__btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .52rem .95rem;
    border-radius: .65rem;
    border: 1px solid #d8c8b7;
    background: #fff;
    color: #5c3d1f;
    font-size: .8rem;
    font-weight: 700;
    cursor: pointer;
}
.baitalgahwa-mycourses-toolbarrow__btn:hover {
    background: #faf6f1;
}
.baitalgahwa-mycourses-toolbarrow__sort {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin-left: auto;
    font-size: .8rem;
    font-weight: 600;
    color: #5c5146;
}
.baitalgahwa-mycourses-toolbarrow__sort select {
    border: 1px solid #dfd1c3;
    border-radius: .65rem;
    padding: .48rem .75rem;
    font-size: .78rem;
    background: #fff;
    color: #2a1d14;
    max-width: 9rem;
}
.baitalgahwa-mycourses-catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
}
.baitalgahwa-mycourses-catalog__cell {
    min-width: 0;
    display: flex;
}
.baitalgahwa-mycourses-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.1rem;
    box-shadow: 0 .55rem 1.65rem rgba(48, 27, 12, .07);
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
}
.baitalgahwa-mycourses-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 .85rem 2rem rgba(48, 27, 12, .11);
}
.baitalgahwa-mycourses-card__media {
    position: relative;
    overflow: hidden;
}
.baitalgahwa-mycourses-card__image {
    height: 11.25rem;
    background-size: cover;
    background-position: center;
}
.baitalgahwa-mycourses-card__image--gahwa {
    background-position: 58% 42%;
}
.baitalgahwa-mycourses-card__image--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .24), transparent 20rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-mycourses-card__badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    z-index: 2;
    padding: .28rem .7rem;
    border-radius: 999px;
    background: rgba(255,255,255,.95);
    color: #8a5a2b;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.baitalgahwa-mycourses-card__schedule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: .15rem;
    padding: .45rem .65rem;
    background: rgba(255,255,255,.93);
    border-top: 1px solid rgba(235, 227, 218, .9);
    font-size: .68rem;
    font-weight: 700;
    color: #4f453d;
    line-height: 1.35;
}
.baitalgahwa-mycourses-card__schedule span {
    display: flex;
    align-items: center;
    gap: .35rem;
}
.baitalgahwa-mycourses-card__schedule .fa {
    color: #8a5a2b;
    font-size: .72rem;
}
.baitalgahwa-mycourses-card__body {
    display: flex;
    flex-direction: column;
    gap: .55rem;
    flex: 1 1 auto;
    padding: 1rem 1.05rem 1.1rem;
}
.baitalgahwa-mycourses-card__title {
    margin: 0;
    color: #201813;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.35;
}
.baitalgahwa-mycourses-card__copy {
    margin: 0;
    color: #7c7268;
    font-size: .835rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.85rem;
}
.baitalgahwa-mycourses-card__host {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: auto;
    font-size: .78rem;
    color: #6a5f55;
    line-height: 1.35;
}
.baitalgahwa-mycourses-card__host-avatar {
    width: 1.85rem;
    height: 1.85rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #f3ebe3;
    color: #8a5a2b;
    font-size: .75rem;
}
.baitalgahwa-mycourses-card__cta {
    display: block;
    width: 100%;
    margin-top: .45rem;
    padding: .58rem 1rem;
    border-radius: .6rem;
    border: 0;
    background: #8a5a2b;
    color: #fff !important;
    font-weight: 700;
    font-size: .84rem;
    text-align: center;
    text-decoration: none;
}
.baitalgahwa-mycourses-card__cta:hover {
    background: #73471e;
    color: #fff !important;
}
.baitalgahwa-mycourses-panel {
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.25rem;
    box-shadow: 0 .75rem 2rem rgba(48, 27, 12, .06);
    padding: 1.5rem 1.6rem;
}
.baitalgahwa-mycourses-section__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}
.baitalgahwa-mycourses-section__title {
    margin: 0;
    color: #201813;
    font-size: 1.2rem;
    font-weight: 700;
}
.baitalgahwa-mycourses-section__intro {
    color: #7c7268;
    font-size: .95rem;
    line-height: 1.65;
}
.baitalgahwa-mycourses-minical th {
    color: #61574f;
    font-size: .82rem;
    font-weight: 700;
    border: 0;
    padding: .45rem .2rem;
}
.baitalgahwa-mycourses-minical td {
    border: 0;
    padding: .3rem .2rem;
}
.baitalgahwa-mycourses-minical__day {
    min-width: 2rem;
    line-height: 2rem;
    border-radius: 999px;
}
.baitalgahwa-mycourses-minical__today {
    background: #8a5a2b;
    color: #fff;
    font-weight: 700;
}
.baitalgahwa-mycourses-member {
    display: flex;
    align-items: center;
    gap: .9rem;
    height: 100%;
    border: 1px solid #efe5db;
    border-radius: 1rem;
    background: #f6f1eb;
    padding: .85rem 1rem;
}
.baitalgahwa-mycourses-member__avatar .userpicture,
.baitalgahwa-mycourses-member__avatar img {
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 999px;
}
.baitalgahwa-mycourses-member__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
}
.baitalgahwa-mycourses-member__name {
    color: #201813;
    font-weight: 700;
}
.baitalgahwa-mycourses-member__role {
    color: #7c7268;
    font-size: .88rem;
}
.baitalgahwa-mycourses-inline-link {
    color: #8a5a2b;
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
}
.baitalgahwa-mycourses-secondary {
    margin-top: 2.25rem;
}
.baitalgahwa-mycourses-panel__body {
    color: #7c7268;
    font-size: .96rem;
    line-height: 1.75;
}
.baitalgahwa-mycourses-hidden-content {
    display: none;
}
@media (max-width: 1199.98px) {
    .baitalgahwa-mycourses-catalog__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 991.98px) {
    .baitalgahwa-mycourses-page {
        padding-inline: .9rem;
    }
    .baitalgahwa-mycourses-toolbarrow__sort {
        margin-left: 0;
        width: 100%;
        justify-content: space-between;
    }
}
@media (max-width: 575.98px) {
    .baitalgahwa-mycourses-page {
        padding: 1.1rem 0.7rem 2.25rem;
    }
    .baitalgahwa-mycourses-catalog__grid {
        grid-template-columns: minmax(0, 1fr);
    }
    .baitalgahwa-mycourses-pagehead {
        flex-direction: column;
        align-items: stretch;
    }
    .baitalgahwa-mycourses-pagehead__actions {
        justify-content: stretch;
    }
    .baitalgahwa-mycourses-pagehead__actions .btn-manage,
    .baitalgahwa-mycourses-pagehead__actions .btn-create {
        flex: 1;
        text-align: center;
        justify-content: center;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_baitalgahwa/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}{{> theme_boost/courseindexdrawercontrols}}{{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}{{{courseindex}}}{{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}
    <div id="page" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-courseindex" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerindex, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                        {{#pix}} t/index_drawer, moodle {{/pix}}
                    </button>
                </div>
                {{/courseindex}}
                {{#hasblocks}}
                <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerblocks, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                        <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                        <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                    </button>
                </div>
                {{/hasblocks}}
            </div>
            {{{ output.full_header }}}
            <main class="baitalgahwa-mycourses-page" id="bag-mycourses-overview">
                <div class="baitalgahwa-mycourses-shell">
                    <header class="baitalgahwa-mycourses-pagehead">
                        <div class="baitalgahwa-mycourses-pagehead__text">
                            <p class="baitalgahwa-mycourses-pagehead__eyebrow">{{ dashboardwelcome }}</p>
                            <h1 class="baitalgahwa-mycourses-pagehead__title">{{#mycourses_title}}{{mycourses_title}}{{/mycourses_title}}{{^mycourses_title}}{{#str}}mycourses, moodle{{/str}}{{/mycourses_title}}</h1>
                        </div>
                        {{#mycourses_toolbar}}
                        <div class="baitalgahwa-mycourses-pagehead__actions" role="group" aria-label="{{#str}}mycourses_toolbar_aria, theme_baitalgahwa{{/str}}">
                            {{#canmanagecourses}}
                            <a href="{{{ managecourseurl }}}" class="btn-manage">{{{ managecoursetext }}}</a>
                            {{/canmanagecourses}}
                            {{#cancreatecourse}}
                            <a href="{{{ createcourseurl }}}" class="btn-create">{{{ createcoursetext }}}</a>
                            {{/cancreatecourse}}
                        </div>
                        {{/mycourses_toolbar}}
                    </header>

                    <div class="baitalgahwa-mycourses-tabs" role="tablist" aria-label="{{#str}}mycourses, moodle{{/str}}">
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="true" data-bag-mycourses-tab="all">{{#str}}mycourses_tab_all, theme_baitalgahwa{{/str}}</button>
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="false" data-bag-mycourses-tab="inprogress">{{#str}}mycourses_tab_inprogress, theme_baitalgahwa{{/str}}</button>
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="false" data-bag-mycourses-tab="starred">{{#str}}mycourses_tab_starred, theme_baitalgahwa{{/str}}</button>
                        <button type="button" class="baitalgahwa-mycourses-tabs__tab" role="tab" aria-selected="false" data-bag-mycourses-tab="removed">{{#str}}mycourses_tab_removed, theme_baitalgahwa{{/str}}</button>
                    </div>

                    <div class="baitalgahwa-mycourses-toolbarrow">
                        <label class="sr-only" for="bag-mycourses-search">{{#str}}mycourses_search_placeholder, theme_baitalgahwa{{/str}}</label>
                        <input id="bag-mycourses-search" class="baitalgahwa-mycourses-toolbarrow__search" type="search" data-bag-course-filter autocomplete="off" placeholder="{{#str}}mycourses_search_placeholder, theme_baitalgahwa{{/str}}">
                        <button type="button" class="baitalgahwa-mycourses-toolbarrow__btn"><i class="fa fa-sliders" aria-hidden="true"></i> {{#str}}mycourses_filter, theme_baitalgahwa{{/str}}</button>
                        <div class="baitalgahwa-mycourses-toolbarrow__sort">
                            <label for="bag-mycourses-sort">{{#str}}mycourses_sort_by, theme_baitalgahwa{{/str}}</label>
                            <select id="bag-mycourses-sort" aria-label="{{#str}}mycourses_sort_by, theme_baitalgahwa{{/str}}">
                                <option>{{#str}}mycourses_sort_latest, theme_baitalgahwa{{/str}}</option>
                            </select>
                        </div>
                        <button type="button" class="baitalgahwa-mycourses-toolbarrow__btn">{{#str}}mycourses_columns, theme_baitalgahwa{{/str}}</button>
                    </div>

                    {{#has_activity_courses}}
                    <ul class="baitalgahwa-mycourses-catalog__grid" role="list" aria-label="{{#str}}mycourses, moodle{{/str}}">
                        {{#activity_courses}}
                        <li class="baitalgahwa-mycourses-catalog__cell" role="listitem">
                            <article class="baitalgahwa-mycourses-card" data-bag-course-card data-search="{{fullname}}">
                                <div class="baitalgahwa-mycourses-card__media">
                                    {{#imageurl}}
                                    <div class="baitalgahwa-mycourses-card__image{{#programme_focus_gahwa}} baitalgahwa-mycourses-card__image--gahwa{{/programme_focus_gahwa}}" style="background-image:url('{{{ imageurl }}}');"></div>
                                    {{/imageurl}}
                                    {{^imageurl}}
                                    <div class="baitalgahwa-mycourses-card__image baitalgahwa-mycourses-card__image--placeholder"></div>
                                    {{/imageurl}}
                                    {{#isnew}}
                                    <span class="baitalgahwa-mycourses-card__badge">{{#str}}course_new, theme_baitalgahwa{{/str}}</span>
                                    {{/isnew}}
                                    {{^isnew}}
                                    <span class="baitalgahwa-mycourses-card__badge">{{#str}}mycourse_available, theme_baitalgahwa{{/str}}</span>
                                    {{/isnew}}
                                    <div class="baitalgahwa-mycourses-card__schedule">
                                        {{#has_card_schedule}}
                                            {{#card_starts_line}}<span><i class="fa fa-clock-o" aria-hidden="true"></i> {{ card_starts_line }}</span>{{/card_starts_line}}
                                            {{#card_ends_line}}<span><i class="fa fa-clock-o" aria-hidden="true"></i> {{ card_ends_line }}</span>{{/card_ends_line}}
                                        {{/has_card_schedule}}
                                        {{^has_card_schedule}}
                                            <span><i class="fa fa-calendar-o" aria-hidden="true"></i> {{#str}}mycourse_dates_hint, theme_baitalgahwa{{/str}}</span>
                                        {{/has_card_schedule}}
                                    </div>
                                </div>
                                <div class="baitalgahwa-mycourses-card__body">
                                    <h2 class="baitalgahwa-mycourses-card__title">{{ fullname }}</h2>
                                    {{#summary}}<p class="baitalgahwa-mycourses-card__copy">{{ summary }}</p>{{/summary}}
                                    <div class="baitalgahwa-mycourses-card__host">
                                        <span class="baitalgahwa-mycourses-card__host-avatar" aria-hidden="true"><i class="fa fa-user"></i></span>
                                        <span>{{ instructor_host }}</span>
                                    </div>
                                    <a class="baitalgahwa-mycourses-card__cta" href="{{{ url }}}">{{#str}}gotocourse, theme_baitalgahwa{{/str}}</a>
                                </div>
                            </article>
                        </li>
                        {{/activity_courses}}
                    </ul>
                    {{/has_activity_courses}}
                    {{^has_activity_courses}}
                    <section class="baitalgahwa-mycourses-panel">
                        <p class="baitalgahwa-mycourses-panel__body mb-0">{{#str}}nocourses, theme_baitalgahwa{{/str}}</p>
                    </section>
                    {{/has_activity_courses}}

                    <div class="row g-4 baitalgahwa-mycourses-secondary">
                        <div class="col-lg-5" id="bag-mycourses-calendar">
                            <section class="baitalgahwa-mycourses-panel h-100">
                                <div class="baitalgahwa-mycourses-section__header">
                                    <div>
