{{!
    @template theme_baitalgahwa/components/figma_dashboard_home
    Figma-inspired learning landing dashboard.
}}
<style>
body.bag-figma-user-dashboard .baitalgahwa-dashboard#bag-dashboard-overview {
    display: none !important;
}
body.bag-figma-user-dashboard #page,
body.bag-figma-user-dashboard #topofscroll,
body.bag-figma-user-dashboard .main-inner {
    margin-top: 0 !important;
    padding-top: 0 !important;
    background: #fffaf3;
}
body.bag-figma-user-dashboard #page.drawers {
    padding-top: 0 !important;
}
.bag-figma-home {
    --bag-brown: #7a4a22;
    --bag-brown-dark: #5f3616;
    --bag-gold: #c99d42;
    --bag-ink: #15110d;
    --bag-muted: #8d7f73;
    --bag-cream: #fffaf3;
    --bag-line: #eadfce;
    color: var(--bag-ink);
    background: var(--bag-cream);
    padding-top: 0;
    overflow: hidden;
}
.bag-figma-home__section {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 0 clamp(1rem, 2.5vw, 1.8rem);
}
.bag-figma-hero {
    position: relative;
    min-height: clamp(21rem, 45vw, 33.5rem);
    display: grid;
    place-items: center;
    color: #fff;
    text-align: center;
    isolation: isolate;
    overflow: hidden;
    background: #15110d;
}
.bag-figma-hero::before,
.bag-figma-hero::after {
    content: "";
    position: absolute;
    inset: 0;
}
.bag-figma-hero::before {
    z-index: -2;
    background: url('{{{ bag_home_hero_url }}}') center 47% / cover no-repeat;
    filter: grayscale(1) contrast(1.08) brightness(.74);
    transform: scale(1.015);
}
.bag-figma-hero::after {
    z-index: -1;
    background:
        linear-gradient(90deg, rgba(18, 15, 13, .46), rgba(18, 15, 13, .12) 48%, rgba(18, 15, 13, .5)),
        linear-gradient(180deg, rgba(18, 15, 13, .36), rgba(18, 15, 13, .64));
}
.bag-figma-hero__title {
    max-width: 43rem;
    margin: 3.3rem auto .85rem;
    color: #fff;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    line-height: 1.05;
    font-weight: 800;
    text-transform: uppercase;
}
.bag-figma-hero__copy {
    max-width: 34rem;
    margin: 0 auto 1.35rem;
    color: rgba(255,255,255,.88);
    font-size: clamp(.82rem, 1.4vw, 1rem);
    line-height: 1.55;
}
.bag-figma-hero__actions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    flex-wrap: wrap;
}
.bag-figma-btn {
    display: inline-flex;
    min-height: 2.28rem;
    align-items: center;
    justify-content: center;
    border-radius: .2rem;
    padding: .62rem 1.18rem;
    background: var(--bag-brown);
    color: #fff;
    font-weight: 700;
    font-size: .74rem;
    text-decoration: none;
    border: 1px solid var(--bag-brown);
    box-shadow: 0 .4rem 1rem rgba(90, 52, 20, .18);
    transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease, border-color .16s ease;
}
.bag-figma-btn--gold {
    min-width: 8.8rem;
    background: var(--bag-gold);
    border-color: var(--bag-gold);
    color: #3b2412;
}
.bag-figma-btn--outline {
    min-width: 8.8rem;
    background: rgba(122,74,34,.16);
    border-color: rgba(201,157,66,.95);
    color: #fff;
}
.bag-figma-btn:hover,
.bag-figma-btn:focus-visible {
    color: #fff;
    background: var(--bag-brown-dark);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 .7rem 1.4rem rgba(44, 24, 9, .22);
}
.bag-figma-btn--gold:hover,
.bag-figma-btn--gold:focus-visible {
    color: #2d1b0e;
    background: #d6ad52;
    border-color: #d6ad52;
}
.bag-figma-expertise {
    position: relative;
    margin-top: 0;
    z-index: 1;
    padding-top: clamp(3.6rem, 7vw, 6.5rem);
    padding-bottom: clamp(2.4rem, 4vw, 3.4rem);
}
.bag-figma-expertise__panel {
    display: grid;
    grid-template-columns: minmax(0, .98fr) minmax(18rem, 1.02fr);
    gap: clamp(2.1rem, 5.8vw, 6rem);
    align-items: center;
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0;
}
.bag-figma-collage {
    position: relative;
    min-height: clamp(17rem, 30vw, 24rem);
}
.bag-figma-collage__img {
    position: absolute;
    object-fit: cover;
    box-shadow: 0 .9rem 1.8rem rgba(40, 24, 12, .16);
}
.bag-figma-collage__img--one {
    width: 48%;
    height: 9rem;
    left: 0;
    top: 17%;
    border-radius: .85rem;
}
.bag-figma-collage__img--two {
    width: 44%;
    height: 12.2rem;
    right: 17%;
    top: 0;
    border-radius: .85rem;
}
.bag-figma-collage__img--three {
    width: 48%;
    height: 12.4rem;
    right: 0;
    bottom: 0;
    border-radius: .85rem;
}
.bag-figma-collage::before,
.bag-figma-collage::after {
    content: "";
    position: absolute;
    border: 1px solid #e6d7c6;
    pointer-events: none;
}
.bag-figma-collage::before {
    width: 5.3rem;
    height: 9.4rem;
    left: -1.4rem;
    top: .6rem;
}
.bag-figma-collage::after {
    width: 7rem;
    height: 5.5rem;
    right: 0;
    bottom: 1.6rem;
}
.bag-figma-kicker {
    margin: 0 0 .45rem;
    color: var(--bag-brown);
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
}
.bag-figma-title {
    margin: 0;
    color: #17120f;
    font-size: clamp(1.35rem, 3vw, 2.2rem);
    line-height: 1.08;
    font-weight: 800;
}
.bag-figma-copy {
    margin: .8rem 0 0;
    color: var(--bag-muted);
    font-size: .95rem;
    line-height: 1.7;
}
.bag-figma-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.75rem, 2.4vw, 1.7rem);
    margin-top: 1.65rem;
}
.bag-figma-metric {
    color: var(--bag-brown);
    text-align: center;
}
.bag-figma-metric__icon {
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 auto .65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #fff;
    color: var(--bag-gold);
    box-shadow: 0 .45rem 1rem rgba(60, 36, 18, .08);
}
.bag-figma-metric strong {
    display: block;
    color: var(--bag-gold);
    font-size: 1.7rem;
    line-height: 1;
    font-weight: 800;
}
.bag-figma-metric span {
    display: block;
    margin-top: .3rem;
    color: #6d5c4c;
    font-size: .78rem;
    font-weight: 700;
}
.bag-figma-programmes {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    text-align: center;
    background: #fffaf3;
}
.bag-figma-programmes .bag-figma-copy {
    max-width: 48rem;
    margin-inline: auto;
}
.bag-figma-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.1vw, 1.65rem);
    margin-top: 2.15rem;
    text-align: left;
}
.bag-figma-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid #eadfce;
    border-radius: .55rem;
    box-shadow: 0 .55rem 1.05rem rgba(49, 31, 16, .12);
    transition: transform .18s ease, box-shadow .18s ease;
}
.bag-figma-card:hover,
.bag-figma-card:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 1rem 1.8rem rgba(49, 31, 16, .15);
}
.bag-figma-card__media {
    position: relative;
    overflow: hidden;
}
.bag-figma-card__image {
    width: 100%;
    aspect-ratio: 1.42;
    object-fit: cover;
    display: block;
}
.bag-figma-card__status {
    position: absolute;
    top: .85rem;
    left: .85rem;
    z-index: 1;
    min-width: 5.3rem;
    padding: .27rem .7rem;
    border-radius: 999px;
    background: rgba(255,255,255,.95);
    color: var(--bag-brown);
    font-size: .62rem;
    font-weight: 800;
    text-align: center;
}
.bag-figma-card__dates {
    position: absolute;
    left: .8rem;
    right: .8rem;
    bottom: .75rem;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: .45rem;
}
.bag-figma-card__date {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    border-radius: 999px;
    padding: .32rem .48rem;
    background: rgba(255,255,255,.94);
    color: #6d5c4c;
    font-size: .58rem;
    font-weight: 800;
    line-height: 1;
}
.bag-figma-card__body {
    padding: 1.05rem 1rem .9rem;
}
.bag-figma-card__title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
}
.bag-figma-card__text {
    margin: .55rem 0 .9rem;
    color: #8a8178;
    font-size: .78rem;
    line-height: 1.55;
}
.bag-figma-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    padding-top: .55rem;
    border-top: 1px solid #eee4d9;
    color: var(--bag-brown);
    font-size: .7rem;
    font-weight: 700;
}
.bag-figma-card__host {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: .5rem;
}
.bag-figma-card__avatar {
    width: 1.85rem;
    height: 1.85rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #f3e7d9;
    color: var(--bag-brown);
}
.bag-figma-card__pill {
    flex: 0 0 auto;
    border-radius: .35rem;
    padding: .38rem .65rem;
    background: var(--bag-brown);
    color: #fff;
    font-size: .62rem;
    font-weight: 800;
}
.bag-figma-card__action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: .85rem;
    padding-top: .8rem;
    border-top: 1px solid #eee4d9;
    color: var(--bag-brown);
    font-size: .68rem;
    font-weight: 700;
    text-decoration: none;
}
.bag-figma-card__action:hover,
.bag-figma-card__action:focus-visible {
    color: var(--bag-brown-dark);
    text-decoration: none;
}
.bag-figma-more {
    margin-top: 1.8rem;
}
.bag-figma-development {
    background: #f1f3ec;
    padding-block: clamp(3.4rem, 7vw, 6.3rem);
}
.bag-figma-development__inner {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(19rem, 1.05fr);
    gap: clamp(2rem, 6vw, 5.3rem);
    align-items: center;
}
.bag-figma-checks {
    display: grid;
    gap: .7rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
    color: #75685d;
    font-size: .9rem;
}
.bag-figma-checks li {
    display: flex;
    gap: .55rem;
    align-items: flex-start;
}
.bag-figma-checks i {
    color: var(--bag-brown);
    margin-top: .18rem;
}
.bag-figma-development__imagewrap {
    position: relative;
}
.bag-figma-development__image {
    width: 100%;
    max-height: 31rem;
    object-fit: cover;
    display: block;
}
.bag-figma-cta {
    padding-block: clamp(2.1rem, 4vw, 3.2rem);
}
.bag-figma-cta__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .85rem;
    text-align: center;
    background: var(--bag-brown);
    color: #fff;
    border-radius: 1rem;
    padding: clamp(1.8rem, 4vw, 3rem) 1rem;
}
.bag-figma-cta__title {
    margin: 0;
    color: #fff;
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 800;
    text-transform: uppercase;
}
.bag-figma-cta .bag-figma-btn {
    background: #fff4e7;
    color: var(--bag-brown);
    border-color: #fff4e7;
}
.bag-figma-cta__copy {
    margin: -.35rem 0 .3rem;
    color: rgba(255,255,255,.82);
    font-size: .82rem;
}
@media (max-width: 991.98px) {
    .bag-figma-home__section {
        padding-inline: .9rem;
    }
    .bag-figma-expertise__panel,
    .bag-figma-development__inner {
        grid-template-columns: 1fr;
    }
    .bag-figma-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 575.98px) {
    .bag-figma-home {
        padding-top: 0;
    }
    .bag-figma-hero {
        min-height: 21rem;
        align-items: start;
        padding-top: 5.1rem;
        padding-bottom: 2.2rem;
    }
    .bag-figma-hero::before {
        background-position: center top;
    }
    .bag-figma-hero__title {
        margin-top: 0;
        max-width: 18rem;
        font-size: clamp(1.55rem, 8vw, 2.15rem);
    }
    .bag-figma-hero__copy {
        max-width: 19rem;
        font-size: .82rem;
    }
    .bag-figma-expertise {
        margin-top: 0;
        padding-top: 2.2rem;
    }
    .bag-figma-expertise__panel {
        padding: 1.15rem;
        box-shadow: none;
        border-inline: 0;
    }
    .bag-figma-collage {
        min-height: 13.25rem;
        max-width: 20rem;
        margin-inline: auto;
    }
    .bag-figma-collage::before {
        left: 0;
    }
    .bag-figma-collage::after {
        right: .6rem;
    }
    .bag-figma-title {
        font-size: 1.45rem;
    }
    .bag-figma-copy {
        font-size: .84rem;
        line-height: 1.65;
    }
    .bag-figma-grid,
    .bag-figma-metrics {
        grid-template-columns: 1fr;
    }
    .bag-figma-card__dates {
        flex-direction: column;
        align-items: flex-start;
        right: auto;
    }
    .bag-figma-metrics {
        gap: .75rem;
    }
    .bag-figma-programmes {
        padding-top: 2rem;
    }
    .bag-figma-grid {
        gap: 1rem;
    }
    .bag-figma-development__inner {
        gap: 1.2rem;
    }
    .bag-figma-development__image {
        max-height: 18rem;
    }
    .bag-figma-cta {
        padding-block: 1.4rem;
    }
}
</style>
<main class="bag-figma-home" id="bag-figma-dashboard-home">
    <section class="bag-figma-hero" aria-labelledby="bag-figma-hero-title">
        <div class="bag-figma-home__section">
            <h1 class="bag-figma-hero__title" id="bag-figma-hero-title">Empower Your Future With Excellence</h1>
            <p class="bag-figma-hero__copy">Join Bait Al Gahwa's premium training programs and unlock your potential through world-class education inspired by Emirati heritage.</p>
            <div class="bag-figma-hero__actions">
                <a class="bag-figma-btn bag-figma-btn--gold" href="{{{ config.coursetodo }}}">Explore Course</a>
                <a class="bag-figma-btn bag-figma-btn--outline" href="{{{ config.signupurl }}}">Register</a>
            </div>
        </div>
    </section>

    <section class="bag-figma-expertise bag-figma-home__section" aria-labelledby="bag-figma-expertise-title">
        <div class="bag-figma-expertise__panel">
            <div class="bag-figma-collage" aria-hidden="true">
                <img class="bag-figma-collage__img bag-figma-collage__img--one" src="{{{ bag_home_coffee_url }}}" alt="" loading="lazy">
                <img class="bag-figma-collage__img bag-figma-collage__img--two" src="{{{ bag_home_hero_url }}}" alt="" loading="lazy">
                <img class="bag-figma-collage__img bag-figma-collage__img--three" src="{{{ bag_home_activity_url }}}" alt="" loading="lazy">
            </div>
            <div>
                <p class="bag-figma-kicker">Expertise Across All Disciplines</p>
                <h2 class="bag-figma-title" id="bag-figma-expertise-title">Practical Learning For Every Professional Path</h2>
                <p class="bag-figma-copy">Our programmes blend hands-on training, cultural detail, and guided practice so learners can grow with clarity and confidence.</p>
                <div class="bag-figma-metrics" role="list">
                    <span class="bag-figma-metric" role="listitem"><span class="bag-figma-metric__icon"><i class="fa fa-trophy" aria-hidden="true"></i></span><strong>500+</strong><span>Certified Graduates</span></span>
                    <span class="bag-figma-metric" role="listitem"><span class="bag-figma-metric__icon"><i class="fa fa-book" aria-hidden="true"></i></span><strong>20+</strong><span>Training Programs</span></span>
                    <span class="bag-figma-metric" role="listitem"><span class="bag-figma-metric__icon"><i class="fa fa-user-o" aria-hidden="true"></i></span><strong>50+</strong><span>Expert Instructors</span></span>
                </div>
            </div>
        </div>
    </section>

    <section class="bag-figma-programmes bag-figma-home__section" aria-labelledby="bag-figma-programmes-title">
        <h2 class="bag-figma-title" id="bag-figma-programmes-title">Our Training Programmes</h2>
        <p class="bag-figma-copy">Our hands-on programmes explore the history, techniques and rituals of Gahwa. Whether you're passionate about heritage or want to deepen your skills, each session offers a rich, immersive experience guided by seasoned experts.</p>
        {{#has_dashboard_home_programmes}}
        <div class="bag-figma-grid" role="list">
            {{#dashboard_home_programmes}}
            <article class="bag-figma-card" role="listitem">
                <div class="bag-figma-card__media">
                    <span class="bag-figma-card__status">Available</span>
                    {{#imageurl}}<img class="bag-figma-card__image" src="{{{ imageurl }}}" alt="" loading="lazy">{{/imageurl}}
                    {{^imageurl}}<img class="bag-figma-card__image" src="{{{ bag_home_hero_url }}}" alt="" loading="lazy">{{/imageurl}}
                    <div class="bag-figma-card__dates">
                        <span class="bag-figma-card__date">It starts on 11/02/2026</span>
                        <span class="bag-figma-card__date"><i class="fa fa-clock-o" aria-hidden="true"></i>It end on 11/03/2026</span>
                    </div>
                </div>
                <div class="bag-figma-card__body">
                    <h3 class="bag-figma-card__title">{{ fullname }}</h3>
                    {{#summary}}<p class="bag-figma-card__text">{{ summary }}</p>{{/summary}}
                    {{^summary}}<p class="bag-figma-card__text">Guided training designed to build practical skills through immersive learning.</p>{{/summary}}
                    <div class="bag-figma-card__meta">
                        <span class="bag-figma-card__host"><span class="bag-figma-card__avatar"><i class="fa fa-user-circle-o" aria-hidden="true"></i></span><span>{{#categoryname}}{{ categoryname }}{{/categoryname}}{{^categoryname}}Gahwa Specialist,<br>Bait Al Gahwa Host{{/categoryname}}</span></span>
                        <span class="bag-figma-card__pill">Men and women</span>
                    </div>
                    <a class="bag-figma-card__action" href="{{{ url }}}"><span><i class="fa fa-long-arrow-left" aria-hidden="true"></i> The details</span><span>Fees are free</span></a>
                </div>
            </article>
            {{/dashboard_home_programmes}}
        </div>
        {{/has_dashboard_home_programmes}}
        {{^has_dashboard_home_programmes}}
        <p class="bag-figma-copy">{{#str}}nocourses, theme_baitalgahwa{{/str}}</p>
        {{/has_dashboard_home_programmes}}
        <div class="bag-figma-more">
            <a class="bag-figma-btn" href="{{{ config.coursetodo }}}">View All</a>
        </div>
    </section>

    <section class="bag-figma-development">
        <div class="bag-figma-home__section bag-figma-development__inner">
            <div>
                <p class="bag-figma-kicker">Professional Development</p>
                <h2 class="bag-figma-title">Excellence In Professional Development</h2>
                <p class="bag-figma-copy">Bait Al Gahwa is committed to fostering professional excellence through comprehensive training programs that blend traditional values with modern expertise.</p>
                <ul class="bag-figma-checks">
                    <li><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>World-class curriculum designed by industry experts</span></li>
                    <li><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>Flexible learning options for busy professionals</span></li>
                    <li><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>Industry-recognized certifications</span></li>
                    <li><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>Ongoing support and career guidance</span></li>
                </ul>
            </div>
            <div class="bag-figma-development__imagewrap">
                <img class="bag-figma-development__image" src="{{{ bag_home_member_url }}}" alt="" loading="lazy">
            </div>
        </div>
    </section>

    <section class="bag-figma-cta bag-figma-home__section">
        <div class="bag-figma-cta__panel">
            <h2 class="bag-figma-cta__title">Ready To Begin Your Journey?</h2>
            <p class="bag-figma-cta__copy">Join hundreds of professionals who have transformed their careers through our training programs</p>
            <a class="bag-figma-btn" href="{{{ config.signupurl }}}">Register for a Course</a>
        </div>
    </section>
</main>
