{{!
    @template theme_baitalgahwa/programme
    Public programme detail page opened from Training Programme cards.
}}
{{> theme_boost/head }}
<style>
body.bag-programme-body {
    background: #f4eee5;
}
body.bag-programme-body #page-header,
body.bag-programme-body .secondary-navigation {
    display: none;
}
body.bag-programme-body #page,
body.bag-programme-body #topofscroll,
body.bag-programme-body .main-inner {
    margin-top: 0 !important;
    padding-top: 0 !important;
    background: #f4eee5;
}
body.bag-programme-body #page.drawers {
    padding-top: 0 !important;
}
.bag-programme-page {
    --bag-brown: #76461f;
    --bag-brown-deep: #623714;
    --bag-gold: #d4b761;
    --bag-cream: #f4eee5;
    --bag-soft: #fff7f1;
    min-height: 100vh;
    background: var(--bag-cream);
    color: #15110d;
    overflow: hidden;
}
.bag-programme-hero {
    position: relative;
    isolation: isolate;
    background: var(--bag-brown);
    padding: 86px 0 58px;
    color: #fff;
}
.bag-programme-hero::before {
    content: "";
    position: absolute;
    left: -118px;
    top: 112px;
    width: 360px;
    height: 360px;
    background: url('{{{ footerflowerurl }}}') center / contain no-repeat;
    opacity: .17;
    pointer-events: none;
    z-index: -1;
}
.bag-programme-section {
    width: min(calc(100% - 2rem), 1190px);
    margin: 0 auto;
}
.bag-programme-layout {
    display: grid;
    grid-template-columns: 370px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
}
.bag-programme-card {
    overflow: hidden;
    border-radius: 7px;
    background: #fff;
    color: #19110c;
    box-shadow: 0 12px 24px rgba(41, 22, 8, .2);
}
.bag-programme-card__media {
    position: relative;
    height: 500px;
    overflow: hidden;
}
.bag-programme-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}
.bag-programme-badge {
    position: absolute;
    top: 12px;
    left: 14px;
    min-width: 58px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bag-soft);
    color: var(--bag-brown);
    font-size: 11px;
    line-height: 1;
    font-weight: 800;
    text-align: center;
}
.bag-programme-card__fee {
    padding: 13px 14px 10px;
    color: var(--bag-brown);
    text-align: center;
    font-size: 12px;
    font-weight: 800;
}
.bag-programme-enrol {
    display: flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    margin: 0 12px 9px;
    border-radius: 4px;
    background: var(--bag-brown);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
}
.bag-programme-enrol:hover,
.bag-programme-enrol:focus-visible {
    color: #fff;
    background: var(--bag-brown-deep);
    text-decoration: none;
}
.bag-programme-card__seats {
    padding: 0 14px 14px;
    color: #7e7167;
    text-align: center;
    font-size: 10px;
    font-weight: 700;
}
.bag-programme-copy {
    padding-top: 10px;
}
.bag-programme-title {
    margin: 0 0 8px;
    color: #fff;
    font-size: clamp(2rem, 4.6vw, 42px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: 0;
}
.bag-programme-summary {
    max-width: 390px;
    margin: 0 0 16px;
    color: rgba(255,255,255,.9);
    font-size: 12px;
    line-height: 1.55;
}
.bag-programme-dates {
    display: inline-flex;
    gap: 16px;
    max-width: 100%;
    border-radius: 999px;
    background: var(--bag-soft);
    color: var(--bag-brown);
    padding: 8px 17px;
    font-size: 10px;
    font-weight: 800;
}
.bag-programme-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    max-width: 428px;
    margin-top: 24px;
}
.bag-programme-fact span {
    display: block;
    color: #d7bd86;
    font-size: 13px;
    font-weight: 800;
}
.bag-programme-fact strong {
    display: block;
    margin-top: 7px;
    color: #fff;
    font-size: 16px;
    line-height: 1;
    font-weight: 800;
}
.bag-programme-host {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
}
.bag-programme-host__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
}
.bag-programme-host__name {
    display: block;
    color: #fff;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 800;
}
.bag-programme-host__role {
    display: block;
    margin-top: 3px;
    color: rgba(255,255,255,.82);
    font-size: 11px;
}
.bag-programme-learn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    margin-inline-start: 14px;
    padding: 9px 19px;
    border-radius: 4px;
    background: var(--bag-soft);
    color: var(--bag-brown);
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
}
.bag-programme-learn:hover,
.bag-programme-learn:focus-visible {
    color: var(--bag-brown-deep);
    background: #fff;
    text-decoration: none;
}
.bag-programme-main {
    padding: 0 0 70px;
}
.bag-programme-main__grid {
    display: grid;
    grid-template-columns: 370px minmax(0, 1fr);
    gap: 48px;
}
.bag-programme-outcomes {
    margin-top: -112px;
    align-self: start;
    position: relative;
    z-index: 1;
}
.bag-programme-outcomes__title {
    margin: 0 0 13px;
    border-radius: 4px;
    background: var(--bag-gold);
    color: #654018;
    padding: 16px 18px;
    font-size: 13px;
    font-weight: 800;
}
.bag-programme-outcome {
    margin: 0 0 10px;
    border-radius: 999px;
    background: #fff;
    color: #5e524a;
    padding: 11px 17px;
    box-shadow: 0 8px 18px rgba(60, 38, 20, .07);
    font-size: 11px;
    line-height: 1.45;
}
.bag-programme-spacer {
    min-height: 1px;
}
@media (max-width: 767.98px) {
    .bag-programme-hero {
        padding-top: 72px;
    }
    .bag-programme-section {
        width: min(calc(100% - 1.25rem), 1190px);
    }
    .bag-programme-layout,
    .bag-programme-main__grid {
        grid-template-columns: 1fr;
    }
    .bag-programme-card__media {
        height: 280px;
    }
    .bag-programme-outcomes {
        margin-top: 28px;
    }
    .bag-programme-facts {
        grid-template-columns: 1fr;
        gap: 14px;
    }
    .bag-programme-learn {
        margin-inline-start: 0;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_baitalgahwa/navbar }}
    <div id="page" data-region="mainpage" class="drawers drag-container">
        <div id="topofscroll" class="main-inner">
            <main class="bag-programme-page" id="bag-programme-main">
                <section class="bag-programme-hero">
                    <div class="bag-programme-section bag-programme-layout">
                        <aside class="bag-programme-card">
                            <div class="bag-programme-card__media">
                                {{#programme.imageurl}}<img class="bag-programme-card__image" src="{{{ programme.imageurl }}}" alt="" loading="lazy">{{/programme.imageurl}}
                                <span class="bag-programme-badge">{{#programme.isnew}}New{{/programme.isnew}}{{^programme.isnew}}Available{{/programme.isnew}}</span>
                            </div>
                            <div class="bag-programme-card__fee">{{ programme.fee_line }}</div>
                            <a class="bag-programme-enrol" href="{{{ programme.enrolurl }}}">Enroll Now</a>
                            <div class="bag-programme-card__seats">{{ programme.seat_line }}</div>
                        </aside>

                        <div class="bag-programme-copy">
                            <h1 class="bag-programme-title">{{ programme.fullname }}</h1>
                            <p class="bag-programme-summary">{{ programme.summary }}</p>
                            <div class="bag-programme-dates">
                                <span>{{#programme.startdate_display}}It starts on {{ programme.startdate_display }}{{/programme.startdate_display}}{{^programme.startdate_display}}Starts soon{{/programme.startdate_display}}</span>
                                <span>{{#programme.enddate_display}}It end on {{ programme.enddate_display }}{{/programme.enddate_display}}{{^programme.enddate_display}}Open track{{/programme.enddate_display}}</span>
                            </div>
                            <div class="bag-programme-facts">
                                <div class="bag-programme-fact"><span>Duration</span><strong>{{ programme.duration }}</strong></div>
                                <div class="bag-programme-fact"><span>Languages</span><strong>{{ programme.languages }}</strong></div>
                                <div class="bag-programme-fact"><span>Location</span><strong>{{ programme.location }}</strong></div>
                            </div>
                            <div class="bag-programme-host">
                                {{#programme.imageurl}}<img class="bag-programme-host__avatar" src="{{{ programme.imageurl }}}" alt="" loading="lazy">{{/programme.imageurl}}
                                <span>
                                    <span class="bag-programme-host__name">{{ programme.instructor_host }}</span>
                                    <span class="bag-programme-host__role">Out of Gahwa Host</span>
                                </span>
                                <a class="bag-programme-learn" href="{{{ programme.learnurl }}}">Learn and access</a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bag-programme-main">
                    <div class="bag-programme-section bag-programme-main__grid">
                        <div class="bag-programme-spacer" aria-hidden="true"></div>
                        <div class="bag-programme-outcomes">
                            <h2 class="bag-programme-outcomes__title">Program Outcome</h2>
                            {{#programme_outcomes}}
                            <p class="bag-programme-outcome">{{ text }}</p>
                            {{/programme_outcomes}}
                        </div>
                    </div>
                </section>
            </main>
        </div>
        {{> theme_baitalgahwa/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer', 'theme_baitalgahwa/theme'], function(Loader, Drawer, Bait) {
    Drawer.init();
    Bait.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
