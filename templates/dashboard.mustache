{{!
    @template theme_baitalgahwa/dashboard
    Logged-in dashboard landing shown on /my/.
}}
{{> theme_boost/head }}
<style>
body.pagelayout-mydashboard .main-inner,
body#page-my-index .main-inner {
    background: #fcfaf7;
}
body.pagelayout-mydashboard #page-header,
body#page-my-index #page-header,
body.pagelayout-mydashboard .secondary-navigation,
body#page-my-index .secondary-navigation {
    display: none;
}
body.pagelayout-mydashboard #page.drawers,
body#page-my-index #page.drawers,
body.pagelayout-mydashboard #topofscroll.main-inner,
body#page-my-index #topofscroll.main-inner {
    max-width: 100%;
    width: 100%;
}
.baitalgahwa-dashboard {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 1.5rem 1.25rem 3.5rem;
    color: #241b15;
}
.baitalgahwa-dashboard-shell {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    width: min(100%, 1320px);
    margin: 0 auto;
}
.baitalgahwa-dashboard-title {
    margin: 0;
    color: #201813;
    font-size: 1.05rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-panel,
.baitalgahwa-dashboard-stats,
.baitalgahwa-dashboard-programme,
.baitalgahwa-dashboard-widget,
.baitalgahwa-dashboard-members-panel,
.baitalgahwa-dashboard-todo,
.baitalgahwa-dashboard-newsletter {
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.2rem;
    box-shadow: 0 .85rem 2rem rgba(48, 27, 12, .05);
}
.baitalgahwa-dashboard-panel {
    padding: 1.75rem;
}
.baitalgahwa-dashboard-stats {
    overflow: hidden;
}
.baitalgahwa-dashboard-stat {
    display: flex;
    align-items: center;
    gap: .95rem;
    padding: 1rem 1.15rem;
    min-height: 100%;
}
.baitalgahwa-dashboard-stat__icon {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: .6rem;
    color: #8a5a2b;
    background: rgba(138, 90, 43, .09);
}
.baitalgahwa-dashboard-stat__value {
    color: #8a5a2b;
    font-size: 1.65rem;
    line-height: 1;
    font-weight: 800;
}
.baitalgahwa-dashboard-stat__label {
    margin-top: .25rem;
    color: #7c7268;
    font-size: .82rem;
}
.baitalgahwa-dashboard-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .2rem;
}
.baitalgahwa-dashboard-section-title {
    margin: 0;
    color: #201813;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -.02em;
}
.baitalgahwa-dashboard-section-copy {
    margin: .35rem 0 0;
    color: #7c7268;
    font-size: .88rem;
    line-height: 1.65;
}
.baitalgahwa-dashboard-programmes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
}
@media (max-width: 1199.98px) {
    .baitalgahwa-dashboard-programmes {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 575.98px) {
    .baitalgahwa-dashboard-programmes {
        grid-template-columns: minmax(0, 1fr);
    }
}
.baitalgahwa-dashboard-programme {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
}
.baitalgahwa-dashboard-panel--programmes {
    margin-top: .25rem;
}
.baitalgahwa-dashboard-panel--programmes .baitalgahwa-dashboard-section-head {
    justify-content: center;
    text-align: center;
    margin-bottom: 1.5rem;
}
.baitalgahwa-dashboard-panel--programmes .baitalgahwa-dashboard-section-copy {
    max-width: 46rem;
    margin: .65rem auto 0;
    font-size: .92rem;
}
.baitalgahwa-dashboard-programme:hover,
.baitalgahwa-dashboard-programme:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 1rem 2rem rgba(48, 27, 12, .1);
}
.baitalgahwa-dashboard-programme__media {
    position: relative;
    padding: .75rem .75rem 0;
}
.baitalgahwa-dashboard-programme__image {
    height: 7.25rem;
    border-radius: .85rem;
    background-size: cover;
    background-position: center;
}
.baitalgahwa-dashboard-programme__image--gahwa {
    background-position: 58% 42%;
}
.baitalgahwa-dashboard-programme__image--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .24), transparent 20rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-dashboard-programme__badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    z-index: 1;
    padding: .26rem .65rem;
    border-radius: 999px;
    background: rgba(255,255,255,.95);
    color: #8a5a2b;
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
}
.baitalgahwa-dashboard-programme__body {
    display: flex;
    flex-direction: column;
    gap: .7rem;
    flex: 1 1 auto;
    padding: 1rem 1rem 1.1rem;
}
.baitalgahwa-dashboard-programme__dates {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
}
.baitalgahwa-dashboard-programme__date-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    border-radius: 999px;
    padding: .3rem .6rem;
    background: #f6f1eb;
    color: #6a5c4b;
    font-size: .68rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-programme__title {
    margin: 0;
    color: #201813;
    font-size: .92rem;
    font-weight: 700;
    line-height: 1.35;
}
.baitalgahwa-dashboard-programme__copy {
    margin: 0;
    color: #7c7268;
    font-size: .78rem;
    line-height: 1.55;
    min-height: 3.1rem;
}
.baitalgahwa-dashboard-programme__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-top: auto;
    color: #8a5a2b;
    font-size: .78rem;
    font-weight: 600;
}
.baitalgahwa-dashboard-programme__meta-label {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-width: 0;
}
.baitalgahwa-dashboard-programme__meta-label span:last-child {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.baitalgahwa-dashboard-programme__meta-arrow {
    color: #8a5a2b;
}
.baitalgahwa-dashboard-progress,
.baitalgahwa-dashboard-members-panel,
.baitalgahwa-dashboard-todo,
.baitalgahwa-dashboard-newsletter {
    padding: 1.35rem 1.45rem;
}
.baitalgahwa-dashboard-members-panel__footer {
    margin-top: 1.35rem;
    text-align: center;
}
.baitalgahwa-dashboard-members-panel__viewall {
    color: #8a5a2b;
    font-size: .88rem;
    font-weight: 700;
    text-decoration: none;
}
.baitalgahwa-dashboard-members-panel__viewall:hover {
    text-decoration: underline;
}
.baitalgahwa-dashboard-progress__table {
    margin: 0;
    width: 100%;
}
.baitalgahwa-dashboard-progress__table th {
    padding: .7rem .75rem;
    color: #6e6154;
    font-size: .8rem;
    font-weight: 700;
    border-bottom: 1px solid #ede4da;
    white-space: nowrap;
}
.baitalgahwa-dashboard-progress__table td {
    padding: .85rem .75rem;
    font-size: .84rem;
    border-bottom: 1px solid #f3ece5;
    vertical-align: middle;
}
.baitalgahwa-dashboard-progress__course {
    display: flex;
    align-items: center;
    gap: .75rem;
    min-width: 15rem;
}
.baitalgahwa-dashboard-progress__thumb {
    width: 2.85rem;
    height: 2.2rem;
    flex: 0 0 auto;
    border-radius: .55rem;
    background-size: cover;
    background-position: center;
    background-color: #f4ece4;
}
.baitalgahwa-dashboard-progress__thumb--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .2), transparent 8rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-dashboard-status {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: .28rem .7rem;
    font-size: .72rem;
    font-weight: 700;
    background: #f5efe8;
    color: #7b6043;
}
.baitalgahwa-dashboard-progress__bar {
    position: relative;
    width: 100%;
    height: .5rem;
    border-radius: 999px;
    background: #efe5db;
    overflow: hidden;
}
.baitalgahwa-dashboard-progress__bar span {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #8a5a2b, #b98651);
}
.baitalgahwa-dashboard-widget {
    padding: 1.25rem 1.3rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-sizing: border-box;
}
.baitalgahwa-dashboard-widget__title {
    margin: 0;
    color: #201813;
    font-size: 1rem;
    font-weight: 800;
}
.baitalgahwa-dashboard-widget__sub {
    margin: .3rem 0 0;
    color: #7c7268;
    font-size: .78rem;
}
.baitalgahwa-dashboard-widget__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: .9rem;
    flex-wrap: wrap;
}
.baitalgahwa-dashboard-widget__titlegroup {
    min-width: 0;
}
.baitalgahwa-dashboard-widget__controls {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    align-items: center;
    padding-bottom: 1.05rem;
}
.baitalgahwa-dashboard-widget__calendar-head {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: .25rem;
    width: 100%;
}
.baitalgahwa-dashboard-widget__calendar-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .65rem;
    width: 100%;
}
.baitalgahwa-dashboard-widget__calendar-title-row .baitalgahwa-dashboard-widget__title {
    margin: 0;
    flex: 0 1 auto;
    min-width: 0;
}
.baitalgahwa-dashboard-widget__calendar-title-row .baitalgahwa-dashboard-widget__button {
    flex: 0 0 auto;
    align-self: center;
}
.baitalgahwa-dashboard-widget__calendar-head .baitalgahwa-dashboard-widget__sub {
    margin: 0;
    padding: 0;
}
.baitalgahwa-dashboard-widget__calendar-filters {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    width: 100%;
    align-items: center;
}
.baitalgahwa-dashboard-widget__calendar-filters select {
    flex: 1 1 46%;
    min-width: 0;
}
.baitalgahwa-dashboard-widget--calendar .baitalgahwa-dashboard-widget__controls--actions {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: .45rem;
    width: 100%;
    align-items: stretch;
    justify-content: stretch;
    margin-top: .35rem !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
}
.baitalgahwa-dashboard-widget--calendar .baitalgahwa-dashboard-widget__controls--actions .baitalgahwa-dashboard-widget__button {
    flex: 1 1 0;
    min-width: 0;
    width: 0;
    text-align: center;
    white-space: normal;
    line-height: 1.25;
}
.baitalgahwa-dashboard-widget__controls--quiz {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
}
.baitalgahwa-dashboard-widgets-row > [class*="col-"] {
    display: flex;
    min-width: 0;
}
.baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
}
.baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget__top {
    width: 100%;
    max-width: 100%;
    min-width: 0;
}
@media (min-width: 992px) {
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget__top {
        flex-wrap: wrap;
        align-items: flex-start;
        row-gap: .65rem;
    }
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget .baitalgahwa-dashboard-donut {
        flex: 0 0 auto;
        align-self: center;
        margin-top: .35rem;
        margin-bottom: .35rem;
    }
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget .baitalgahwa-dashboard-calendar {
        flex: 1 1 auto;
    }
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget .baitalgahwa-dashboard-bars {
        flex: 1 1 auto;
        min-height: 11rem;
    }
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget > .baitalgahwa-dashboard-widget__footer,
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget > .baitalgahwa-dashboard-widget__controls--actions {
        margin-top: auto;
    }
    .baitalgahwa-dashboard-widgets-row .baitalgahwa-dashboard-widget > .baitalgahwa-dashboard-bars__legend {
        margin-top: auto;
    }
}
.baitalgahwa-dashboard-widget__controls--actions {
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: .5rem;
    width: 100%;
}
.baitalgahwa-dashboard-widget__selectwrap {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    min-width: 7.4rem;
}
.baitalgahwa-dashboard-widget__footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: .9rem;
    flex-wrap: wrap;
}
.baitalgahwa-dashboard-widget__label {
    color: #4f453d;
    font-size: .76rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-widget select {
    min-width: 7rem;
    border: 1px solid #dfd1c3;
    border-radius: .7rem;
    background: #fff;
    min-height: 2.35rem;
    padding: .52rem 1.85rem .52rem .72rem;
    color: #2a1d14;
    font-size: .74rem;
    box-shadow: none;
}
.baitalgahwa-dashboard-widget__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.35rem;
    padding: .52rem .92rem;
    border-radius: .7rem;
    border: 1px solid #8a5a2b;
    background: #8a5a2b;
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
}
.baitalgahwa-dashboard-widget__button--ghost {
    background: #fff;
    color: #8a5a2b;
}
.baitalgahwa-dashboard-donut {
    width: 11rem;
    height: 11rem;
    min-width: 11rem;
    min-height: 11rem;
    margin: .35rem auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bag-donut, conic-gradient(#e8e0d8 0deg 360deg));
    position: relative;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    box-sizing: border-box;
}
.baitalgahwa-dashboard-donut::before {
    content: "";
    position: absolute;
    inset: 1.15rem;
    background: #fff;
    border-radius: 50%;
}
.baitalgahwa-dashboard-donut__center {
    position: relative;
    z-index: 1;
    text-align: center;
}
.baitalgahwa-dashboard-donut__count {
    color: #8a5a2b;
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
}
.baitalgahwa-dashboard-donut__label {
    margin-top: .3rem;
    color: #7c7268;
    font-size: .7rem;
    line-height: 1.35;
}
.baitalgahwa-dashboard-legend {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem 1rem;
    justify-content: center;
    font-size: .74rem;
    color: #5f5448;
}
.baitalgahwa-dashboard-legend__item {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
}
.baitalgahwa-dashboard-legend__dot {
    width: .55rem;
    height: .55rem;
    border-radius: 999px;
    display: inline-block;
}
.baitalgahwa-dashboard-calendar {
    margin-top: .05rem;
    margin-bottom: 0;
    width: 100%;
}
.baitalgahwa-dashboard-calendar th {
    padding: .45rem .2rem;
    border: 0;
    color: #61574f;
    font-size: .72rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-calendar td {
    padding: .26rem .2rem;
    border: 0;
}
.baitalgahwa-dashboard-calendar__day {
    min-width: 1.95rem;
    line-height: 1.95rem;
    display: inline-block;
    border-radius: 999px;
    color: #4f453d;
}
.baitalgahwa-dashboard-calendar__today {
    background: #8a5a2b;
    color: #fff;
    font-weight: 700;
}
.baitalgahwa-dashboard-calendar__day--has-event {
    box-shadow: inset 0 0 0 1px rgba(138, 90, 43, .25);
    background: #f8f1e9;
}
.baitalgahwa-dashboard-bars {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: .6rem;
    height: 11.2rem;
    padding: 1rem .65rem .35rem;
    border: 1px solid #eee2d8;
    border-radius: 1rem;
    background:
        linear-gradient(to top, rgba(111, 78, 55, .08) 1px, transparent 1px) 0 0 / 100% 25%,
        #fff;
}
.baitalgahwa-dashboard-bars__item {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .45rem;
}
.baitalgahwa-dashboard-bars__track {
    width: 100%;
    height: 8.9rem;
    display: flex;
    align-items: end;
    justify-content: center;
    border-radius: .7rem .7rem .3rem .3rem;
    background: #f5eee6;
    overflow: hidden;
}
.baitalgahwa-dashboard-bars__fill {
    width: 1.6rem;
    max-width: 100%;
    min-height: .45rem;
    border-radius: .45rem .45rem 0 0;
    background: linear-gradient(180deg, #d7a169 0%, #8a5a2b 100%);
}
.baitalgahwa-dashboard-bars__label {
    color: #6d6154;
    font-size: .72rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-bars__legend {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    color: #6d6154;
    font-size: .72rem;
}
.baitalgahwa-dashboard-bars__legend-item {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
}
.baitalgahwa-dashboard-bars__legend-dot {
    width: .7rem;
    height: .7rem;
    border-radius: 999px;
    background: #d7a169;
}
.baitalgahwa-dashboard-bars__legend-dot--muted {
    background: #f0e5da;
    border: 1px solid #dfd1c3;
}
.baitalgahwa-dashboard-legend__item.is-active {
    font-weight: 700;
}
.baitalgahwa-dashboard-members-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, auto);
    gap: .85rem;
    margin-top: 1.15rem;
}
.baitalgahwa-dashboard-member-card {
    display: flex;
    align-items: center;
    gap: .8rem;
    min-width: 0;
    border: 1px solid #f0e4da;
    border-radius: 1rem;
    background: #fff7f2;
    padding: .8rem .9rem;
    color: inherit;
    text-decoration: none;
    transition: box-shadow .15s ease, border-color .15s ease;
}
.baitalgahwa-dashboard-member-card:hover {
    border-color: #e5d5c8;
    box-shadow: 0 .35rem 1rem rgba(48, 27, 12, .06);
}
.baitalgahwa-dashboard-member-card__avatar .userpicture,
.baitalgahwa-dashboard-member-card__avatar img {
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 999px;
    display: block;
}
.baitalgahwa-dashboard-member-card__body {
    display: flex;
    flex-direction: column;
    gap: .08rem;
    min-width: 0;
}
.baitalgahwa-dashboard-member-card__name {
    color: #201813;
    font-size: .86rem;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.baitalgahwa-dashboard-member-card__role {
    color: #6d6154;
    font-size: .73rem;
    line-height: 1.35;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.baitalgahwa-dashboard-member-card__date {
    color: #8a7d72;
    font-size: .7rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.baitalgahwa-dashboard-todo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}
.baitalgahwa-dashboard-todo__link {
    color: #8a5a2b;
    font-size: .78rem;
    font-weight: 700;
    text-decoration: none;
}
.baitalgahwa-dashboard-todo__list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: .85rem;
}
.baitalgahwa-dashboard-todo__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid #f0e6dc;
    border-radius: .95rem;
    background: #fffaf5;
    padding: .8rem .95rem;
}
.baitalgahwa-dashboard-todo__meta {
    display: flex;
    align-items: center;
    gap: .8rem;
    min-width: 0;
}
.baitalgahwa-dashboard-todo__check {
    width: 1.3rem;
    height: 1.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d7c7b6;
    border-radius: 999px;
    color: #8a5a2b;
    background: #fff;
    flex: 0 0 auto;
}
.baitalgahwa-dashboard-todo__name {
    display: block;
    color: #201813;
    font-size: .84rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-todo__sub {
    display: block;
    color: #7c7268;
    font-size: .72rem;
}
.baitalgahwa-dashboard-todo__progress {
    min-width: 3rem;
    color: #8a5a2b;
    font-size: .76rem;
    font-weight: 800;
    text-align: right;
}
.baitalgahwa-dashboard-newsletter {
    width: min(100%, 58rem);
    margin: 0 auto;
    text-align: center;
}
.baitalgahwa-dashboard-newsletter__copy {
    max-width: 32rem;
    margin: .4rem auto 1.4rem;
    color: #7c7268;
    font-size: .86rem;
    line-height: 1.7;
}
.baitalgahwa-dashboard-newsletter__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    text-align: left;
}
.baitalgahwa-dashboard-newsletter__field {
    display: flex;
    flex-direction: column;
    gap: .35rem;
}
.baitalgahwa-dashboard-newsletter__field--full {
    grid-column: 1 / -1;
}
.baitalgahwa-dashboard-newsletter label {
    color: #4f453d;
    font-size: .76rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-newsletter input,
.baitalgahwa-dashboard-newsletter select,
.baitalgahwa-dashboard-newsletter textarea {
    width: 100%;
    border: 1px solid #dfd1c3;
    border-radius: .7rem;
    background: #fff;
    padding: .8rem .9rem;
    color: #2a1d14;
    font-size: .84rem;
    box-shadow: none;
}
.baitalgahwa-dashboard-newsletter textarea {
    min-height: 6.5rem;
    resize: vertical;
}
.baitalgahwa-dashboard-newsletter__submit {
    min-width: 12rem;
    margin-top: 1.3rem;
    border: 0;
    border-radius: .7rem;
    background: #8a5a2b;
    color: #fff;
    font-size: .84rem;
    font-weight: 700;
    padding: .8rem 1.4rem;
}
.baitalgahwa-dashboard-newsletter__note {
    margin-top: 1rem;
    color: #7c7268;
    font-size: .76rem;
}
.baitalgahwa-dashboard-hidden-content {
    display: none;
}
@media (min-width: 992px) {
    .baitalgahwa-dashboard-stats .col-lg-3 + .col-lg-3 .baitalgahwa-dashboard-stat {
        border-left: 1px solid #f0e9e2;
    }
}
@media (max-width: 1199.98px) {
    .baitalgahwa-dashboard-members-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 991.98px) {
    .baitalgahwa-dashboard {
        padding-inline: .9rem;
    }
    .baitalgahwa-dashboard-section-head,
    .baitalgahwa-dashboard-todo__head {
        align-items: start;
        flex-direction: column;
    }
    .baitalgahwa-dashboard-panel--programmes .baitalgahwa-dashboard-section-head {
        align-items: center;
    }
    .baitalgahwa-dashboard-widget__top,
    .baitalgahwa-dashboard-widget__footer {
        flex-direction: column;
        align-items: stretch;
    }
}
@media (max-width: 767.98px) {
    .baitalgahwa-dashboard {
        padding-inline: .7rem;
        padding-bottom: 2.4rem;
    }
    .baitalgahwa-dashboard-progress,
    .baitalgahwa-dashboard-members-panel,
    .baitalgahwa-dashboard-todo,
    .baitalgahwa-dashboard-newsletter,
    .baitalgahwa-dashboard-widget,
    .baitalgahwa-dashboard-panel {
        padding: 1rem;
    }
    .baitalgahwa-dashboard-members-grid,
    .baitalgahwa-dashboard-newsletter__grid {
        grid-template-columns: minmax(0, 1fr);
    }
    .baitalgahwa-dashboard-widget__controls,
    .baitalgahwa-dashboard-widget__selectwrap,
    .baitalgahwa-dashboard-widget select,
    .baitalgahwa-dashboard-widget__button {
        width: 100%;
    }
    .baitalgahwa-dashboard-progress__table {
        display: block;
        overflow-x: auto;
    }
    .baitalgahwa-dashboard-stat {
        padding: .95rem 1rem;
    }
}
</style>
