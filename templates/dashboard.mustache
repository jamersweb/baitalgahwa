{{!
    @template theme_baitalgahwa/dashboard
    Logged-in home (mydashboard): stats, training grid, progress, charts, members, newsletter + core “My” content.
}}
{{> theme_boost/head }}
<style>
body.pagelayout-mydashboard .main-inner,
body#page-my-index .main-inner {
    background: #fcfaf7;
}
body.pagelayout-mydashboard #page-header,
body#page-my-index #page-header,
body.pagelayout-mydashboard .secondary-navigation,
body#page-my-index .secondary-navigation {
    display: none;
}
body.pagelayout-mydashboard #page.drawers,
body#page-my-index #page.drawers,
body.pagelayout-mydashboard #topofscroll.main-inner,
body#page-my-index #topofscroll.main-inner {
    max-width: 100%;
    width: 100%;
}
.baitalgahwa-dashboard {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 2rem 1.25rem 3.5rem;
    color: #241b15;
}
.baitalgahwa-dashboard-shell {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: min(100%, 1320px);
    margin: 0 auto;
}
.baitalgahwa-dashboard-heading__eyebrow {
    color: #7c7268;
    font-size: .9rem;
}
.baitalgahwa-dashboard-heading__title {
    color: #201813;
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -.03em;
}
.baitalgahwa-dashboard-hero {
    display: flex;
    flex-direction: column;
    gap: .85rem;
}
.baitalgahwa-dashboard-hero__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
}
.baitalgahwa-dashboard-hero__tag {
    display: inline-flex;
    align-items: center;
    padding: .38rem .85rem;
    border-radius: 999px;
    background: rgba(138, 90, 43, .12);
    color: #8a5a2b;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.baitalgahwa-dashboard-hero__cta,
.baitalgahwa-dashboard .btn-primary {
    background: #8a5a2b;
    border-color: #8a5a2b;
    border-radius: .55rem;
    padding-inline: 1.3rem;
    font-weight: 600;
}
.baitalgahwa-dashboard-hero__media {
    position: relative;
    min-height: 21rem;
    overflow: hidden;
    border-radius: 1.35rem;
    background: #23160f;
    box-shadow: 0 1rem 2.5rem rgba(52, 30, 12, .16);
}
.baitalgahwa-dashboard-hero__image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.02);
}
.baitalgahwa-dashboard-hero__image--placeholder,
.baitalgahwa-activity-card__image--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .24), transparent 20rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-dashboard-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 12, 8, .08) 20%, rgba(20, 12, 8, .72) 100%);
}
.baitalgahwa-dashboard-hero__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    padding: 1.7rem 1.8rem;
    color: #fff;
}
.baitalgahwa-dashboard-hero__title {
    margin-bottom: .6rem;
    color: #fff;
    font-size: clamp(1.65rem, 2.4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -.02em;
}
.baitalgahwa-dashboard-hero__meta {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    color: rgba(255,255,255,.9);
    font-size: .95rem;
}
.baitalgahwa-dashboard-hero__avatar {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,.16);
    border: 1px solid rgba(255,255,255,.24);
}
.baitalgahwa-dashboard-stats {
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.25rem;
    box-shadow: 0 .75rem 2rem rgba(48, 27, 12, .06);
    overflow: hidden;
}
.baitalgahwa-dashboard-stat {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 100%;
    padding: 1.35rem 1.45rem;
}
.baitalgahwa-dashboard-stat__icon {
    color: #8a5a2b;
    font-size: 1.55rem;
    line-height: 1;
}
.baitalgahwa-dashboard-stat__value {
    color: #8a5a2b;
    font-size: 2rem;
    line-height: 1;
    font-weight: 800;
}
.baitalgahwa-dashboard-stat__label {
    margin-top: .3rem;
    color: #7c7268;
    font-size: .9rem;
}
.baitalgahwa-dashboard-subnav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    overflow-x: auto;
    padding: .1rem 0 0;
    border-bottom: 1px solid #e7ddd3;
    scrollbar-width: none;
}
.baitalgahwa-dashboard-subnav::-webkit-scrollbar {
    display: none;
}
.baitalgahwa-dashboard-subnav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0 .9rem;
    color: #5c5146;
    text-decoration: none;
    font-size: .92rem;
    font-weight: 600;
    white-space: nowrap;
}
.baitalgahwa-dashboard-subnav__link.is-active {
    color: #201813;
}
.baitalgahwa-dashboard-subnav__link.is-active::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    border-radius: 999px;
    background: #8a5a2b;
}
.baitalgahwa-dashboard-subnav__add {
    margin-left: auto;
    margin-bottom: .75rem;
    width: 1.7rem;
    height: 1.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border: 1px solid #d8c8b7;
    border-radius: 999px;
    color: #8a5a2b;
    background: #fff;
    text-decoration: none;
    font-size: .8rem;
}
.baitalgahwa-dashboard-subnav__add:hover,
.baitalgahwa-dashboard-subnav__add:focus-visible {
    color: #73471e;
    border-color: #b99365;
}
.baitalgahwa-dashboard-panel {
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.25rem;
    box-shadow: 0 .75rem 2rem rgba(48, 27, 12, .05);
    padding: 1.5rem 1.6rem;
}
.baitalgahwa-dashboard-panel__title,
.baitalgahwa-dashboard-section__title {
    margin-bottom: .85rem;
    color: #201813;
    font-size: 1.25rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-panel__body,
.baitalgahwa-dashboard-section__intro {
    color: #7c7268;
    font-size: .96rem;
    line-height: 1.75;
}
.baitalgahwa-dashboard-panel__announcement {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
}
.baitalgahwa-dashboard-panel__announcement-icon {
    width: 2.7rem;
    height: 2.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgba(138, 90, 43, .1);
    color: #8a5a2b;
}
.baitalgahwa-dashboard-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}
.baitalgahwa-dashboard-section__title {
    margin-bottom: .25rem;
}
.baitalgahwa-activity-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.1rem;
    box-shadow: 0 .85rem 2rem rgba(48, 27, 12, .06);
    transition: transform .18s ease, box-shadow .18s ease;
}
.baitalgahwa-activity-card:hover,
.baitalgahwa-activity-card:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 1rem 2.4rem rgba(48, 27, 12, .12);
}
.baitalgahwa-activity-card__media {
    position: relative;
    overflow: hidden;
}
.baitalgahwa-activity-card__image {
    height: 12rem;
    background-size: cover;
    background-position: center;
}
.baitalgahwa-activity-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18,11,8,.05), rgba(18,11,8,.18));
}
.baitalgahwa-activity-card__badge {
    position: absolute;
    top: .85rem;
    left: .85rem;
    z-index: 1;
    padding: .28rem .7rem;
    border-radius: 999px;
    background: rgba(255,255,255,.94);
    color: #8a5a2b;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.baitalgahwa-activity-card__body {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: .75rem;
    padding: 1rem 1rem 1.1rem;
}
.baitalgahwa-activity-card__title {
    margin: 0;
    color: #201813;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
}
.baitalgahwa-activity-card__copy {
    margin: 0;
    color: #7c7268;
    font-size: .88rem;
    line-height: 1.6;
    min-height: 4.3rem;
}
.baitalgahwa-activity-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-top: auto;
    color: #6a5c4b;
    font-size: .84rem;
    font-weight: 600;
}
.baitalgahwa-activity-card__arrow {
    color: #8a5a2b;
}
.baitalgahwa-minical {
    margin-top: .4rem;
}
.baitalgahwa-minical th {
    color: #61574f;
    font-size: .82rem;
    font-weight: 700;
    border: 0;
    padding: .45rem .2rem;
}
.baitalgahwa-minical td {
    border: 0;
    padding: .3rem .2rem;
}
.baitalgahwa-minical__day {
    min-width: 2rem;
    line-height: 2rem;
    border-radius: 999px;
}
.baitalgahwa-minical__today {
    background: #8a5a2b;
    color: #fff;
    font-weight: 700;
}
.baitalgahwa-member {
    display: flex;
    align-items: center;
    gap: .9rem;
    height: 100%;
    border: 1px solid #efe5db;
    border-radius: 1rem;
    background: #f6f1eb;
    padding: .85rem 1rem;
    transition: background .16s ease, border-color .16s ease;
}
.baitalgahwa-member__avatar .userpicture,
.baitalgahwa-member__avatar img {
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 999px;
}
.baitalgahwa-member__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
}
.baitalgahwa-member__name {
    color: #201813;
    font-weight: 700;
}
.baitalgahwa-member__role {
    color: #7c7268;
    font-size: .88rem;
}
.baitalgahwa-inline-link {
    color: #8a5a2b;
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
}
.baitalgahwa-dashboard-hidden-content {
    display: none;
}
@media (min-width: 992px) {
    .baitalgahwa-dashboard-stats .col-lg-3 + .col-lg-3 .baitalgahwa-dashboard-stat {
        border-left: 1px solid #f0e9e2;
    }
}
@media (max-width: 991.98px) {
    .baitalgahwa-dashboard {
        padding-inline: .9rem;
    }
    .baitalgahwa-dashboard-hero__media {
        min-height: 17rem;
    }
    .baitalgahwa-dashboard-stats .col-6:nth-child(n + 3) .baitalgahwa-dashboard-stat {
        border-top: 1px solid #f0e9e2;
    }
    .baitalgahwa-dashboard-stats .col-6:nth-child(even) .baitalgahwa-dashboard-stat {
        border-left: 1px solid #f0e9e2;
    }
}
@media (max-width: 767.98px) {
    .baitalgahwa-dashboard {
        padding-top: 1.1rem;
        padding-bottom: 2.5rem;
        padding-inline: .7rem;
    }
    .baitalgahwa-dashboard-heading__title {
        font-size: 1.7rem;
    }
    .baitalgahwa-dashboard-hero__media {
        min-height: 14rem;
        border-radius: 1rem;
    }
    .baitalgahwa-dashboard-hero__content {
        padding: 1.1rem;
    }
    .baitalgahwa-dashboard-stats,
    .baitalgahwa-dashboard-panel,
    .baitalgahwa-activity-card {
        border-radius: 1rem;
    }
    .baitalgahwa-dashboard-stat {
        padding: 1rem;
    }
    .baitalgahwa-dashboard-stat__value {
        font-size: 1.5rem;
    }
    .baitalgahwa-dashboard-section__header,
    .baitalgahwa-dashboard-hero__toolbar {
        align-items: flex-start;
        flex-direction: column;
    }
    .baitalgahwa-dashboard-subnav {
        gap: 1rem;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_baitalgahwa/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}
                {{> theme_boost/courseindexdrawercontrols}}
            {{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}
    <div id="page" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-courseindex" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerindex, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                        {{#pix}} t/index_drawer, moodle {{/pix}}
                    </button>
                </div>
                {{/courseindex}}
                {{#hasblocks}}
                <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerblocks, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                        <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                        <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                    </button>
                </div>
                {{/hasblocks}}
            </div>
            {{{ output.full_header }}}
            <main class="baitalgahwa-dashboard" id="bag-dashboard-overview">
                <div class="baitalgahwa-dashboard-shell">
                    <section class="baitalgahwa-dashboard-heading">
                        <p class="baitalgahwa-dashboard-heading__eyebrow mb-2">{{ dashboardwelcome }}</p>
                        <h1 class="baitalgahwa-dashboard-heading__title mb-0">{{#has_featuredcourse}}{{ featuredcourse.fullname }}{{/has_featuredcourse}}{{^has_featuredcourse}}{{#str}}dashboard_pagetitle, theme_baitalgahwa{{/str}}{{/has_featuredcourse}}</h1>
                    </section>

                    <section class="baitalgahwa-dashboard-hero">
                        <div class="baitalgahwa-dashboard-hero__toolbar">
                            <span class="baitalgahwa-dashboard-hero__tag">{{ dashboard_featured_tag }}</span>
                            {{#has_featuredcourse}}
                            <a href="{{{ featuredcourse.url }}}" class="btn btn-primary baitalgahwa-dashboard-hero__cta">{{#str}}gotocourse, theme_baitalgahwa{{/str}}</a>
                            {{/has_featuredcourse}}
                        </div>
                        <div class="baitalgahwa-dashboard-hero__media">
                            {{#has_featuredcourse}}
                                {{#featuredcourse.imageurl}}
                                <div class="baitalgahwa-dashboard-hero__image" style="background-image:url('{{{ featuredcourse.imageurl }}}');"></div>
                                {{/featuredcourse.imageurl}}
                                {{^featuredcourse.imageurl}}
                                <div class="baitalgahwa-dashboard-hero__image baitalgahwa-dashboard-hero__image--placeholder"></div>
                                {{/featuredcourse.imageurl}}
                            {{/has_featuredcourse}}
                            {{^has_featuredcourse}}
                            <div class="baitalgahwa-dashboard-hero__image baitalgahwa-dashboard-hero__image--placeholder"></div>
                            {{/has_featuredcourse}}
                            <div class="baitalgahwa-dashboard-hero__overlay"></div>
                            <div class="baitalgahwa-dashboard-hero__content">
                                <h2 class="baitalgahwa-dashboard-hero__title">{{#has_featuredcourse}}{{ featuredcourse.fullname }}{{/has_featuredcourse}}{{^has_featuredcourse}}{{#str}}dashboard_pagetitle, theme_baitalgahwa{{/str}}{{/has_featuredcourse}}</h2>
                                {{#has_featuredcourse}}
                                <p class="baitalgahwa-dashboard-hero__meta mb-0">
                                    <span class="baitalgahwa-dashboard-hero__avatar"><i class="fa fa-user" aria-hidden="true"></i></span>
                                    {{#featuredcourse.categoryname}}{{ featuredcourse.categoryname }}{{/featuredcourse.categoryname}}{{^featuredcourse.categoryname}}Bait Al Gahwa{{/featuredcourse.categoryname}}
                                </p>
                                {{/has_featuredcourse}}
                            </div>
                        </div>
                    </section>

                    <section class="baitalgahwa-dashboard-stats" aria-label="{{#str}}dashboard_pagetitle, theme_baitalgahwa{{/str}}">
                        <div class="row g-0" role="list">
                            <div class="col-6 col-lg-3" role="listitem">
                                <article class="baitalgahwa-dashboard-stat">
                                    <span class="baitalgahwa-dashboard-stat__icon" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
                                    <div>
                                        <div class="baitalgahwa-dashboard-stat__value">{{ dashboard_stats.enrolled_fmt }}</div>
                                        <div class="baitalgahwa-dashboard-stat__label">{{#str}}dashboard_stat_enrolled, theme_baitalgahwa{{/str}}</div>
                                    </div>
                                </article>
                            </div>
                            <div class="col-6 col-lg-3" role="listitem">
                                <article class="baitalgahwa-dashboard-stat">
                                    <span class="baitalgahwa-dashboard-stat__icon" aria-hidden="true"><i class="fa fa-calendar-o"></i></span>
                                    <div>
                                        <div class="baitalgahwa-dashboard-stat__value">{{ dashboard_stats.completed_fmt }}</div>
                                        <div class="baitalgahwa-dashboard-stat__label">{{#str}}dashboard_stat_completed, theme_baitalgahwa{{/str}}</div>
                                    </div>
                                </article>
                            </div>
                            <div class="col-6 col-lg-3" role="listitem">
                                <article class="baitalgahwa-dashboard-stat">
                                    <span class="baitalgahwa-dashboard-stat__icon" aria-hidden="true"><i class="fa fa-check-square-o"></i></span>
                                    <div>
                                        <div class="baitalgahwa-dashboard-stat__value">{{ dashboard_stats.inprogress_fmt }}</div>
                                        <div class="baitalgahwa-dashboard-stat__label">{{#str}}dashboard_stat_inprogress, theme_baitalgahwa{{/str}}</div>
                                    </div>
                                </article>
                            </div>
                            <div class="col-6 col-lg-3" role="listitem">
                                <article class="baitalgahwa-dashboard-stat">
                                    <span class="baitalgahwa-dashboard-stat__icon" aria-hidden="true"><i class="fa fa-clipboard"></i></span>
                                    <div>
                                        <div class="baitalgahwa-dashboard-stat__value">{{ dashboard_stats.certificates_fmt }}</div>
                                        <div class="baitalgahwa-dashboard-stat__label">{{#str}}dashboard_stat_certs, theme_baitalgahwa{{/str}}</div>
                                    </div>
                                </article>
                            </div>
                        </div>
                    </section>

                    <nav class="baitalgahwa-dashboard-subnav" aria-label="{{#str}}dashboard_pagetitle, theme_baitalgahwa{{/str}}">
                        <a class="baitalgahwa-dashboard-subnav__link is-active" href="#bag-dashboard-overview">Courses</a>
                        <a class="baitalgahwa-dashboard-subnav__link" href="#bag-dashboard-introduction">Settings</a>
                        <a class="baitalgahwa-dashboard-subnav__link" href="#bag-dashboard-members">Participants</a>
                        <a class="baitalgahwa-dashboard-subnav__link" href="#bag-dashboard-calendar">Grades</a>
                        <a class="baitalgahwa-dashboard-subnav__link" href="#bag-dashboard-activities">Activities</a>
                        <a class="baitalgahwa-dashboard-subnav__add" href="#bag-dashboard-activities" aria-label="More"><i class="fa fa-plus" aria-hidden="true"></i></a>
                    </nav>

                    <section class="baitalgahwa-dashboard-panel" id="bag-dashboard-introduction">
                        <h2 class="baitalgahwa-dashboard-panel__title">{{ dashboard_intro_heading }}</h2>
                        <p class="baitalgahwa-dashboard-panel__body mb-0">{{ dashboard_intro_text }}</p>
                    </section>

                    <section class="baitalgahwa-dashboard-panel baitalgahwa-dashboard-panel--announcement">
                        <div class="baitalgahwa-dashboard-panel__announcement">
                            <span class="baitalgahwa-dashboard-panel__announcement-icon" aria-hidden="true"><i class="fa fa-bullhorn"></i></span>
                            <div>
                                <h2 class="baitalgahwa-dashboard-panel__title mb-1">{{ dashboard_announcement_title }}</h2>
                                <p class="baitalgahwa-dashboard-panel__body mb-0">{{ dashboard_announcement_body }}</p>
                            </div>
                        </div>
                    </section>

                    <section class="baitalgahwa-dashboard-section" id="bag-dashboard-activities" aria-labelledby="bag-dashboard-activities-title">
                        <div class="baitalgahwa-dashboard-section__header">
                            <div>
                                <h2 id="bag-dashboard-activities-title" class="baitalgahwa-dashboard-section__title">{{ dashboard_activity_heading }}</h2>
                                <p class="baitalgahwa-dashboard-section__intro mb-0">{{ dashboard_activity_intro }}</p>
                            </div>
                        </div>
                        {{#has_activity_courses}}
                        <div class="row g-4">
                            {{#activity_courses}}
                            <div class="col-md-6 col-xl-3">
                                <article class="baitalgahwa-activity-card h-100">
                                    <div class="baitalgahwa-activity-card__media">
                                        {{#imageurl}}
                                        <div class="baitalgahwa-activity-card__image" style="background-image:url('{{{ imageurl }}}');"></div>
                                        {{/imageurl}}
                                        {{^imageurl}}
                                        <div class="baitalgahwa-activity-card__image baitalgahwa-activity-card__image--placeholder"></div>
                                        {{/imageurl}}
                                        {{#isnew}}<span class="baitalgahwa-activity-card__badge">{{#str}}course_new, theme_baitalgahwa{{/str}}</span>{{/isnew}}
                                    </div>
                                    <div class="baitalgahwa-activity-card__body">
                                        <h3 class="baitalgahwa-activity-card__title"><a class="stretched-link text-reset text-decoration-none" href="{{{ url }}}">{{ fullname }}</a></h3>
                                        {{#summary}}<p class="baitalgahwa-activity-card__copy">{{ summary }}</p>{{/summary}}
                                        <div class="baitalgahwa-activity-card__meta">
                                            <span>{{#categoryname}}{{ categoryname }}{{/categoryname}}{{^categoryname}}Bait Al Gahwa{{/categoryname}}</span>
                                            <span class="baitalgahwa-activity-card__arrow" aria-hidden="true"><i class="fa fa-long-arrow-right"></i></span>
                                        </div>
                                    </div>
                                </article>
                            </div>
                            {{/activity_courses}}
                        </div>
                        {{/has_activity_courses}}
                        {{^has_activity_courses}}
                        <div class="baitalgahwa-dashboard-panel">
                            <p class="baitalgahwa-dashboard-panel__body mb-0">{{#str}}nocourses, theme_baitalgahwa{{/str}}</p>
                        </div>
                        {{/has_activity_courses}}
                    </section>

                    <div class="row g-4">
                        <div class="col-lg-5" id="bag-dashboard-calendar">
                            <section class="baitalgahwa-dashboard-panel baitalgahwa-dashboard-panel--calendar h-100">
                                <div class="baitalgahwa-dashboard-section__header">
                                    <div>
                                        <h2 class="baitalgahwa-dashboard-section__title">{{#str}}calendar, calendar{{/str}}</h2>
                                        <p class="baitalgahwa-dashboard-section__intro mb-0">{{ dashboard_calendar.title }}</p>
                                    </div>
                                    <a class="baitalgahwa-inline-link" href="{{{ config.calurl }}}">{{#str}}dashboard_fullcal, theme_baitalgahwa{{/str}}</a>
                                </div>
                                <table class="table table-sm text-center small baitalgahwa-minical mb-0" role="grid" aria-label="{{#str}}calendar, calendar{{/str}}">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} sunday, calendar {{/str}}">{{#str}} dashboard_cal_s, theme_baitalgahwa {{/str}}</abbr></th>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} monday, calendar {{/str}}">{{#str}} dashboard_cal_m, theme_baitalgahwa {{/str}}</abbr></th>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} tuesday, calendar {{/str}}">{{#str}} dashboard_cal_tu, theme_baitalgahwa {{/str}}</abbr></th>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} wednesday, calendar {{/str}}">{{#str}} dashboard_cal_w, theme_baitalgahwa {{/str}}</abbr></th>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} thursday, calendar {{/str}}">{{#str}} dashboard_cal_th, theme_baitalgahwa {{/str}}</abbr></th>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} friday, calendar {{/str}}">{{#str}} dashboard_cal_f, theme_baitalgahwa {{/str}}</abbr></th>
                                            <th scope="col" class="p-1"><abbr title="{{#str}} saturday, calendar {{/str}}">{{#str}} dashboard_cal_sa, theme_baitalgahwa {{/str}}</abbr></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#dashboard_calendar.weeks}}
                                        <tr>
                                            {{# . }}
                                            <td class="p-1">
                                                {{#inmonth}}<span class="baitalgahwa-minical__day d-inline-block {{#istoday}}baitalgahwa-minical__today{{/istoday}}">{{ day }}</span>{{/inmonth}}
                                            </td>
                                            {{/ . }}
                                        </tr>
                                        {{/dashboard_calendar.weeks}}
                                    </tbody>
                                </table>
                            </section>
                        </div>
                        <div class="col-lg-7" id="bag-dashboard-members">
                            <section class="baitalgahwa-dashboard-panel h-100">
                                <div class="baitalgahwa-dashboard-section__header">
                                    <div>
                                        <h2 class="baitalgahwa-dashboard-section__title">{{#str}}dashboard_members_title, theme_baitalgahwa{{/str}}</h2>
                                        <p class="baitalgahwa-dashboard-section__intro mb-0">{{#str}}dashboard_training_intro, theme_baitalgahwa{{/str}}</p>
                                    </div>
                                    <a class="baitalgahwa-inline-link" href="{{{ config.membersurl }}}">{{ dashboard_members_link }}</a>
                                </div>
                                {{#has_dashboard_members}}
                                <div class="row g-3">
                                    {{#dashboard_members}}
                                    <div class="col-md-6">
                                        <a class="baitalgahwa-member text-reset text-decoration-none" href="{{{ profileurl }}}">
                                            <span class="baitalgahwa-member__avatar">{{{ avatar }}}</span>
                                            <span class="baitalgahwa-member__copy">
                                                <span class="baitalgahwa-member__name">{{ fullname }}</span>
                                                <span class="baitalgahwa-member__role">{{ role }}</span>
                                            </span>
                                        </a>
                                    </div>
                                    {{/dashboard_members}}
                                </div>
                                {{/has_dashboard_members}}
                                {{^has_dashboard_members}}
                                <p class="baitalgahwa-dashboard-panel__body mb-0">{{#str}}dashboard_members_empty, theme_baitalgahwa{{/str}}</p>
                                {{/has_dashboard_members}}
                            </section>
                        </div>
                    </div>

                    {{#hasmaincontent}}
                    <div id="page-content" class="baitalgahwa-dashboard-hidden-content" hidden aria-hidden="true">
                        {{{ maincontent }}}
                    </div>
                    {{/hasmaincontent}}
                </div>
            </main>
        </div>
        {{> theme_baitalgahwa/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer', 'theme_baitalgahwa/theme'], function(Loader, Drawer, Bait) {
    Drawer.init();
    Bait.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
