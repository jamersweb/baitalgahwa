                                        <span class="baitalgahwa-dashboard-bars__legend-dot"></span>
                                        <span>{{ dashboard_ui.quizattempted }}</span>
                                    </span>
                                    <span class="baitalgahwa-dashboard-bars__legend-item">
                                        <span class="baitalgahwa-dashboard-bars__legend-dot baitalgahwa-dashboard-bars__legend-dot--muted"></span>
                                        <span>{{ dashboard_ui.quiznotattempted }}</span>
                                    </span>
                                </div>
                            </section>
                        </div>
                    </div>
                    <script type="application/json" id="bag-dashboard-calendar-data">{{{ dashboard_calendar_events_json }}}</script>
                    <script type="application/json" id="bag-dashboard-quiz-data">{{{ dashboard_quiz_chart_json }}}</script>

                    <section class="baitalgahwa-dashboard-members-panel">
                        <h2 class="baitalgahwa-dashboard-section-title">{{#str}}dashboard_members_title, theme_baitalgahwa{{/str}}</h2>
                        {{#has_dashboard_members}}
                        <div class="baitalgahwa-dashboard-members-grid">
                            {{#dashboard_members}}
                            <a class="baitalgahwa-dashboard-member-card" href="{{{ profileurl }}}">
                                <span class="baitalgahwa-dashboard-member-card__avatar">{{{ avatar }}}</span>
                                <span class="baitalgahwa-dashboard-member-card__body">
                                    <span class="baitalgahwa-dashboard-member-card__name">{{ fullname }}</span>
                                    <span class="baitalgahwa-dashboard-member-card__role">{{ role }}</span>
                                    {{#joined_display}}<span class="baitalgahwa-dashboard-member-card__date">{{ joined_display }}</span>{{/joined_display}}
                                </span>
                            </a>
                            {{/dashboard_members}}
                        </div>
                        {{/has_dashboard_members}}
                        {{^has_dashboard_members}}
                        <p class="baitalgahwa-dashboard-section-copy mb-0 mt-3">{{#str}}dashboard_members_empty, theme_baitalgahwa{{/str}}</p>
                        {{/has_dashboard_members}}
                        <div class="baitalgahwa-dashboard-members-panel__footer">
                            <a class="baitalgahwa-dashboard-members-panel__viewall" href="{{{ config.membersurl }}}">{{#str}}dashboard_members_link, theme_baitalgahwa{{/str}}</a>
                        </div>
                    </section>

                    <section class="baitalgahwa-dashboard-todo">
                        <div class="baitalgahwa-dashboard-todo__head">
                            <div>
                                <h2 class="baitalgahwa-dashboard-section-title">{{#str}}dashboard_todo_title, theme_baitalgahwa{{/str}}</h2>
                                <p class="baitalgahwa-dashboard-section-copy">{{#str}}dashboard_todo_body, theme_baitalgahwa{{/str}}</p>
                            </div>
                            <a class="baitalgahwa-dashboard-todo__link" href="{{{ config.coursetodo }}}">{{#str}}dashboard_todo_link, theme_baitalgahwa{{/str}}</a>
                        </div>
                        {{#has_dashboard_todo}}
                        <div class="baitalgahwa-dashboard-todo__list">
                            {{#dashboard_todo_items}}
                            <div class="baitalgahwa-dashboard-todo__item">
                                <div class="baitalgahwa-dashboard-todo__meta">
                                    <span class="baitalgahwa-dashboard-todo__check"><i class="fa fa-check" aria-hidden="true"></i></span>
                                    <span>
                                        <span class="baitalgahwa-dashboard-todo__name">{{ fullname }}</span>
                                        <span class="baitalgahwa-dashboard-todo__sub">{{ status }}</span>
                                    </span>
                                </div>
                                <span class="baitalgahwa-dashboard-todo__progress">{{ progressint }}%</span>
                            </div>
                            {{/dashboard_todo_items}}
                        </div>
                        {{/has_dashboard_todo}}
                        {{^has_dashboard_todo}}
                        <p class="baitalgahwa-dashboard-section-copy mb-0">{{#str}}dashboard_todo_body, theme_baitalgahwa{{/str}}</p>
                        {{/has_dashboard_todo}}
                    </section>

                    <section class="baitalgahwa-dashboard-newsletter">
                        <h2 class="baitalgahwa-dashboard-section-title">{{#str}}dashboard_news_title, theme_baitalgahwa{{/str}}</h2>
                        <p class="baitalgahwa-dashboard-newsletter__copy">{{#str}}dashboard_news_intro, theme_baitalgahwa{{/str}}</p>
                        <form class="baitalgahwa-dashboard-newsletter__form" data-bag-newsletter-form data-mailto="{{ footeremail }}">
                            <div class="baitalgahwa-dashboard-newsletter__grid">
                                <div class="baitalgahwa-dashboard-newsletter__field">
                                    <label for="bag-news-name">{{#str}}dashboard_news_name, theme_baitalgahwa{{/str}}</label>
                                    <input id="bag-news-name" name="name" type="text" placeholder="{{#str}}dashboard_news_name_placeholder, theme_baitalgahwa{{/str}}">
                                </div>
                                <div class="baitalgahwa-dashboard-newsletter__field">
                                    <label for="bag-news-email">{{#str}}dashboard_news_email, theme_baitalgahwa{{/str}}</label>
                                    <input id="bag-news-email" name="email" type="email" placeholder="{{#str}}dashboard_news_email_placeholder, theme_baitalgahwa{{/str}}">
                                </div>
                                <div class="baitalgahwa-dashboard-newsletter__field">
                                    <label for="bag-news-topic">{{#str}}dashboard_news_topic, theme_baitalgahwa{{/str}}</label>
                                    <select id="bag-news-topic" name="topic">
                                        {{#dashboard_news_options}}
                                        <option value="{{ value }}" {{#selected}}selected{{/selected}}>{{ label }}</option>
                                        {{/dashboard_news_options}}
                                    </select>
                                </div>
                                <div class="baitalgahwa-dashboard-newsletter__field">
                                    <label for="bag-news-course">{{#str}}dashboard_news_course, theme_baitalgahwa{{/str}}</label>
                                    <input id="bag-news-course" name="course" type="text" placeholder="{{#str}}dashboard_news_course_placeholder, theme_baitalgahwa{{/str}}">
                                </div>
                                <div class="baitalgahwa-dashboard-newsletter__field baitalgahwa-dashboard-newsletter__field--full">
                                    <label for="bag-news-message">{{#str}}dashboard_news_message, theme_baitalgahwa{{/str}}</label>
                                    <textarea id="bag-news-message" name="message" placeholder="{{#str}}dashboard_news_message_placeholder, theme_baitalgahwa{{/str}}"></textarea>
                                </div>
                            </div>
                            <button class="baitalgahwa-dashboard-newsletter__submit" type="submit" {{^footeremail}}disabled{{/footeremail}}>{{#str}}dashboard_news_cta, theme_baitalgahwa{{/str}}</button>
                            {{^footeremail}}<p class="baitalgahwa-dashboard-newsletter__note">{{#str}}dashboard_news_admin, theme_baitalgahwa{{/str}}</p>{{/footeremail}}
                        </form>
                    </section>

                    {{#hasmaincontent}}
                    <div id="page-content" class="baitalgahwa-dashboard-hidden-content" hidden aria-hidden="true">
                        {{{ maincontent }}}
                    </div>
                    {{/hasmaincontent}}

                </div>
            </main>
        </div>
        {{> theme_baitalgahwa/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer', 'theme_baitalgahwa/theme'], function(Loader, Drawer, Bait) {
    Drawer.init();
    Bait.init();
    var readJson = function(id, fallback) {
        var node = document.getElementById(id);
        if (!node) {
            return fallback;
        }
        try {
            return JSON.parse(node.textContent || node.innerText || '');
        } catch (e) {
            return fallback;
        }
    };
    var initDashboardDonut = function() {
        var select = document.querySelector('[data-bag-donut-select]');
        var count = document.querySelector('[data-bag-donut-count]');
        var label = document.querySelector('[data-bag-donut-label]');
        if (!select || !count || !label) {
            return;
        }
        var update = function() {
            var option = select.options[select.selectedIndex];
            if (!option) {
                return;
            }
            count.textContent = option.getAttribute('data-count') || '0';
            label.textContent = option.textContent;
            document.querySelectorAll('[data-bag-donut-item]').forEach(function(item) {
                item.classList.toggle('is-active', item.getAttribute('data-bag-donut-item') === option.textContent && option.value !== 'all');
            });
        };
        select.addEventListener('change', update);
        update();
    };
    var initDashboardCalendar = function() {
        var course = document.querySelector('[data-bag-calendar-course]');
        var type = document.querySelector('[data-bag-calendar-type]');
        var events = readJson('bag-dashboard-calendar-data', []);
        if (!course || !type) {
            return;
        }
        var render = function() {
            document.querySelectorAll('[data-bag-calendar-day]').forEach(function(day) {
                day.classList.remove('baitalgahwa-dashboard-calendar__day--has-event');
                var daynum = parseInt(day.getAttribute('data-bag-calendar-day'), 10);
                var match = events.some(function(entry) {
                    var courseMatch = course.value === 'all' || entry.courseid === course.value;
                    var typeMatch = type.value === 'all' || entry.type === type.value;
                    return courseMatch && typeMatch && parseInt(entry.day, 10) === daynum;
                });
                if (match) {
                    day.classList.add('baitalgahwa-dashboard-calendar__day--has-event');
                }
            });
        };
        course.addEventListener('change', render);
        type.addEventListener('change', render);
        render();
    };
    var initDashboardQuiz = function() {
        var course = document.querySelector('[data-bag-quiz-course]');
        var quiz = document.querySelector('[data-bag-quiz-type]');
        var data = readJson('bag-dashboard-quiz-data', {labels: [], rows: []});
        var fills = document.querySelectorAll('[data-bag-quiz-fill]');
        var labels = document.querySelectorAll('[data-bag-quiz-label]');
        if (!course || !quiz || !fills.length) {
            return;
        }
        var render = function() {
            var counts = data.labels.map(function() { return 0; });
            (data.rows || []).forEach(function(row) {
                var courseMatch = course.value === 'all' || row.courseid === course.value;
                var quizMatch = quiz.value === 'all' || row.quizid === quiz.value;
                if (!courseMatch || !quizMatch) {
                    return;
                }
                row.counts.forEach(function(value, index) {
                    counts[index] += parseInt(value, 10) || 0;
                });
            });
            var max = Math.max.apply(null, counts.concat([1]));
            fills.forEach(function(fill, index) {
                var pct = Math.round(((counts[index] || 0) / max) * 100);
                fill.style.height = pct + '%';
                fill.title = (counts[index] || 0).toString();
            });
            labels.forEach(function(node, index) {
                node.textContent = data.labels[index] || node.textContent;
            });
        };
        course.addEventListener('change', render);
        quiz.addEventListener('change', render);
        render();
    };
    initDashboardDonut();
    initDashboardCalendar();
    initDashboardQuiz();
    document.querySelectorAll('[data-bag-newsletter-form]').forEach(function(form) {
        form.addEventListener('submit', function(event) {
            event.preventDefault();
            var address = form.getAttribute('data-mailto');
            if (!address) {
                return;
            }
            var name = form.querySelector('[name=\"name\"]').value.trim();
            var email = form.querySelector('[name=\"email\"]').value.trim();
            var topic = form.querySelector('[name=\"topic\"]').value;
            var course = form.querySelector('[name=\"course\"]').value.trim();
            var message = form.querySelector('[name=\"message\"]').value.trim();
            var subject = topic ? 'LMS Newsletter: ' + topic : 'LMS Newsletter';
            var lines = [
                'Name: ' + (name || '-'),
                'Email: ' + (email || '-'),
                'Course: ' + (course || '-'),
                '',
                message || '-'
            ];
            window.location.href = 'mailto:' + address + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\\n'));
        });
    });
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
