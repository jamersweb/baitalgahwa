{{!
    @template theme_baitalgahwa/dashboard
    Logged-in dashboard landing shown on /my/.
}}
{{> theme_boost/head }}
<style>
body.pagelayout-mydashboard .main-inner,
body#page-my-index .main-inner {
    background: #fcfaf7;
}
body.pagelayout-mydashboard #page-header,
body#page-my-index #page-header,
body.pagelayout-mydashboard .secondary-navigation,
body#page-my-index .secondary-navigation {
    display: none;
}
body.pagelayout-mydashboard #page.drawers,
body#page-my-index #page.drawers,
body.pagelayout-mydashboard #topofscroll.main-inner,
body#page-my-index #topofscroll.main-inner {
    max-width: 100%;
    width: 100%;
}
.baitalgahwa-dashboard {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 1.5rem 1.25rem 3.5rem;
    color: #241b15;
}
.baitalgahwa-dashboard-shell {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    width: min(100%, 1320px);
    margin: 0 auto;
}
.baitalgahwa-dashboard-title {
    margin: 0;
    color: #201813;
    font-size: 1.05rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-panel,
.baitalgahwa-dashboard-stats,
.baitalgahwa-dashboard-programme,
.baitalgahwa-dashboard-widget,
.baitalgahwa-dashboard-members,
.baitalgahwa-dashboard-todo,
.baitalgahwa-dashboard-newsletter {
    background: #fff;
    border: 1px solid #ebe3da;
    border-radius: 1.2rem;
    box-shadow: 0 .85rem 2rem rgba(48, 27, 12, .05);
}
.baitalgahwa-dashboard-panel {
    padding: 1.75rem;
}
.baitalgahwa-dashboard-stats {
    overflow: hidden;
}
.baitalgahwa-dashboard-stat {
    display: flex;
    align-items: center;
    gap: .95rem;
    padding: 1rem 1.15rem;
    min-height: 100%;
}
.baitalgahwa-dashboard-stat__icon {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: .6rem;
    color: #8a5a2b;
    background: rgba(138, 90, 43, .09);
}
.baitalgahwa-dashboard-stat__value {
    color: #8a5a2b;
    font-size: 1.65rem;
    line-height: 1;
    font-weight: 800;
}
.baitalgahwa-dashboard-stat__label {
    margin-top: .25rem;
    color: #7c7268;
    font-size: .82rem;
}
.baitalgahwa-dashboard-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .2rem;
}
.baitalgahwa-dashboard-section-title {
    margin: 0;
    color: #201813;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -.02em;
}
.baitalgahwa-dashboard-section-copy {
    margin: .35rem 0 0;
    color: #7c7268;
    font-size: .88rem;
    line-height: 1.65;
}
.baitalgahwa-dashboard-programmes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
}
.baitalgahwa-dashboard-programme {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
}
.baitalgahwa-dashboard-panel--programmes {
    margin-top: .25rem;
}
.baitalgahwa-dashboard-panel--programmes .baitalgahwa-dashboard-section-head {
    justify-content: center;
    text-align: center;
    margin-bottom: 1.5rem;
}
.baitalgahwa-dashboard-panel--programmes .baitalgahwa-dashboard-section-copy {
    max-width: 46rem;
    margin: .65rem auto 0;
    font-size: .92rem;
}
.baitalgahwa-dashboard-programme:hover,
.baitalgahwa-dashboard-programme:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 1rem 2rem rgba(48, 27, 12, .1);
}
.baitalgahwa-dashboard-programme__media {
    position: relative;
    padding: .75rem .75rem 0;
}
.baitalgahwa-dashboard-programme__image {
    height: 10.5rem;
    border-radius: 1rem;
    background-size: cover;
    background-position: center;
}
.baitalgahwa-dashboard-programme__image--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .24), transparent 20rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-dashboard-programme__badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    z-index: 1;
    padding: .26rem .65rem;
    border-radius: 999px;
    background: rgba(255,255,255,.95);
    color: #8a5a2b;
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
}
.baitalgahwa-dashboard-programme__body {
    display: flex;
    flex-direction: column;
    gap: .7rem;
    flex: 1 1 auto;
    padding: 1rem 1rem 1.1rem;
}
.baitalgahwa-dashboard-programme__dates {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
}
.baitalgahwa-dashboard-programme__date-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    border-radius: 999px;
    padding: .3rem .6rem;
    background: #f6f1eb;
    color: #6a5c4b;
    font-size: .68rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-programme__title {
    margin: 0;
    color: #201813;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
}
.baitalgahwa-dashboard-programme__copy {
    margin: 0;
    color: #7c7268;
    font-size: .84rem;
    line-height: 1.6;
    min-height: 4rem;
}
.baitalgahwa-dashboard-programme__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-top: auto;
    color: #8a5a2b;
    font-size: .78rem;
    font-weight: 600;
}
.baitalgahwa-dashboard-programme__meta-label {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-width: 0;
}
.baitalgahwa-dashboard-programme__meta-label span:last-child {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.baitalgahwa-dashboard-programme__meta-arrow {
    color: #8a5a2b;
}
.baitalgahwa-dashboard-progress,
.baitalgahwa-dashboard-members,
.baitalgahwa-dashboard-todo,
.baitalgahwa-dashboard-newsletter {
    padding: 1.35rem 1.45rem;
}
.baitalgahwa-dashboard-progress__table {
    margin: 0;
    width: 100%;
}
.baitalgahwa-dashboard-progress__table th {
    padding: .7rem .75rem;
    color: #6e6154;
    font-size: .8rem;
    font-weight: 700;
    border-bottom: 1px solid #ede4da;
    white-space: nowrap;
}
.baitalgahwa-dashboard-progress__table td {
    padding: .85rem .75rem;
    font-size: .84rem;
    border-bottom: 1px solid #f3ece5;
    vertical-align: middle;
}
.baitalgahwa-dashboard-progress__course {
    display: flex;
    align-items: center;
    gap: .75rem;
    min-width: 15rem;
}
.baitalgahwa-dashboard-progress__thumb {
    width: 2.85rem;
    height: 2.2rem;
    flex: 0 0 auto;
    border-radius: .55rem;
    background-size: cover;
    background-position: center;
    background-color: #f4ece4;
}
.baitalgahwa-dashboard-progress__thumb--placeholder {
    background:
        radial-gradient(circle at 70% 30%, rgba(201, 162, 39, .2), transparent 8rem),
        linear-gradient(125deg, #2a180f 0%, #5c3720 45%, #18100c 100%);
}
.baitalgahwa-dashboard-status {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: .28rem .7rem;
    font-size: .72rem;
    font-weight: 700;
    background: #f5efe8;
    color: #7b6043;
}
.baitalgahwa-dashboard-progress__bar {
    position: relative;
    width: 100%;
    height: .5rem;
    border-radius: 999px;
    background: #efe5db;
    overflow: hidden;
}
.baitalgahwa-dashboard-progress__bar span {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #8a5a2b, #b98651);
}
.baitalgahwa-dashboard-widget {
    padding: 1.25rem 1.3rem;
    height: 100%;
}
.baitalgahwa-dashboard-widget__title {
    margin: 0;
    color: #201813;
    font-size: 1rem;
    font-weight: 800;
}
.baitalgahwa-dashboard-widget__sub {
    margin: .3rem 0 0;
    color: #7c7268;
    font-size: .78rem;
}
.baitalgahwa-dashboard-donut {
    width: 9.5rem;
    height: 9.5rem;
    margin: 1rem auto .9rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bag-donut, conic-gradient(#e8e0d8 0% 100%));
    position: relative;
}
.baitalgahwa-dashboard-donut::before {
    content: "";
    position: absolute;
    inset: 1rem;
    background: #fff;
    border-radius: 50%;
}
.baitalgahwa-dashboard-donut__center {
    position: relative;
    z-index: 1;
    text-align: center;
}
.baitalgahwa-dashboard-donut__count {
    color: #8a5a2b;
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
}
.baitalgahwa-dashboard-donut__label {
    margin-top: .3rem;
    color: #7c7268;
    font-size: .7rem;
}
.baitalgahwa-dashboard-legend {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem 1rem;
    justify-content: center;
    font-size: .74rem;
    color: #5f5448;
}
.baitalgahwa-dashboard-legend__item {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
}
.baitalgahwa-dashboard-legend__dot {
    width: .55rem;
    height: .55rem;
    border-radius: 999px;
    display: inline-block;
}
.baitalgahwa-dashboard-calendar {
    margin-top: .8rem;
}
.baitalgahwa-dashboard-calendar th {
    padding: .45rem .2rem;
    border: 0;
    color: #61574f;
    font-size: .72rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-calendar td {
    padding: .26rem .2rem;
    border: 0;
}
.baitalgahwa-dashboard-calendar__day {
    min-width: 1.95rem;
    line-height: 1.95rem;
    display: inline-block;
    border-radius: 999px;
    color: #4f453d;
}
.baitalgahwa-dashboard-calendar__today {
    background: #8a5a2b;
    color: #fff;
    font-weight: 700;
}
.baitalgahwa-dashboard-bars {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: .6rem;
    height: 11rem;
    padding-top: 1rem;
}
.baitalgahwa-dashboard-bars__item {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .45rem;
}
.baitalgahwa-dashboard-bars__track {
    width: 100%;
    height: 8.8rem;
    display: flex;
    align-items: end;
    justify-content: center;
    border-radius: .7rem .7rem .3rem .3rem;
    background: #f5eee6;
    overflow: hidden;
}
.baitalgahwa-dashboard-bars__fill {
    width: 1.6rem;
    max-width: 100%;
    border-radius: .45rem .45rem 0 0;
    background: linear-gradient(180deg, #d7a169 0%, #8a5a2b 100%);
}
.baitalgahwa-dashboard-bars__label {
    color: #6d6154;
    font-size: .72rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-members-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .85rem;
    margin-top: 1rem;
}
.baitalgahwa-dashboard-member {
    display: flex;
    align-items: center;
    gap: .75rem;
    border: 1px solid #efe5db;
    border-radius: .9rem;
    background: #faf6f1;
    padding: .75rem .85rem;
}
.baitalgahwa-dashboard-member__avatar .userpicture,
.baitalgahwa-dashboard-member__avatar img {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
}
.baitalgahwa-dashboard-member__name {
    display: block;
    color: #201813;
    font-size: .82rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-member__role {
    display: block;
    color: #7c7268;
    font-size: .72rem;
}
.baitalgahwa-dashboard-todo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}
.baitalgahwa-dashboard-todo__link {
    color: #8a5a2b;
    font-size: .78rem;
    font-weight: 700;
    text-decoration: none;
}
.baitalgahwa-dashboard-todo__list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: .85rem;
}
.baitalgahwa-dashboard-todo__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid #f0e6dc;
    border-radius: .95rem;
    background: #fffaf5;
    padding: .8rem .95rem;
}
.baitalgahwa-dashboard-todo__meta {
    display: flex;
    align-items: center;
    gap: .8rem;
    min-width: 0;
}
.baitalgahwa-dashboard-todo__check {
    width: 1.3rem;
    height: 1.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d7c7b6;
    border-radius: 999px;
    color: #8a5a2b;
    background: #fff;
    flex: 0 0 auto;
}
.baitalgahwa-dashboard-todo__name {
    display: block;
    color: #201813;
    font-size: .84rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-todo__sub {
    display: block;
    color: #7c7268;
    font-size: .72rem;
}
.baitalgahwa-dashboard-todo__progress {
    min-width: 3rem;
    color: #8a5a2b;
    font-size: .76rem;
    font-weight: 800;
    text-align: right;
}
.baitalgahwa-dashboard-newsletter {
    width: min(100%, 58rem);
    margin: 0 auto;
    text-align: center;
}
.baitalgahwa-dashboard-newsletter__copy {
    max-width: 32rem;
    margin: .4rem auto 1.4rem;
    color: #7c7268;
    font-size: .86rem;
    line-height: 1.7;
}
.baitalgahwa-dashboard-newsletter__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    text-align: left;
}
.baitalgahwa-dashboard-newsletter__field {
    display: flex;
    flex-direction: column;
    gap: .35rem;
}
.baitalgahwa-dashboard-newsletter__field--full {
    grid-column: 1 / -1;
}
.baitalgahwa-dashboard-newsletter label {
    color: #4f453d;
    font-size: .76rem;
    font-weight: 700;
}
.baitalgahwa-dashboard-newsletter input,
.baitalgahwa-dashboard-newsletter select,
.baitalgahwa-dashboard-newsletter textarea {
    width: 100%;
    border: 1px solid #dfd1c3;
    border-radius: .7rem;
    background: #fff;
    padding: .8rem .9rem;
    color: #2a1d14;
    font-size: .84rem;
    box-shadow: none;
}
.baitalgahwa-dashboard-newsletter textarea {
    min-height: 6.5rem;
    resize: vertical;
}
.baitalgahwa-dashboard-newsletter__submit {
    min-width: 12rem;
    margin-top: 1.3rem;
    border: 0;
    border-radius: .7rem;
    background: #8a5a2b;
    color: #fff;
    font-size: .84rem;
    font-weight: 700;
    padding: .8rem 1.4rem;
}
.baitalgahwa-dashboard-newsletter__note {
    margin-top: 1rem;
    color: #7c7268;
    font-size: .76rem;
}
.baitalgahwa-dashboard-hidden-content {
    display: none;
}
@media (min-width: 992px) {
    .baitalgahwa-dashboard-stats .col-lg-3 + .col-lg-3 .baitalgahwa-dashboard-stat {
        border-left: 1px solid #f0e9e2;
    }
}
@media (max-width: 1199.98px) {
    .baitalgahwa-dashboard-members-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 991.98px) {
    .baitalgahwa-dashboard {
        padding-inline: .9rem;
    }
    .baitalgahwa-dashboard-section-head,
    .baitalgahwa-dashboard-todo__head {
        align-items: start;
        flex-direction: column;
    }
    .baitalgahwa-dashboard-panel--programmes .baitalgahwa-dashboard-section-head {
        align-items: center;
    }
}
@media (max-width: 767.98px) {
    .baitalgahwa-dashboard {
        padding-inline: .7rem;
        padding-bottom: 2.4rem;
    }
    .baitalgahwa-dashboard-progress,
    .baitalgahwa-dashboard-members,
    .baitalgahwa-dashboard-todo,
    .baitalgahwa-dashboard-newsletter,
    .baitalgahwa-dashboard-widget,
    .baitalgahwa-dashboard-panel {
        padding: 1rem;
    }
    .baitalgahwa-dashboard-members-grid,
    .baitalgahwa-dashboard-newsletter__grid {
        grid-template-columns: minmax(0, 1fr);
    }
    .baitalgahwa-dashboard-progress__table {
        display: block;
        overflow-x: auto;
    }
    .baitalgahwa-dashboard-stat {
        padding: .95rem 1rem;
    }
}
</style>
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_baitalgahwa/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}{{> theme_boost/courseindexdrawercontrols}}{{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}{{{courseindex}}}{{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}
    <div id="page" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-courseindex" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerindex, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                        {{#pix}} t/index_drawer, moodle {{/pix}}
                    </button>
                </div>
                {{/courseindex}}
                {{#hasblocks}}
                <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                    <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerblocks, core{{/str}}">
                        <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                        <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                        <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                    </button>
                </div>
                {{/hasblocks}}
            </div>
            {{{ output.full_header }}}
            <main class="baitalgahwa-dashboard" id="bag-dashboard-overview">
                <div class="baitalgahwa-dashboard-shell">
                    <h1 class="baitalgahwa-dashboard-title">{{#str}}dashboard_pagetitle, theme_baitalgahwa{{/str}}</h1>

                    <section class="baitalgahwa-dashboard-stats" aria-label="{{#str}}dashboard_pagetitle, theme_baitalgahwa{{/str}}">
                        <div class="row g-0" role="list">
                            <div class="col-6 col-lg-3" role="listitem">
                                <article class="baitalgahwa-dashboard-stat">
                                    <span class="baitalgahwa-dashboard-stat__icon" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
                                    <div>
                                        <div class="baitalgahwa-dashboard-stat__value">{{ dashboard_stats.enrolled_fmt }}</div>
                                        <div class="baitalgahwa-dashboard-stat__label">{{#str}}dashboard_stat_enrolled, theme_baitalgahwa{{/str}}</div>
                                    </div>
                                </article>
                            </div>
                            <div class="col-6 col-lg-3" role="listitem">
                                <article class="baitalgahwa-dashboard-stat">
                                    <span class="baitalgahwa-dashboard-stat__icon" aria-hidden="true"><i class="fa fa-calendar-check-o"></i></span>
