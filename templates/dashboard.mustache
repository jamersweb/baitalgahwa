                                    <div class="baitalgahwa-dashboard-bars__item">
                                        <div class="baitalgahwa-dashboard-bars__track">
                                            <div class="baitalgahwa-dashboard-bars__fill" style="height: {{ pct }}%;" data-bag-quiz-fill></div>
                                        </div>
                                        <span class="baitalgahwa-dashboard-bars__label" data-bag-quiz-label>{{ t }}</span>
                                    </div>
                                    {{/dashboard_quiz_bars}}
                                </div>
                                <div class="baitalgahwa-dashboard-bars__legend">
